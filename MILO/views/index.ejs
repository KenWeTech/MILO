    <script>
        let currentPage = 1, totalPages = 1, totalTracks = 0;
        let searchDebounce = null;
        let activeJobData = null;
        let currentExemptFolders = [];
        let currentDumpFolders = [];
        let systemUsersList = [];

        function showAlert(title, message, isSuccess) {
            let modalTitle = "Error";
            let modalMsg = "";
            let isOk = false;

            if (typeof title === 'object' && title !== null) {
                if (title instanceof Error) {
                    isOk = false;
                    modalMsg = title.message;
                    modalTitle = "Error";
                } else {

                    isOk = title.success === true;
                    modalMsg = title.message || title.msg || title.error || JSON.stringify(title);
                    modalTitle = title.title || (isOk ? "Success" : "Error");
                }
            } 

            else if (typeof message === 'boolean') {
                isOk = message;
                modalMsg = title || "";
                modalTitle = isOk ? "Success" : "Error";
            }

            else if (typeof isSuccess === 'boolean' || typeof isSuccess === 'string') {
                isOk = (isSuccess === true || isSuccess === 'true');
                modalTitle = title || (isOk ? "Success" : "Error");
                modalMsg = message || "";
            }

            else if (message === undefined && isSuccess === undefined) {
                modalMsg = title || "";
                const hasErrorWord = /error|fail|invalid|unauthorized|exception|cannot|could not|not found|missing|denied|unable/i.test(modalMsg);
                const hasSuccessWord = /success|updated|saved|completed|done|created|purged|restored/i.test(modalMsg);
                isOk = hasSuccessWord && !hasErrorWord;
                modalTitle = isOk ? "Success" : "Error";
            }

            else {
                modalTitle = title || "Notification";
                modalMsg = message || "";
                const combined = `${modalTitle} ${modalMsg}`;
                const hasErrorWord = /error|fail|invalid|unauthorized|exception|cannot|could not|not found|missing|denied|unable/i.test(combined);
                const hasSuccessWord = /success|updated|saved|completed|done|created|purged|restored/i.test(combined);
                isOk = hasSuccessWord && !hasErrorWord;
            }

            const modal = document.getElementById('system-alert-modal');
            const titleEl = document.getElementById('alert-modal-title');
            const msgEl = document.getElementById('alert-modal-msg');
            const errorIcon = document.getElementById('alert-icon-error');
            const successIcon = document.getElementById('alert-icon-success');
            const errorBtns = document.getElementById('alert-actions-error');
            const successBtns = document.getElementById('alert-actions-success');
            const iconContainer = document.getElementById('alert-icon-container');

            if (titleEl) titleEl.innerText = modalTitle;
            if (msgEl) msgEl.innerText = modalMsg;

            if (isOk) {
                if (successIcon) successIcon.classList.remove('hidden');
                if (errorIcon) errorIcon.classList.add('hidden');
                if (successBtns) {
                    successBtns.classList.remove('hidden');
                    successBtns.classList.add('flex');
                }
                if (errorBtns) {
                    errorBtns.classList.add('hidden');
                    errorBtns.classList.remove('flex');
                }
                if (iconContainer) {
                    iconContainer.classList.remove('bg-[#330816]');
                    iconContainer.classList.add('bg-[#001a2c]');
                }
            } else {
                if (errorIcon) errorIcon.classList.remove('hidden');
                if (successIcon) successIcon.classList.add('hidden');
                if (errorBtns) {
                    errorBtns.classList.remove('hidden');
                    errorBtns.classList.add('flex');
                }
                if (successBtns) {
                    successBtns.classList.add('hidden');
                    successBtns.classList.remove('flex');
                }
                if (iconContainer) {
                    iconContainer.classList.remove('bg-[#001a2c]');
                    iconContainer.classList.add('bg-[#330816]');
                }
            }

            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        }

        function closeAppAlert() {
            const modal = document.getElementById('system-alert-modal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        function forceRefreshCheck() {
            window.location.reload();
        }

        function checkLiveConnection() {
            fetch('/api/catalog?limit=1')
                .then(r => {
                    if(r.ok) document.getElementById('live-offline-overlay').classList.add('hidden');
                })
                .catch(() => {});
        }

        function loadCatalog() {
            const q = document.getElementById('search-input').value;
            const sort = document.getElementById('sort-by').value;
            const order = document.getElementById('sort-order').value;
            const filter = document.getElementById('library-filter').value;
            const limit = document.getElementById('page-limit').value;

            fetch(`/api/catalog?q=${encodeURIComponent(q)}&sort=${sort}&order=${order}&library_filter=${filter}&page=${currentPage}&limit=${limit}`)
                .then(r => r.json())
                .then(data => {
                    renderCatalogTable(data.tracks);
                    updatePaginationUI(data.stats);
                })
                .catch(err => console.error(err));
        }

        function renderCatalogTable(tracks) {
            const tbody = document.getElementById('catalog-table');
            tbody.innerHTML = '';

            if (tracks.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-xs text-[#7a7d90]">No matching tracks found.</td></tr>`;
                return;
            }

            tracks.forEach(track => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-[#1d202f]/30 transition-colors";
                tr.innerHTML = `
                    <td class="p-4 font-medium text-[#ffffff]">${escapeHtml(track.title)}</td>
                    <td class="p-4 hidden sm:table-cell text-[#b4b7c5]">${escapeHtml(track.artist)}</td>
                    <td class="p-4 hidden sm:table-cell text-[#7a7d90]">${escapeHtml(track.album)}</td>
                    <td class="p-4 text-right pr-4 sm:pr-6">
                        <button onclick="toggleTrack(${track.id})" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors ${track.in_library ? 'bg-[#330816] hover:bg-[#66112c] text-[#ff80a8] border border-[#66112c]' : 'bg-[#003B63] hover:bg-[#0092FC] text-[#00BBFC] border border-[#0092FC]'}">
                            ${track.in_library ? 'Remove' : 'Add'}
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function updatePaginationUI(stats) {
            totalTracks = stats.total;
            totalPages = stats.totalPages;
            currentPage = stats.page;

            document.getElementById('stat-total').innerText = stats.total;
            document.getElementById('stat-library').innerText = stats.library;

            const start = stats.filtered === 0 ? 0 : (currentPage - 1) * (stats.limit === 'all' ? stats.filtered : stats.limit) + 1;
            const end = stats.limit === 'all' ? stats.filtered : Math.min(currentPage * stats.limit, stats.filtered);

            document.getElementById('page-start-count').innerText = start;
            document.getElementById('page-end-count').innerText = end;
            document.getElementById('page-total-count').innerText = stats.filtered;
            document.getElementById('page-indicator').innerText = `Page ${currentPage} of ${totalPages}`;

            document.getElementById('btn-first-page').disabled = currentPage <= 1;
            document.getElementById('btn-prev-page').disabled = currentPage <= 1;
            document.getElementById('btn-next-page').disabled = currentPage >= totalPages;
            document.getElementById('btn-last-page').disabled = currentPage >= totalPages;
        }

        function handleSearchInput() {
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(() => {
                currentPage = 1;
                loadCatalog();
            }, 300);
        }

        function resetPageAndLoad() { currentPage = 1; loadCatalog(); }
        function handleSortByChange() { currentPage = 1; loadCatalog(); }
        function changePage(delta) { goToPage(currentPage + delta); }
        function goToPage(page) {
            if (page >= 1 && page <= totalPages) {
                currentPage = page;
                loadCatalog();
            }
        }

        function toggleTrack(trackId) {
            fetch('/api/user/toggle-track', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ track_id: trackId })
            })
            .then(r => r.json())
            .then(res => { if(res.success) loadCatalog(); });
        }

        function startMasterScan() {
            fetch('/api/catalog/scan', { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    if (!res.success) showAlert(res.message);
                    else pollScanStatus();
                });
        }

        function pollScanStatus() {
            const container = document.getElementById('master-scan-progress');
            if (!container) return;
            container.classList.remove('hidden');

            const interval = setInterval(() => {
                fetch('/api/catalog/scan-status')
                    .then(r => r.json())
                    .then(data => {
                        if (data.status === 'running' || data.status === 'fetching') {
                            document.getElementById('master-scan-status-text').innerText = data.message || 'Scanning...';
                            document.getElementById('master-scan-count-text').innerText = `${data.progress} / ${data.total}`;
                            const pct = data.total > 0 ? (data.progress / data.total) * 100 : 0;
                            document.getElementById('master-scan-bar').style.width = `${pct}%`;
                        } else {
                            clearInterval(interval);
                            container.classList.add('hidden');
                            if (data.status === 'completed') {
                                showAlert(data.message, "Scan Completed");
                                loadCatalog();
                            } else if (data.status === 'error') {
                                showAlert(data.message, "Scan Error");
                            }
                            fetch('/api/catalog/scan-dismiss', { method: 'POST' });
                        }
                    });
            }, 1000);
        }

        function openScanSettings() {
            fetch('/api/admin/scan-settings')
                .then(r => r.json())
                .then(data => {
                    document.getElementById('sys-rescan-interval').value = data.master_scan_interval || 0;
                    document.getElementById('sys-trash-folder').value = data.trash_folder || '';

                    currentExemptFolders = data.exempt_folders || [];
                    currentDumpFolders = data.dump_folders || [];
                    systemUsersList = data.users || [];

                    populateUserDropdown();
                    renderExemptFolders();
                    renderDumpFolders();

                    document.getElementById('scan-settings-modal').classList.remove('hidden');
                    document.getElementById('scan-settings-modal').classList.add('flex');
                });
        }

        function closeScanSettingsModal() {
            document.getElementById('scan-settings-modal').classList.add('hidden');
            document.getElementById('scan-settings-modal').classList.remove('flex');
        }

        function populateUserDropdown() {
            const select = document.getElementById('new-dump-folder-user-select');
            select.innerHTML = '<option value="">Unassigned / Global</option>';
            systemUsersList.forEach(u => {
                const opt = document.createElement('option');
                opt.value = u.id;
                opt.innerText = u.username;
                select.appendChild(opt);
            });
        }

        function renderExemptFolders() {
            const list = document.getElementById('exempt-folders-list');
            list.innerHTML = '';
            if (currentExemptFolders.length === 0) {
                list.innerHTML = `<div class="text-xs text-[#7a7d90] italic">No exempt folders configured.</div>`;
                return;
            }
            currentExemptFolders.forEach((folder, idx) => {
                const row = document.createElement('div');
                row.className = 'flex items-center justify-between bg-[#000012] p-2.5 rounded-lg border border-[#2a2e43] text-xs';
                row.innerHTML = `
                    <span class="font-mono text-[#ffffff] truncate mr-2">${escapeHtml(folder)}</span>
                    <button onclick="removeExemptFolder(${idx})" class="text-[#ff80a8] hover:text-[#ff3366] transition-colors">Remove</button>
                `;
                list.appendChild(row);
            });
        }

        function addExemptFolder() {
            const input = document.getElementById('new-exempt-folder-input');
            const val = input.value.trim();
            if (val && !currentExemptFolders.includes(val)) {
                currentExemptFolders.push(val);
                input.value = '';
                renderExemptFolders();
            }
        }

        function removeExemptFolder(idx) {
            currentExemptFolders.splice(idx, 1);
            renderExemptFolders();
        }

        function renderDumpFolders() {
            const list = document.getElementById('dump-folders-list');
            list.innerHTML = '';
            if (currentDumpFolders.length === 0) {
                list.innerHTML = `<div class="text-xs text-[#7a7d90] italic">No dump folders configured.</div>`;
                return;
            }
            currentDumpFolders.forEach((item, idx) => {
                const folderPath = typeof item === 'string' ? item : item.path;
                const taggedUserId = typeof item === 'object' ? item.user_id : null;

                const row = document.createElement('div');
                row.className = 'flex flex-col sm:flex-row items-start sm:items-center justify-between bg-[#000012] p-2.5 rounded-lg border border-[#2a2e43] text-xs gap-2';

                let userOptions = `<option value="" ${!taggedUserId ? 'selected' : ''}>Unassigned / Global</option>`;
                systemUsersList.forEach(u => {
                    userOptions += `<option value="${u.id}" ${taggedUserId == u.id ? 'selected' : ''}>${escapeHtml(u.username)}</option>`;
                });

                row.innerHTML = `
                    <span class="font-mono text-[#ffffff] truncate flex-1">${escapeHtml(folderPath)}</span>
                    <div class="flex items-center gap-2 w-full sm:w-auto">
                        <select onchange="updateDumpFolderUser(${idx}, this.value)" class="bg-[#000000] border border-[#2a2e43] text-[#00BBFC] text-xs rounded px-2 py-1 outline-none">
                            ${userOptions}
                        </select>
                        <button onclick="removeDumpFolder(${idx})" class="text-[#ff80a8] hover:text-[#ff3366] transition-colors ml-2">Remove</button>
                    </div>
                `;
                list.appendChild(row);
            });
        }

        function addDumpFolder() {
            const input = document.getElementById('new-dump-folder-input');
            const userSelect = document.getElementById('new-dump-folder-user-select');
            const pathVal = input.value.trim();
            const userVal = userSelect.value ? parseInt(userSelect.value) : null;

            if (pathVal) {
                currentDumpFolders.push({ path: pathVal, user_id: userVal });
                input.value = '';
                userSelect.value = '';
                renderDumpFolders();
            }
        }

        function updateDumpFolderUser(idx, val) {
            const user_id = val ? parseInt(val) : null;
            if (typeof currentDumpFolders[idx] === 'string') {
                currentDumpFolders[idx] = { path: currentDumpFolders[idx], user_id };
            } else {
                currentDumpFolders[idx].user_id = user_id;
            }
        }

        function removeDumpFolder(idx) {
            currentDumpFolders.splice(idx, 1);
            renderDumpFolders();
        }

        function saveScanSettings() {
            const interval = document.getElementById('sys-rescan-interval').value;
            const trashFolder = document.getElementById('sys-trash-folder').value.trim();

            fetch('/api/admin/scan-settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    master_scan_interval: interval,
                    exempt_folders: currentExemptFolders,
                    dump_folders: currentDumpFolders,
                    trash_folder: trashFolder
                })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    closeScanSettingsModal();
                    showAlert("Scan settings updated successfully.");
                } else {
                    showAlert(res.message || "Failed to save settings.");
                }
            });
        }

        function openUserManager() {
            loadUsersList();
            resetUserForm();
            document.getElementById('user-manager-modal').classList.remove('hidden');
            document.getElementById('user-manager-modal').classList.add('flex');
        }

        function closeUserManagerModal() {
            document.getElementById('user-manager-modal').classList.add('hidden');
            document.getElementById('user-manager-modal').classList.remove('flex');
        }

        function loadUsersList() {
            fetch('/api/admin/users')
                .then(r => r.json())
                .then(users => {
                    const tbody = document.getElementById('user-list-tbody');
                    tbody.innerHTML = '';
                    users.forEach(u => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td class="p-3 font-semibold text-[#ffffff]">${escapeHtml(u.username)}</td>
                            <td class="p-3 text-[#b4b7c5]">${escapeHtml(u.role)}</td>
                            <td class="p-3 text-[#00BBFC] font-mono">${escapeHtml(u.index_mode || 'standard')}</td>
                            <td class="p-3 text-[#7a7d90] font-mono">${escapeHtml(u.library_path)}</td>
                            <td class="p-3 text-right space-x-2">
                                <button onclick="editUser(${u.id}, '${escapeHtml(u.username)}', '${escapeHtml(u.library_path)}', '${u.index_mode}')" class="text-[#00BBFC] hover:underline">Edit</button>
                                ${u.role !== 'admin' ? `<button onclick="deleteUser(${u.id})" class="text-[#ff80a8] hover:underline">Delete</button>` : ''}
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                });
        }

        function resetUserForm() {
            document.getElementById('edit-user-id').value = '';
            document.getElementById('um-username').value = '';
            document.getElementById('um-password').value = '';
            document.getElementById('um-library-path').value = '';
            document.getElementById('um-index-mode').value = 'standard';
            document.getElementById('user-form-title').innerText = 'Add New User';
            document.getElementById('um-submit-btn').innerText = 'Create User';
        }

        function editUser(id, username, path, mode) {
            document.getElementById('edit-user-id').value = id;
            document.getElementById('um-username').value = username;
            document.getElementById('um-password').value = '';
            document.getElementById('um-library-path').value = path;
            document.getElementById('um-index-mode').value = mode || 'standard';
            document.getElementById('user-form-title').innerText = 'Edit User: ' + username;
            document.getElementById('um-submit-btn').innerText = 'Save Changes';
        }

        function handleUserFormSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('edit-user-id').value;
            const payload = {
                username: document.getElementById('um-username').value,
                password: document.getElementById('um-password').value,
                library_path: document.getElementById('um-library-path').value,
                index_mode: document.getElementById('um-index-mode').value
            };

            const url = id ? `/api/admin/users/${id}` : '/api/admin/users';
            const method = id ? 'PUT' : 'POST';

            fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    resetUserForm();
                    loadUsersList();
                } else {
                    showAlert(res.message);
                }
            });
        }

        function deleteUser(id) {
            if (!confirm("Are you sure you want to delete this user?")) return;
            fetch(`/api/admin/users/${id}`, { method: 'DELETE' })
                .then(r => r.json())
                .then(res => {
                    if (res.success) loadUsersList();
                    else showAlert(res.message);
                });
        }

        function openDeadFilesModal() {
            fetch('/api/admin/dead-files')
                .then(r => r.json())
                .then(files => {
                    const container = document.getElementById('dead-files-container');
                    container.innerHTML = '';
                    document.getElementById('dead-files-count').innerText = `${files.length} dead files detected`;

                    if (files.length === 0) {
                        container.innerHTML = `<div class="text-xs text-[#7a7d90] text-center p-4">No missing catalog files detected.</div>`;
                    } else {
                        files.forEach(f => {
                            const d = document.createElement('div');
                            d.className = 'text-xs text-[#ff80a8] font-mono truncate border-b border-[#1d202f] pb-1';
                            d.innerText = `${f.artist} - ${f.title} (${f.path})`;
                            container.appendChild(d);
                        });
                    }
                    document.getElementById('dead-files-modal').classList.remove('hidden');
                    document.getElementById('dead-files-modal').classList.add('flex');
                });
        }

        function closeDeadFilesModal() {
            document.getElementById('dead-files-modal').classList.add('hidden');
            document.getElementById('dead-files-modal').classList.remove('flex');
        }

        function purgeDeadFiles() {
            fetch('/api/admin/dead-files', { method: 'DELETE' })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        closeDeadFilesModal();
                        showAlert(`Purged ${res.purged} dead tracks from catalog.`);
                        loadCatalog();
                    } else {
                        showAlert(res.message);
                    }
                });
        }

        function autoSync() {
            fetch('/api/import/start-job', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ source_type: 'auto' })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) pollJobStatus();
                else showAlert(res.message);
            });
        }

        function openImportModal(type) {
            document.getElementById('import-text-data').value = '';
            document.getElementById('import-modal').classList.remove('hidden');
            document.getElementById('import-modal').classList.add('flex');
        }

        function closeImportModal() {
            document.getElementById('import-modal').classList.add('hidden');
            document.getElementById('import-modal').classList.remove('flex');
        }

        function submitManualImport() {
            const data = document.getElementById('import-text-data').value;
            if (!data.trim()) return;

            fetch('/api/import/start-job', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ source_type: 'text', input_data: data })
            })
            .then(r => r.json())
            .then(res => {
                closeImportModal();
                if (res.success) pollJobStatus();
                else showAlert(res.message);
            });
        }

        function pollJobStatus() {
            const container = document.getElementById('job-progress-container');
            container.classList.remove('hidden');

            const interval = setInterval(() => {
                fetch('/api/import/status')
                    .then(r => r.json())
                    .then(job => {
                        activeJobData = job;
                        document.getElementById('job-status-text').innerText = `Status: ${job.status}`;
                        document.getElementById('job-progress-text').innerText = `${job.progress || 0} / ${job.total || 0}`;
                        const pct = job.total > 0 ? ((job.progress || 0) / job.total) * 100 : 0;
                        document.getElementById('job-progress-bar').style.width = `${pct}%`;

                        if (job.status === 'completed' || job.status === 'auto_completed' || job.status === 'error') {
                            clearInterval(interval);
                            document.getElementById('job-action-container').classList.remove('hidden');
                            if (job.status === 'auto_completed') {
                                loadCatalog();
                            }
                        }
                    });
            }, 1000);
        }

        function clearJob() {
            fetch('/api/import/clear', { method: 'POST' }).then(() => {
                document.getElementById('job-progress-container').classList.add('hidden');
                document.getElementById('job-action-container').classList.add('hidden');
            });
        }

        function reviewJobResults() {
            if (!activeJobData || !activeJobData.result) return;
            const res = activeJobData.result;
            const container = document.getElementById('job-results-content');
            container.innerHTML = '';

            let html = `<div class="space-y-3">`;
            if (res.matches && res.matches.length > 0) {
                html += `<div class="font-bold text-[#00BBFC]">Matched Tracks (${res.matches.length})</div>`;
                res.matches.forEach(m => {
                    html += `<label class="flex items-center gap-2 bg-[#000000] p-2 rounded border border-[#2a2e43]"><input type="checkbox" name="review-match" value="${m.track_id}" checked> <span>${escapeHtml(m.display)}</span></label>`;
                });
            }
            if (res.missing && res.missing.length > 0) {
                html += `<div class="font-bold text-[#ff80a8] mt-3">Unmatched Queries (${res.missing.length})</div>`;
                res.missing.forEach(m => {
                    html += `<div class="bg-[#000000] p-2 rounded border border-[#2a2e43] text-[#7a7d90]">${escapeHtml(m.query)}</div>`;
                });
            }
            html += `</div>`;
            container.innerHTML = html;

            document.getElementById('job-results-modal').classList.remove('hidden');
            document.getElementById('job-results-modal').classList.add('flex');
        }

        function closeJobResultsModal() {
            document.getElementById('job-results-modal').classList.add('hidden');
            document.getElementById('job-results-modal').classList.remove('flex');
        }

        function confirmJobImport() {
            const checked = Array.from(document.querySelectorAll('input[name="review-match"]:checked')).map(cb => parseInt(cb.value));
            fetch('/api/import/confirm', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ track_ids: checked })
            })
            .then(r => r.json())
            .then(res => {
                closeJobResultsModal();
                clearJob();
                showAlert(res.message);
                loadCatalog();
            });
        }

        function openSyncSettings() {
            document.getElementById('sync-settings-modal').classList.remove('hidden');
            document.getElementById('sync-settings-modal').classList.add('flex');
        }

        function closeSyncSettingsModal() {
            document.getElementById('sync-settings-modal').classList.add('hidden');
            document.getElementById('sync-settings-modal').classList.remove('flex');
        }

        function saveSyncSettings() {
            const payload = {
                provider: document.getElementById('ss-provider').value,
                url: document.getElementById('ss-url').value,
                auto_sync: document.getElementById('ss-auto-sync').checked,
                one_for_one: document.getElementById('ss-one-for-one').checked,
                sync_interval: document.getElementById('ss-interval').value,
                spotify_client_id: document.getElementById('ss-spotify-id').value,
                spotify_client_secret: document.getElementById('ss-spotify-secret').value,
