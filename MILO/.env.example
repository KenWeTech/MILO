# MILO configuration
#
# Copy this file to .env and update the values for your installation.
# Do not commit real credentials, secrets, or private paths.

# Server Secret Key (used for session signing)
FLASK_SECRET_KEY=change-this-to-a-random-secret

# Path to your SQLite database file
DB_PATH=data/milo.db

# Master pool directory path
MASTER_POOL_DIR=/music

# Optional Spotify API Credentials (leave blank to use webpage extraction where available)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Optional Apple Music Developer Token (leave blank to use available webpage extraction)
APPLE_DEVELOPER_TOKEN=

# Optional DrivePool drive paths, separated by commas (example D:,G:,S:)
DRIVEPOOL_DRIVES=

# Optional library root for the initial administrator library and relative library paths for all users.
# If left blank, MILO uses ./MILO_Libraries relative to the server working directory.
# Docker example: LIBRARY_PATH=/app/MILO_Libraries
LIBRARY_PATH=

# Optional Built-In SSL
# Set to true to force HTTPS using certificates in the /ssl directory.
# Do NOT enable this if you are using a reverse proxy (e.g., Nginx, Traefik, Cloudflare).
USE_SSL=
