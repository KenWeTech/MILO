    <script>
        let pendingTracks = [];
        let existingTracks = [];
        let currentSyncContext = null;
        let currentPage = 1;
        let totalPages = 1;
        let searchTimeout = null;
        let syncPollInterval = null;
        let scanPollInterval = null;
        let jobResultsData = null;

        function escapeHtml(unsafe) {
            return (unsafe || "").toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        async function readJsonResponse(res) {
            const contentType = res.headers.get("content-type") || "";
            const text = await res.text();
            let data = null;
            if (text) { try { data = JSON.parse(text); } catch (e) {} }
            if (!res.ok) {
                if (data && data.message) throw new Error(`Server returned HTTP ${res.status}: ${data.message}`);
                if (res.status === 413) throw new Error("Import text is too large.");
                throw new Error(`Server error ${res.status}`);
            }
            if (!data) throw new Error("Invalid JSON");
            return data;
        }

        function toggleAdminConsoleMobile() {
            const c = document.getElementById('admin-console-container'), chev = document.getElementById('admin-console-chevron');
            c.classList.toggle('hidden'); c.classList.toggle('flex');
            chev.classList.toggle('rotate-180');
        }

        function toggleMobileRow(id) {
            const row = document.getElementById(`details-${id}`), chev = document.getElementById(`chevron-${id}`);
            if (row) { row.classList.toggle('hidden'); if(chev) chev.classList.toggle('rotate-180'); }
        }
        function toggleSyncActionsMobile() {
            const c = document.getElementById('sync-actions-container'), chev = document.getElementById('sync-actions-chevron');
            if (c) { c.classList.toggle('hidden'); if(chev) chev.classList.toggle('rotate-180'); }
        }
        function toggleFiltersMobile() {
            const c = document.getElementById('filters-container'), chev = document.getElementById('filters-chevron');
            c.classList.toggle('hidden'); c.classList.toggle('grid'); chev.classList.toggle('rotate-180');
        }

        function handleSortByChange() {
            const sortBy = document.getElementById('sort-by').value;
            if (sortBy === 'added') document.getElementById('sort-order').value = 'desc';
            resetPageAndLoad();
        }
        function handleSearchInput() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(resetPageAndLoad, 300);
        }
        function resetPageAndLoad() { currentPage = 1; loadCatalog(); }
        function changePage(delta) { const p = currentPage + delta; if(p>=1 && p<=totalPages) { currentPage = p; loadCatalog(); } }
        function goToPage(page) { if (page>=1 && page<=totalPages) { currentPage = page; loadCatalog(); } }

        async function loadCatalog() {
            try {
                const query = document.getElementById('search-input').value;
                const libFlt = document.getElementById('library-filter').value;
                const sort = document.getElementById('sort-by').value;
                const ord = document.getElementById('sort-order').value;
                const limit = document.getElementById('page-limit').value;

                const res = await fetch(`/api/catalog?q=${encodeURIComponent(query)}&library_filter=${libFlt}&sort=${sort}&order=${ord}&page=${currentPage}&limit=${limit}`);
                const data = await readJsonResponse(res);

                const tracks = Array.isArray(data) ? data : (data.tracks || []);
                const stats = data.stats || null;

                if (stats) {
                    document.getElementById('stat-total').innerText = stats.total.toLocaleString();
                    document.getElementById('stat-library').innerText = stats.library.toLocaleString();
                    const filtered = stats.filtered || 0;
                    totalPages = stats.totalPages || 1;
                    currentPage = stats.page || 1;
                    const limitVal = stats.limit === 'all' ? filtered : (stats.limit || 50);
                    const start = filtered === 0 ? 0 : (currentPage - 1) * limitVal + 1;
                    const end = stats.limit === 'all' ? filtered : Math.min(currentPage * limitVal, filtered);

                    document.getElementById('page-start-count').innerText = start.toLocaleString();
                    document.getElementById('page-end-count').innerText = end.toLocaleString();
                    document.getElementById('page-total-count').innerText = filtered.toLocaleString();
                    document.getElementById('page-indicator').innerText = `Page ${currentPage} of ${totalPages || 1}`;

                    document.getElementById('btn-first-page').disabled = currentPage <= 1;
                    document.getElementById('btn-prev-page').disabled = currentPage <= 1;
                    document.getElementById('btn-next-page').disabled = currentPage >= totalPages;
                    document.getElementById('btn-last-page').disabled = currentPage >= totalPages;
                    const pContainer = document.getElementById('pagination-controls');
                    if(pContainer) pContainer.style.display = (stats.limit==='all' || filtered===0) ? 'none' : 'flex';
                }

                document.getElementById('catalog-table').innerHTML = tracks.map(t => `
                    <tr class="hover:bg-[#1d202f]/80 transition-colors cursor-pointer sm:cursor-default" onclick="toggleMobileRow(${t.id})">
                        <td class="p-4 font-medium text-[#f1f2f6]">
                            <div class="flex items-center justify-between">
                                <div class="truncate max-w-[180px] sm:max-w-xs font-semibold text-[#fcfcfc]">
                                    ${escapeHtml(t.title)}
                                    <div class="sm:hidden text-xs text-[#b4b7c5] font-normal truncate mt-0.5">${escapeHtml(t.artist)}</div>
                                </div>
                                <button class="sm:hidden text-[#7a7d90] hover:text-[#d5d7e0] ml-2 p-1"><svg id="chevron-${t.id}" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></button>
                            </div>
                        </td>
                        <td class="p-4 text-[#b4b7c5] truncate max-w-[150px] hidden sm:table-cell">${escapeHtml(t.artist)}</td>
                        <td class="p-4 text-[#b4b7c5] truncate max-w-[150px] hidden sm:table-cell">${escapeHtml(t.album)}</td>
                        <td class="p-4 text-right pr-4 sm:pr-6" onclick="event.stopPropagation()">
                            <button onclick="toggleTrack(${t.id})" class="px-3.5 py-1.5 text-xs font-semibold rounded-md border ${t.in_library ? 'bg-[#330816]/30 border-[#66112c]/50 text-[#ff80a8] hover:bg-[#66112c]/50' : 'bg-[#182940] border-[#0092FC] text-[#d5d7e0] hover:bg-[#0092FC] hover:text-[#ffffff]'}">
                                ${t.in_library ? 'Remove' : 'Add'}
                            </button>
                        </td>
                    </tr>
                    <tr id="details-${t.id}" class="hidden sm:hidden bg-[#000000]/80 border-b border-[#216281]/80">
                        <td colspan="2" class="p-3 text-xs space-y-1.5">
                            <div><span class="text-[#7a7d90] uppercase font-semibold text-[10px]">Artist:</span> <span class="text-[#d5d7e0] ml-1">${escapeHtml(t.artist)}</span></div>
                            <div><span class="text-[#7a7d90] uppercase font-semibold text-[10px]">Album:</span> <span class="text-[#d5d7e0] ml-1">${escapeHtml(t.album)}</span></div>
                        </td>
                    </tr>
                `).join('');
            } catch (err) {}
        }

        async function toggleTrack(id) {
            try {
                const res = await fetch('/api/user/toggle-track', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ track_id: id }) });
                await readJsonResponse(res);
                loadCatalog();
            } catch (err) { alert(`Failed: ${err.message}`); }
        }

        async function startMasterScan() {
            try {
                const res = await fetch('/api/catalog/scan', { method: 'POST' });
                await readJsonResponse(res);
                pollScanStatus();
            } catch (e) { alert(`Error: ${e.message}`); }
        }

        async function pollScanStatus() {
            try {
                const res = await fetch('/api/catalog/scan-status');
                const job = await readJsonResponse(res);

                const btn = document.getElementById('btn-master-scan');
                const progressDiv = document.getElementById('master-scan-progress');
                const pText = document.getElementById('master-scan-status-text');
                const pCount = document.getElementById('master-scan-count-text');
                const pBar = document.getElementById('master-scan-bar');

                if(!btn) return;

                if (job.status === 'idle') {
                    btn.style.display = 'block';
                    progressDiv.classList.add('hidden');
                    progressDiv.classList.remove('flex');
                    if (scanPollInterval) clearInterval(scanPollInterval);
                    return;
                }

                btn.style.display = 'none';
                progressDiv.classList.remove('hidden');
                progressDiv.classList.add('flex');

                if (job.status === 'fetching') {
                    pText.innerText = "Indexing...";
                    pCount.innerText = "...";
                    pBar.style.width = '100%';
                    pBar.classList.add('animate-pulse');
                    if (!scanPollInterval) scanPollInterval = setInterval(pollScanStatus, 1500);
                } else if (job.status === 'running') {
                    pBar.classList.remove('animate-pulse');
                    pText.innerText = "Scanning Pool";
                    pCount.innerText = `${job.progress} / ${job.total}`;
                    pBar.style.width = job.total > 0 ? `${(job.progress/job.total)*100}%` : '0%';
                    if (!scanPollInterval) scanPollInterval = setInterval(pollScanStatus, 1000);
                } else if (job.status === 'completed' || job.status === 'error') {
                    pBar.classList.remove('animate-pulse');
                    pText.innerText = job.status === 'completed' ? "Completed" : "Error";
                    pCount.innerText = job.status === 'completed' ? `${job.total}/${job.total}` : "Failed";
                    pBar.style.width = '100%';
                    pBar.classList.replace('bg-[#00BBFC]', job.status==='completed' ? 'bg-[#2EA8FF]' : 'bg-[#ff558a]');
                    if (scanPollInterval) clearInterval(scanPollInterval);
                    scanPollInterval = null;
                    setTimeout(async () => {
                        await fetch('/api/catalog/scan-dismiss', {method:'POST'});
                        btn.style.display = 'block';
                        progressDiv.classList.add('hidden');
                        progressDiv.classList.remove('flex');
                        loadCatalog();
                    }, 4000);
                }
            } catch(e) {}
        }

        function openSystemSettings() {
            fetch('/api/admin/system-settings').then(r=>r.json()).then(data => {
                document.getElementById('sys-master-interval').value = data.master_scan_interval || 0;
                document.getElementById('system-modal').classList.remove('hidden');
            });
        }
        async function saveSystemSettings() {
            const master_scan_interval = document.getElementById('sys-master-interval').value;
            await fetch('/api/admin/system-settings', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({master_scan_interval})});
            closeModal('system-modal');
        }

        function openSyncSettings() { document.getElementById('sync-modal').classList.remove('hidden'); }
        async function saveSyncSettings() {
            try {
                const provider = document.getElementById('sync-provider').value;
                const url = document.getElementById('sync-url').value;
                const auto_sync = document.getElementById('sync-auto').checked;
                const one_for_one = document.getElementById('sync-one-for-one').checked;
                const sync_interval = document.getElementById('sync-interval').value;

                const spotify_client_id = document.getElementById('api-spotify-id').value;
                const spotify_client_secret = document.getElementById('api-spotify-secret').value;
                const apple_dev_token = document.getElementById('api-apple-token').value;

                const res = await fetch('/api/user/sync-settings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ 
                    provider, url, auto_sync, one_for_one, sync_interval, spotify_client_id, spotify_client_secret, apple_dev_token 
                })});
                const data = await readJsonResponse(res);
                closeModal('sync-modal');
                alert(data.message);
                window.location.reload();
            } catch (err) { alert(`Failed: ${err.message}`); }
        }

        function openImportModal(context) {
            currentSyncContext = context;
            document.getElementById('import-modal').classList.remove('hidden');
            document.getElementById('import-modal-title').innerText = context === 'auto' ? "Auto-Sync Output" : "Manual Import";
            const isAuto = context === 'auto';
            document.getElementById('import-back-btn').style.display = isAuto ? 'none' : 'block';
            document.getElementById('import-close-btn').style.display = isAuto ? 'block' : 'none';
            resetImportModal();
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
            if (id === 'import-modal') {
                pendingTracks = [];
                existingTracks = [];
                currentSyncContext = null;
                document.getElementById('import-input').value = '';
                document.getElementById('import-setup').classList.remove('hidden');
                document.getElementById('setup-actions').classList.replace('hidden', 'flex');
                document.getElementById('import-diff').classList.add('hidden');
                document.getElementById('diff-actions').classList.replace('flex', 'hidden');
            } else if (id === 'user-modal') {
                resetUserForm();
            }
        }

        function resetImportModal() {
            pendingTracks = []; existingTracks = [];
            document.getElementById('diff-add-count').innerText = "0";
            document.getElementById('diff-exist-count').innerText = "0";
            document.getElementById('diff-miss-count').innerText = "0";
            if (currentSyncContext === 'manual') {
                document.getElementById('import-setup').classList.remove('hidden');
                document.getElementById('setup-actions').classList.remove('hidden'); document.getElementById('setup-actions').classList.add('flex');
                document.getElementById('import-diff').classList.add('hidden');
                document.getElementById('diff-actions').classList.remove('flex'); document.getElementById('diff-actions').classList.add('hidden');
            }
        }

        async function autoSync() {
            jobResultsData = null;
            document.getElementById('job-review-btn').style.display = 'none';

            try {
                const res = await fetch('/api/import/start-job', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({source_type: 'auto'}) });
                await readJsonResponse(res);
                pollJobStatus();
            } catch (err) { alert(`Failed to start auto-sync: ${err.message}`); }
        }

        async function previewImport() {
            const type = document.getElementById('import-source').value;
            const data = document.getElementById('import-input').value;

            jobResultsData = null;
            document.getElementById('job-review-btn').style.display = 'none';

            try {
                const res = await fetch('/api/import/start-job', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({source_type: type, input_data: data}) });
                await readJsonResponse(res);
                pollJobStatus();
                closeModal('import-modal');
            } catch (err) { alert(`Failed: ${err.message}`); }
        }

        async function pollJobStatus() {
            try {
                const res = await fetch('/api/import/status');
                const job = await readJsonResponse(res);
                if (job.status === 'idle') {
                    document.getElementById('job-progress-container').classList.add('hidden');
                    if (syncPollInterval) { clearInterval(syncPollInterval); syncPollInterval = null; }
                    return;
                }

                document.getElementById('job-progress-container').classList.remove('hidden');
                document.getElementById('job-action-container').classList.add('hidden');

                const statusEl = document.getElementById('job-status-text'), progEl = document.getElementById('job-progress-text'), barEl = document.getElementById('job-progress-bar');

                if (job.status === 'fetching') {
                    statusEl.innerText = "Fetching Data from Provider..."; progEl.innerText = "Connecting..."; barEl.style.width = "100%"; barEl.classList.add('animate-pulse');
                    if (!syncPollInterval) syncPollInterval = setInterval(pollJobStatus, 1000);
                } else if (job.status === 'processing') {
                    barEl.classList.remove('animate-pulse'); statusEl.innerText = "Fuzzy Matching Tracks..."; progEl.innerText = `${job.progress} / ${job.total}`;
                    barEl.style.width = job.total > 0 ? `${(job.progress / job.total) * 100}%` : '0%';
                    if (!syncPollInterval) syncPollInterval = setInterval(pollJobStatus, 1000);
                } else if (job.status === 'completed' || job.status === 'auto_completed') {
                    barEl.classList.remove('animate-pulse'); statusEl.innerText = job.status === 'auto_completed' ? "Auto-Sync Completed" : "Sync Processing Completed";
                    progEl.innerText = `${job.total} / ${job.total}`; barEl.style.width = '100%';
                    document.getElementById('job-action-container').classList.remove('hidden');
                    if(job.status === 'auto_completed') {
                        document.getElementById('job-review-btn').style.display = 'none';
                        statusEl.innerText = `Auto-Sync Completed (Added: ${job.result.added_count}, Removed: ${job.result.removed_count})`;
                        loadCatalog();
                    } else {
                        document.getElementById('job-review-btn').style.display = 'block';
                    }
                    jobResultsData = job.result;
                    if (syncPollInterval) { clearInterval(syncPollInterval); syncPollInterval = null; }
                } else if (job.status === 'error') {
                    jobResultsData = null;
                    document.getElementById('job-review-btn').style.display = 'none';

                    barEl.classList.remove('animate-pulse'); statusEl.innerText = `Scan Failed: ${job.error}`; statusEl.classList.replace('text-[#00BBFC]', 'text-[#ff80a8]');
                    barEl.classList.replace('bg-[#2B66FD]', 'bg-[#ff558a]'); document.getElementById('job-action-container').classList.remove('hidden');
                    if (syncPollInterval) { clearInterval(syncPollInterval); syncPollInterval = null; }
                }
            } catch(e) {}
        }

        function reviewJobResults() {
            if (!jobResultsData) return;

            const matches = jobResultsData.matches || [];
            const exists = jobResultsData.exists || [];
            const missing = jobResultsData.missing || [];

            pendingTracks = matches.map(m => m.track_id);
            existingTracks = exists.map(m => m.track_id);

            document.getElementById('import-modal').classList.remove('hidden');
            document.getElementById('import-modal-title').innerText = "Import Results";

            document.getElementById('import-setup').classList.add('hidden');
            document.getElementById('setup-actions').classList.remove('flex');
            document.getElementById('setup-actions').classList.add('hidden');

            document.getElementById('import-diff').classList.remove('hidden');

            document.getElementById('diff-actions').classList.remove('hidden');
            document.getElementById('diff-actions').classList.add('flex');

            document.getElementById('import-back-btn').style.display = 'none';
            document.getElementById('import-close-btn').style.display = 'block';

            document.getElementById('diff-add-count').innerText = matches.length;
            document.getElementById('diff-exist-count').innerText = exists.length;
            document.getElementById('diff-miss-count').innerText = missing.length;

            document.getElementById('diff-add').innerHTML = matches.length > 0
                ? matches.map(m => `
                    <li class="flex justify-between items-center text-[#00BBFC]">
                        <span class="truncate pr-2">${escapeHtml(m.display)}</span>
                        <span class="text-[#6E57FD]/50 flex-shrink-0">${m.confidence}%</span>
                    </li>
                `).join('')
                : `<li class="text-[#7a7d90]">No new tracks to add.</li>`;

            document.getElementById('diff-exist').innerHTML = exists.length > 0
                ? exists.map(m => `
                    <li class="text-[#b4b7c5] truncate">
                        ${escapeHtml(m.display)}
                    </li>
                `).join('')
                : `<li class="text-[#7a7d90]">No existing tracks found.</li>`;

            document.getElementById('diff-miss').innerHTML = missing.length > 0
                ? missing.map(m => `
                    <li class="text-[#814AC8]/80 truncate">
                        ${escapeHtml(m.query)}
                    </li>
                `).join('')
                : `<li class="text-[#7a7d90]">All tracks successfully mapped.</li>`;
        }

        async function confirmImport() {
            try {
                const res = await fetch('/api/import/confirm', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({track_ids: pendingTracks, existing_ids: existingTracks}) });
                const data = await readJsonResponse(res);
                alert(data.message);
                closeModal('import-modal'); clearJob(); loadCatalog();
            } catch (err) { alert(`Failed: ${err.message}`); }
        }

        async function clearJob() {
            jobResultsData = null;
            document.getElementById('job-review-btn').style.display = 'none';
            await fetch('/api/import/clear', { method: 'POST' });
            document.getElementById('job-progress-container').classList.add('hidden');
        }

        async function openMissingLogsModal() {
            document.getElementById('missing-logs-modal').classList.remove('hidden');
            try {
                const res = await fetch('/api/user/missing-logs');
                const logs = await readJsonResponse(res);

                document.getElementById('missing-logs-table').innerHTML = logs.map(l => {
                    const suggestionHtml = l.suggestions && l.suggestions.length > 0 ? 
                        `<div class="mt-3 space-y-1.5">
                            <p class="text-[10px] text-[#7a7d90] uppercase font-semibold tracking-wider">Similar Tracks Found:</p>
                            ${l.suggestions.map(s => `
                                <div class="flex justify-between items-center bg-[#000012] border border-[#2a2e43] p-2 rounded-lg">
                                    <span class="text-xs text-[#d5d7e0] truncate mr-2">${escapeHtml(s.display)} <span class="text-[#00BBFC]/70 ml-1">(${s.confidence}%)</span></span>
                                    <button onclick="resolveMissingLog(${l.id}, ${s.track_id})" class="text-[10px] bg-[#1E416B]/40 hover:bg-[#2EA8FF]/60 text-[#5CD6FF] border border-[#2EA8FF] px-3 py-1.5 rounded transition-colors flex-shrink-0">Add Match</button>
                                </div>
                            `).join('')}
                        </div>` : `<div class="mt-2 text-[10px] text-[#7a7d90] italic">No similar tracks found in pool.</div>`;

                    return `
                    <tr class="hover:bg-[#1d202f]/30 transition-colors">
                        <td class="p-4 w-full border-b border-[#216281]/50">
                            <div class="font-mono text-sm text-[#A05AFA]/90 mb-1">
                                ${escapeHtml(l.query)}
                            </div>
                            ${suggestionHtml}
                        </td>
                        <td class="p-4 text-xs font-semibold uppercase text-[#7a7d90] align-top border-b border-[#216281]/50">
                            ${escapeHtml(l.source)}
                        </td>
                        <td class="p-4 text-right pr-6 align-top border-b border-[#216281]/50">
                            <button onclick="deleteMissingLog(${l.id})" class="text-[#b4b7c5] hover:text-[#ff80a8] text-xs px-4 py-2 border border-[#2a2e43] hover:border-[#66112c]/50 rounded-md bg-[#000012] hover:bg-[#330816]/30 transition-colors">
                                Dismiss
                            </button>
                        </td>
                    </tr>`;
                }).join('');
            } catch (err) { console.error("Failed to load missing logs:", err); }
        }
        async function resolveMissingLog(logId, trackId) {
            await fetch('/api/user/missing-logs/resolve', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({log_id:logId, track_id:trackId})});
            openMissingLogsModal(); loadCatalog();
        }
        async function deleteMissingLog(logId) { await fetch(`/api/user/missing-logs/${logId}`, {method:'DELETE'}); openMissingLogsModal(); }
        async function dismissAllMissingLogs() { await fetch('/api/user/missing-logs/all', {method:'DELETE'}); openMissingLogsModal(); }

        async function openRemovedLogsModal() {
            try {
                const res = await fetch('/api/user/removed-logs');
                const logs = await res.json();
                document.getElementById('removed-logs-table').innerHTML = logs.map(l => `
                    <tr>
                        <td class="p-4 text-sm font-semibold text-[#f1f2f6]">${escapeHtml(l.title)}</td>
                        <td class="p-4 text-sm text-[#b4b7c5]">${escapeHtml(l.artist)}</td>
                        <td class="p-4 text-right pr-6">
                            <button onclick="restoreTrack(${l.track_id})" class="text-xs bg-[#2C53CA] hover:bg-[#2B66FD] text-[#ffffff] px-3 py-1.5 rounded transition-colors">Add Back</button>
                        </td>
                    </tr>
                `).join('');
                document.getElementById('removed-logs-modal').classList.remove('hidden');
            } catch(e) {}
        }

        async function restoreTrack(trackId) {
            await fetch('/api/user/removed-logs/restore', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({track_ids: [trackId]})});
            openRemovedLogsModal(); loadCatalog();
        }

        <% if (current_user.role === 'admin') { %>

        async function openUserManager() {
            const res = await fetch('/api/admin/users');
            const users = await res.json();
            document.getElementById('user-table').innerHTML = users.map(u => `
                <tr>
                    <td class="p-4 text-[#f1f2f6] font-medium">${escapeHtml(u.username)}</td>
                    <td class="p-4 text-[#b4b7c5] text-xs uppercase">${escapeHtml(u.role)}</td>
                    <td class="p-4 text-[#b4b7c5] text-xs uppercase">${escapeHtml(u.index_mode)}</td>
                    <td class="p-4 text-[#b4b7c5] font-mono text-xs truncate max-w-[200px]">${escapeHtml(u.library_path)}</td>
                    <td class="p-4 text-right pr-6 flex gap-2 justify-end">
                        <button onclick="editUser('${u.id}', '${u.username}', '${escapeHtml(u.library_path).replace(/\\/g, '\\\\')}', '${u.index_mode}')" class="text-[#00BBFC] hover:text-[#2EA8FF] text-xs transition-colors">Edit</button>
                        ${u.role !== 'admin' ? `<button onclick="deleteUser(${u.id})" class="text-[#ff80a8] hover:text-[#ffabc5] text-xs transition-colors">Delete</button>` : ''}
                    </td>
                </tr>
            `).join('');
            document.getElementById('user-modal').classList.remove('hidden');
        }
        function editUser(id, username, path, mode) {
            document.getElementById('edit-u-id').value = id;
            document.getElementById('new-u').value = username;
            document.getElementById('new-path').value = path;
            document.getElementById('new-mode').value = mode;
            document.getElementById('user-form-title').innerText = "Edit User";
            document.getElementById('btn-save-user').innerText = "Update";
            document.getElementById('btn-cancel-user').classList.remove('hidden');
        }
        function resetUserForm() {
            document.getElementById('edit-u-id').value = "";
            document.getElementById('new-u').value = "";
            document.getElementById('new-p').value = "";
            document.getElementById('new-path').value = "";
            document.getElementById('new-mode').value = "standard";
            document.getElementById('user-form-title').innerText = "Create New User";
            document.getElementById('btn-save-user').innerText = "Add";
            document.getElementById('btn-cancel-user').classList.add('hidden');
        }
        async function saveUserForm() {
            const id = document.getElementById('edit-u-id').value;
            const payload = {
                username: document.getElementById('new-u').value,
                password: document.getElementById('new-p').value,
                library_path: document.getElementById('new-path').value,
                index_mode: document.getElementById('new-mode').value
            };
            try {
                if (id) {
                    await fetch(`/api/admin/users/${id}`, { method: 'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
                } else {
                    await fetch('/api/admin/users', { method: 'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
                }
                resetUserForm();
                openUserManager();
            } catch (err) { alert(`Error saving user.`); }
        }
        async function deleteUser(id) {
            if(confirm("Are you sure you want to delete this user?")) {
                await fetch(`/api/admin/users/${id}`, { method: 'DELETE' }); openUserManager();
            }
        }
        async function openDeadFilesModal() {
            const res = await fetch('/api/admin/dead-files');
            const dead = await res.json();
            document.getElementById('dead-count-display').innerText = `${dead.length} Dead Entries Found`;
            document.getElementById('dead-files-table').innerHTML = dead.map(d => `<tr><td class="p-4 font-medium text-[#f1f2f6]">${escapeHtml(d.title)}</td><td class="p-4 text-[#b4b7c5]">${escapeHtml(d.artist)}</td><td class="p-4 text-right pr-6 font-mono text-xs text-[#ff80a8] truncate max-w-[200px]" title="${escapeHtml(d.path)}">${escapeHtml(d.path)}</td></tr>`).join('');
            document.getElementById('dead-files-modal').classList.remove('hidden');
        }
        async function purgeDeadFiles() { await fetch('/api/admin/dead-files', { method: 'DELETE' }); openDeadFilesModal(); }
        <% } %>

        document.addEventListener("DOMContentLoaded", () => {
            loadCatalog();
            pollJobStatus();
            pollScanStatus();
        });
    </script>
<% } %>
</body>
</html>
