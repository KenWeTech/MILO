        async function saveTextPlaylist() {
            if (!textPlaylistLoaded) {
                showAlert('Text Playlist Not Loaded', 'Open Sync Settings again after the playlist has loaded; no changes have been saved.', false);
                return;
            }
            const button = document.getElementById('ss-text-playlist-save-btn');
            button.disabled = true;
            document.getElementById('ss-text-playlist-status').innerText = 'Saving Text Playlist...';
            try {
                const response = await fetch('/api/user/text-playlist', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text: document.getElementById('ss-text-playlist').value })
                });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || 'Could not save the Text Playlist.');
                document.getElementById('ss-text-playlist-status').innerText = data.message || 'Text Playlist saved.';
                showAlert('Text Playlist Saved', data.message || 'Text Playlist saved.', true);
            } catch (error) {
                document.getElementById('ss-text-playlist-status').innerText = 'Text Playlist was not saved.';
                showAlert('Text Playlist Not Saved', error.message || 'Could not save the Text Playlist.', false);
            } finally {
                button.disabled = !textPlaylistLoaded;
            }
        }

        async function generateTextPlaylistApiKey() {
            if (hasTextPlaylistApiKey && !(await showConfirm('Replace API Key', 'Generating a replacement key immediately invalidates the old key. Continue?', 'Replace Key'))) return;
            try {
                const response = await fetch('/api/user/text-playlist/api-key', { method: 'POST' });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || 'Could not generate a key.');
                hasTextPlaylistApiKey = true;
                document.getElementById('ss-text-playlist-api-key').value = data.api_key || '';
                document.getElementById('ss-text-playlist-api-key').type = 'text';
                document.getElementById('ss-text-playlist-api-key-status').innerText = 'New key created. Copy it now; the full key is only shown in this session.';
                showAlert('API Key Created', data.message, true);
            } catch (error) {
                showAlert('Key Generation Failed', error.message, false);
            }
        }

        async function revokeTextPlaylistApiKey() {
            if (!hasTextPlaylistApiKey) {
                showAlert('No Key to Revoke', 'There is no active API key for this user.', false);
                return;
            }
            if (!(await showConfirm('Revoke API Key', 'Revoke the current API key? Any application using it will stop working.', 'Revoke Key'))) return;
            try {
                const response = await fetch('/api/user/text-playlist/api-key', { method: 'DELETE' });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || 'Could not revoke the key.');
                hasTextPlaylistApiKey = false;
                document.getElementById('ss-text-playlist-api-key').value = '';
                document.getElementById('ss-text-playlist-api-key').type = 'password';
                document.getElementById('ss-text-playlist-api-key-status').innerText = 'No API key is active.';
                showAlert('API Key Revoked', data.message, true);
            } catch (error) {
                showAlert('Key Revocation Failed', error.message, false);
            }
        }

        async function copyTextPlaylistApiKey() {
            const input = document.getElementById('ss-text-playlist-api-key');
            if (!input.value) {
                showAlert('No API Key Displayed', 'Generate an API key first. If you already generated one and left the page, generate a replacement key.', false);
                return;
            }
            input.type = 'text';
            input.focus();
            input.select();
            try {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(input.value);
                    showAlert('Key Copied', 'API key copied to the clipboard.', true);
                } else {
                    showAlert('Key Selected', 'The key is selected. Copy it using your browser or keyboard shortcut.', true);
                }
            } catch (_) {
                showAlert('Key Selected', 'The key is selected. Copy it using your browser or keyboard shortcut.', true);
            }
        }

        function openRemovedLogsModal() {
            const modalToken = showManagedModal('removed-logs-modal', 'removed-logs-list', 'Loading removed-track history…');
            fetch('/api/user/removed-logs')
                .then(async response => {
                    const logs = await response.json();
                    if (!response.ok) throw new Error(logs.message || 'Could not load removed-track history.');
                    return logs;
                })
                .then(logs => {
                    if (!isManagedModalCurrent('removed-logs-modal', modalToken)) return;
                    const container = document.getElementById('removed-logs-list');
                    container.innerHTML = '';
                    if (!Array.isArray(logs) || logs.length === 0) {
                        container.innerHTML = `<div class="text-[#7a7d90] text-center p-4">No removed tracks recorded.</div>`;
                    } else {
                        logs.forEach(l => {
                            const id = Number(l.track_id);
                            const d = document.createElement('label');
                            d.className = 'flex items-center gap-2 bg-[#000000] p-2.5 rounded border border-[#2a2e43]';
                            d.innerHTML = `<input type="checkbox" name="restore-track" value="${id}" ${restoreTrackSelections.has(id) ? 'checked' : ''} onchange="toggleRestoreTrackItem(${id}, this.checked)" class="accent-[#2B66FD]"> <span>${escapeHtml(l.artist)} - ${escapeHtml(l.title)}</span>`;
                            container.appendChild(d);
                        });
                    }
                    updateRestoreTrackSelectionUI();
                })
                .catch(error => {
                    if (isManagedModalCurrent('removed-logs-modal', modalToken)) {
                        document.getElementById('removed-logs-list').innerHTML = `<div class="text-xs text-[#ff80a8] p-4">${escapeHtml(error.message || 'Could not load removed-track history.')}</div>`;
                        updateRestoreTrackSelectionUI();
                    }
                });
        }

        function updateRestoreTrackSelectionUI() {
            const selectedOnPage = [...document.querySelectorAll('input[name="restore-track"]')].filter(input => input.checked).length;
            const visibleCount = document.querySelectorAll('input[name="restore-track"]').length;
            const count = document.getElementById('restore-tracks-selection-count');
            const all = document.getElementById('restore-tracks-select-all');
            const submit = document.getElementById('restore-tracks-submit');
            if (count) count.innerText = `${restoreTrackSelections.size} selected`;
            if (submit) submit.disabled = restoreTrackSelections.size === 0;
            if (all) {
                all.checked = visibleCount > 0 && selectedOnPage === visibleCount;
                all.indeterminate = selectedOnPage > 0 && selectedOnPage < visibleCount;
                all.disabled = visibleCount === 0;
            }
        }

        function toggleRestoreTrackItem(trackId, checked) {
            const id = Number(trackId);
            if (!Number.isSafeInteger(id) || id <= 0) return;
            if (checked) restoreTrackSelections.add(id);
            else restoreTrackSelections.delete(id);
            updateRestoreTrackSelectionUI();
        }

        function toggleRestoreTrackSelection(checked) {
            document.querySelectorAll('input[name="restore-track"]').forEach(input => {
                const id = Number(input.value);
                input.checked = !!checked;
                if (checked && id > 0) restoreTrackSelections.add(id);
                else restoreTrackSelections.delete(id);
            });
            updateRestoreTrackSelectionUI();
        }

        function closeRemovedLogsModal() { closeManagedModal('removed-logs-modal'); }

        async function restoreSelectedTracks() {
            const trackIds = [...restoreTrackSelections].map(Number).filter(id => Number.isSafeInteger(id) && id > 0);
            if (!trackIds.length) {
                showAlert('Restore Tracks', 'Select one or more removed tracks first.', false);
                return;
            }
            if (!(await showConfirm('Restore Selected Tracks', `Restore ${trackIds.length} selected track${trackIds.length === 1 ? '' : 's'} to your library?`, 'Restore Tracks'))) return;

            closeRemovedLogsModal();
            showSecondaryProgressPanel({ status: 'running', progress: 0, total: trackIds.length, message: `Starting restore for ${trackIds.length} selected track${trackIds.length === 1 ? '' : 's'}...` }, 'restore-tracks-bulk', 'Open Restore Tracks', openRemovedLogsModal);
            try {
                const response = await fetch('/api/user/removed-logs/restore', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ track_ids: trackIds })
                });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not start restoring the selected tracks.');
                restoreTrackSelections.clear();
                pollRestoreTracksJobStatus();
            } catch (error) {
                activeProgressJobType = null;
                document.getElementById('job-progress-container').classList.add('hidden');
                document.getElementById('job-action-container').classList.add('hidden');
                openRemovedLogsModal();
                showAlert('Restore Tracks', error.message || 'Could not contact the restore endpoint.', false);
            }
        }

        async function pollRestoreTracksJobStatus(suppressCompletionAlert = false) {
            if (restoreStatusPollInterval) clearInterval(restoreStatusPollInterval);
            let inFlight = false;
            const poll = async () => {
                if (inFlight) return;
                inFlight = true;
                try {
                    const response = await fetch('/api/user/removed-logs/restore/status');
                    const job = await response.json();
                    if (!response.ok) throw new Error(job.message || 'Could not read restore progress.');
                    showSecondaryProgressPanel(job, 'restore-tracks-bulk', 'Open Restore Tracks', openRemovedLogsModal);
                    if (job.status === 'completed' || job.status === 'error') {
                        clearInterval(restoreStatusPollInterval);
                        restoreStatusPollInterval = null;
                        loadCatalog();
                        const result = job.result || {};
                        const details = Array.isArray(result.errors) ? result.errors.slice(0, 5).map(item => `Track ${item.track_id}: ${item.message}`).join('\n') : '';
                        if (!suppressCompletionAlert) showAlert('Restore Tracks', `${job.message}${details ? '\n' + details : ''}`, job.status === 'completed' && !(Number(result.failed) > 0));
                    }
                } catch (error) {
                    const status = document.getElementById('job-status-text');
                    if (status) status.innerText = `${error.message || 'Connection interrupted while checking restore progress.'} Retrying…`;
                } finally { inFlight = false; }
            };
            restoreStatusPollInterval = setInterval(poll, 800);
            poll();
        }

        function openMissingLogsModal(page = 1) {
            missingLogsPage = Math.max(1, Number(page) || 1);
            const modalToken = showManagedModal('missing-logs-modal', 'missing-logs-list', 'Loading unmatched-track logs…');
            const loadToken = ++missingLogsLoadToken;
            fetch(`/api/user/missing-logs?page=${missingLogsPage}&limit=50`)
                .then(async response => {
                    const data = await response.json();
                    if (!response.ok || !data.success) throw new Error(data.message || 'Could not load unmatched-track logs.');
                    return data;
                })
                .then(data => {
                    if (loadToken !== missingLogsLoadToken || !isManagedModalCurrent('missing-logs-modal', modalToken)) return;
                    const container = document.getElementById('missing-logs-list');
                    const logs = Array.isArray(data.logs) ? data.logs : [];
                    missingLogsCurrentItems = logs;
                    missingLogsCount = Number(data.count) || 0;
                    missingLogsPages = Number(data.pages) || 1;
                    missingLogsPage = Number(data.page) || 1;
                    container.innerHTML = '';
                    if (logs.length === 0) {
                        container.innerHTML = `<div class="text-[#7a7d90] text-center p-4">No unmatched logs recorded.</div>`;
                    } else {
                        logs.forEach(log => {
                            const row = document.createElement('div');
                            row.id = `missing-log-row-${Number(log.id)}`;
                            row.className = 'bg-[#000000] p-3 rounded border border-[#2a2e43] space-y-2';
                            const suggestions = Array.isArray(log.suggestions) ? log.suggestions : [];
                            const defaultChoice = suggestions.length ? Number(suggestions[0].track_id) : 0;
                            const savedChoice = Number(missingLogChoices.get(Number(log.id)) || defaultChoice);
                            const hasChoice = suggestions.some(item => Number(item.track_id) === savedChoice);
                            if (hasChoice) missingLogChoices.set(Number(log.id), savedChoice);
                            const selectedTrackId = hasChoice ? savedChoice : defaultChoice;
                            const checked = missingLogSelections.has(Number(log.id));
                            let choicesHtml = suggestions.length
                                ? `<select id="missing-log-choice-${Number(log.id)}" onchange="setMissingLogChoice(${Number(log.id)}, this.value)" class="min-w-0 flex-1 bg-[#000012] border border-[#2a2e43] rounded-lg p-2 text-[11px] text-[#d5d7e0] outline-none">${suggestions.map(suggestion => `<option value="${Number(suggestion.track_id)}" ${Number(suggestion.track_id) === selectedTrackId ? 'selected' : ''}>${escapeHtml(suggestion.display)} (${Number(suggestion.confidence) || 0}% similarity)${suggestion.exact_metadata_match ? ' · Exact metadata match' : ''}${suggestion.in_library ? ' · Already in library' : ''}</option>`).join('')}</select>`
                                : `<div class="text-[11px] text-[#7a7d90]">No suggested catalog matches. Run a scan after adding the audio file, or clear this log.</div>`;
                            const libraryMatchNote = suggestions.some(item => item.in_library)
                                ? `<div class="text-[10px] text-[#00BBFC] pl-6">At least one suggestion is already assigned to your library. A confidence score is only a suggestion; confirm the artist/title before linking or clearing the log.</div>`
                                : `<div class="text-[10px] text-[#7a7d90] pl-6">Similarity is based on matching words, not proof of the same recording. Review remixes, live versions, and alternate releases before linking.</div>`;
                            row.innerHTML = `
                                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2">
                                    <div class="flex items-start gap-2 min-w-0">
                                        <input type="checkbox" ${checked ? 'checked' : ''} onchange="toggleMissingLogSelection(${Number(log.id)}, this.checked)" class="mt-1 accent-[#2B66FD] disabled:opacity-30" aria-label="Select unmatched log ${Number(log.id)} for batch linking">
                                        <div class="min-w-0"><div class="font-medium text-[#ffffff] break-words">${escapeHtml(log.query)}</div><div class="text-[10px] text-[#7a7d90] mt-1">Source: ${escapeHtml(log.source || 'Unknown')} · ${escapeHtml(log.timestamp || '')}</div></div>
                                    </div>
                                    <div class="shrink-0 flex gap-1.5">
                                        <button onclick="skipMissingLog(${Number(log.id)}, Number(document.getElementById('missing-log-choice-${Number(log.id)}')?.value || 0))" class="px-3 py-1.5 rounded-lg bg-[#4C2B83] hover:bg-[#643B97] text-white text-[10px] font-semibold">Skip</button>
                                        <button onclick="clearMissingLog(${Number(log.id)})" class="px-3 py-1.5 rounded-lg bg-[#330816] hover:bg-[#66112c] text-[#ff80a8] text-[10px] font-semibold">Clear Log</button>
                                    </div>
                                </div>
                                ${suggestions.length ? `<div class="flex flex-col sm:flex-row gap-2 pl-6">${choicesHtml}<button onclick="resolveMissingLog(${Number(log.id)}, Number(document.getElementById('missing-log-choice-${Number(log.id)}').value))" class="px-3 py-2 rounded-lg bg-[#003B63] hover:bg-[#0092FC] text-[#00BBFC] text-[10px] font-semibold whitespace-nowrap">Link This Track</button></div>${libraryMatchNote}` : choicesHtml}
                            `;
                            container.appendChild(row);
                        });
                    }
                    const pageInfo = document.getElementById('missing-logs-page-info');
                    if (pageInfo) pageInfo.innerText = `${missingLogsCount.toLocaleString()} unmatched logs · Page ${missingLogsPage} of ${missingLogsPages}`;
                    document.getElementById('missing-logs-prev').disabled = missingLogsPage <= 1;
                    document.getElementById('missing-logs-next').disabled = missingLogsPage >= missingLogsPages;
                    updateMissingLogSelectionUI();
                })
                .catch(error => {
                    if (!isManagedModalCurrent('missing-logs-modal', modalToken)) return;
                    document.getElementById('missing-logs-list').innerHTML = `<div class="text-xs text-[#ff80a8] p-4">${escapeHtml(error.message || 'Could not load unmatched-track logs.')}</div>`;
                });
        }

        function changeMissingLogsPage(delta) {
            const nextPage = Math.max(1, Math.min(missingLogsPages, missingLogsPage + Number(delta || 0)));
            if (nextPage !== missingLogsPage) openMissingLogsModal(nextPage);
        }

        function updateMissingLogSelectionUI() {
            const summary = document.getElementById('missing-logs-selection-count');
            const button = document.getElementById('missing-logs-link-selected');
            const skipButton = document.getElementById('missing-logs-skip-selected');
            const visible = document.getElementById('missing-logs-select-visible');
            const selectedCount = missingLogSelections.size;
            const linkableCount = [...missingLogSelections.values()].filter(trackId => Number(trackId) > 0).length;
            if (summary) summary.innerText = `${selectedCount} selected across pages`;
            if (button) button.disabled = linkableCount === 0;
            if (skipButton) skipButton.disabled = selectedCount === 0;
            if (visible) {
                const selectable = missingLogsCurrentItems;
                const selectedVisible = selectable.filter(item => missingLogSelections.has(Number(item.id))).length;
                visible.checked = selectable.length > 0 && selectedVisible === selectable.length;
                visible.indeterminate = selectedVisible > 0 && selectedVisible < selectable.length;
                visible.disabled = selectable.length === 0;
            }
        }

        function setMissingLogChoice(logId, trackId) {
            const id = Number(logId);
            const tid = Number(trackId);
            if (tid > 0) missingLogChoices.set(id, tid);
            else missingLogChoices.delete(id);
            if (missingLogSelections.has(id)) missingLogSelections.set(id, tid > 0 ? tid : 0);
            updateMissingLogSelectionUI();
        }

        function toggleMissingLogSelection(logId, checked) {
            const id = Number(logId);
            if (!checked) missingLogSelections.delete(id);
            else {
                const selected = Number(missingLogChoices.get(id) || document.getElementById(`missing-log-choice-${id}`)?.value || 0);
                missingLogSelections.set(id, selected > 0 ? selected : 0);
            }
            updateMissingLogSelectionUI();
        }

        function toggleMissingLogsVisibleSelection(checked) {
            for (const item of missingLogsCurrentItems) {
                const id = Number(item.id);
                const suggestions = Array.isArray(item.suggestions) ? item.suggestions : [];
                if (checked) {
                    const currentChoice = Number(missingLogChoices.get(id) || 0);
                    const defaultChoice = suggestions.length ? Number(suggestions[0].track_id) : 0;
                    const choice = currentChoice || defaultChoice;
                    if (choice > 0) missingLogChoices.set(id, choice);
                    missingLogSelections.set(id, choice);
                } else {
                    missingLogSelections.delete(id);
                }
            }
            document.querySelectorAll('#missing-logs-list input[type="checkbox"]').forEach(input => { input.checked = !!checked; });
            updateMissingLogSelectionUI();
        }

        function closeMissingLogsModal() { missingLogsLoadToken++; closeManagedModal('missing-logs-modal'); }

        function removeMissingLogRowFromView(logId) {
            const id = Number(logId);
            const row = document.getElementById(`missing-log-row-${id}`);
            if (row) row.remove();
            missingLogsCurrentItems = missingLogsCurrentItems.filter(item => Number(item.id) !== id);
            missingLogSelections.delete(id);
            missingLogChoices.delete(id);
            missingLogsCount = Math.max(0, missingLogsCount - 1);
            if (missingLogsCurrentItems.length === 0 && missingLogsPage > 1) {
                openMissingLogsModal(missingLogsPage - 1);
                return;
            }
            const pageInfo = document.getElementById('missing-logs-page-info');
            if (pageInfo) pageInfo.innerText = `${missingLogsCount.toLocaleString()} unmatched logs · Page ${missingLogsPage} of ${Math.max(1, Math.ceil(missingLogsCount / 50))}`;
            updateMissingLogSelectionUI();
        }

        async function skipMissingLog(logId, trackId = 0) {
            const id = Number(logId);
            const tid = Number(trackId) || 0;
            try {
                const response = await fetch(`/api/user/missing-logs/${id}/skip`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ track_id: tid })
                });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not skip this unmatched log.');
                removeMissingLogRowFromView(id);
                showAlert('Unmatched Logs', result.message || 'Unmatched log skipped and saved to history.', true);
            } catch (error) { showAlert('Unmatched Logs', error.message || 'Could not skip this log.', false); }
        }

        async function runSelectedMissingLogSkips() {
            const items = [...missingLogSelections.entries()].map(([log_id, track_id]) => ({ log_id: Number(log_id), track_id: Number(track_id) || 0 }))
                .filter(item => item.log_id > 0);
            if (!items.length) {
                showAlert('Unmatched Logs', 'Select one or more logs to skip.', false);
                return;
            }
            if (!(await showConfirm('Skip Selected Logs', `Remove ${items.length} selected unmatched entr${items.length === 1 ? 'y' : 'ies'} from the active list and keep them in history?`, 'Skip Selected'))) return;
            showSecondaryProgressPanel({ status: 'running', progress: 0, total: items.length, message: `Starting skip for ${items.length} selected unmatched log(s)...` }, 'missing-logs-bulk', 'Open Unmatched Logs', () => openMissingLogsModal(missingLogsPage));
            closeMissingLogsModal();
            try {
                const response = await fetch('/api/user/missing-logs/skip/bulk', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items })
                });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not start the unmatched-log skip batch.');
                for (const item of items) {
                    missingLogSelections.delete(item.log_id);
                    missingLogChoices.delete(item.log_id);
                }
                pollMissingLogJobStatus();
            } catch (error) {
                activeProgressJobType = null;
                document.getElementById('job-progress-container').classList.add('hidden');
                document.getElementById('job-action-container').classList.add('hidden');
                openMissingLogsModal(missingLogsPage);
                showAlert('Unmatched Logs', error.message || 'Could not start the skip batch.', false);
            }
        }

        async function openMissingLogsHistoryModal() {
            const token = showManagedModal('missing-logs-history-modal', 'missing-logs-history-list', 'Loading unmatched-log history…');
            try {
                const response = await fetch('/api/user/missing-logs/history?limit=200', { cache: 'no-store' });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not load unmatched-log history.');
                if (!isManagedModalCurrent('missing-logs-history-modal', token)) return;
                const container = document.getElementById('missing-logs-history-list');
                const entries = Array.isArray(result.entries) ? result.entries : [];
                if (!entries.length) {
                    container.innerHTML = '<div class="text-[#7a7d90] text-center p-4">No unmatched logs have been linked or skipped yet.</div>';
                    return;
                }
                container.innerHTML = entries.map(entry => {
                    const action = entry.action === 'linked' ? 'Linked' : entry.action === 'skipped' ? 'Skipped' : escapeHtml(entry.action || 'Action');
                    const trackText = entry.track_title ? `${escapeHtml(entry.track_artist || 'Unknown Artist')} - ${escapeHtml(entry.track_title)}` : 'No candidate selected';
                    const undone = !!entry.undone_at;
                    const canUndo = !undone && (entry.action === 'linked' || entry.action === 'skipped');
                    return `<div class="bg-[#000000] border border-[#2a2e43] rounded-lg p-3 flex flex-col sm:flex-row justify-between gap-3">
                        <div class="min-w-0 space-y-1">
                            <div class="font-semibold text-[#ffffff] break-words">${escapeHtml(entry.query || '')}</div>
                            <div class="text-[10px] text-[#00BBFC]">${action}${entry.already_assigned ? ' · Track was already in library' : ''} · ${escapeHtml(entry.created_at || '')}</div>
                            <div class="text-[10px] text-[#b4b7c5] break-words">${trackText}</div>
                            ${entry.details ? `<div class="text-[10px] text-[#7a7d90]">${escapeHtml(entry.details)}</div>` : ''}
                            ${undone ? `<div class="text-[10px] text-[#A05AFA]">Reversed ${escapeHtml(entry.undone_at)}</div>` : ''}
                        </div>
                        <div class="shrink-0 flex items-start">
                            ${canUndo ? `<button onclick="undoMissingLogHistory(${Number(entry.id)})" class="px-3 py-2 rounded-lg bg-[#4C2B83] hover:bg-[#643B97] text-white text-[10px] font-semibold">Undo</button>` : '<span class="text-[10px] text-[#7a7d90]">No action</span>'}
                        </div>
                    </div>`;
                }).join('');
            } catch (error) {
                const container = document.getElementById('missing-logs-history-list');
                if (container) container.innerHTML = `<div class="text-[#ff80a8] p-4">${escapeHtml(error.message || 'Could not load unmatched-log history.')}</div>`;
            }
        }

        function closeMissingLogsHistoryModal() { closeManagedModal('missing-logs-history-modal'); }

        async function undoMissingLogHistory(historyId) {
            if (!(await showConfirm('Undo Unmatched Log Action', 'Return this query to Unmatched Logs? If the action added a track that was not previously assigned, MILO will also remove that new library assignment.', 'Undo Action'))) return;
            try {
                const response = await fetch(`/api/user/missing-logs/history/${Number(historyId)}/undo`, { method: 'POST' });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not undo this history entry.');
                loadCatalog();
                showAlert('Unmatched Log History', result.message || 'Action reversed.', true);
                openMissingLogsHistoryModal();
            } catch (error) { showAlert('Unmatched Log History', error.message || 'Could not undo this history entry.', false); }
        }

        async function clearMissingLog(logId) {
            try {
                const response = await fetch(`/api/user/missing-logs/${Number(logId)}`, { method: 'DELETE' });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not clear this log.');
                removeMissingLogRowFromView(logId);
            } catch (error) { showAlert('Unmatched Logs', error.message || 'Could not contact the unmatched-log endpoint.', false); }
        }

        async function clearAllMissingLogs() {
            if (!(await showConfirm('Clear Unmatched Logs', 'Clear all unmatched track logs for your account?', 'Clear Logs'))) return;
            try {
                const response = await fetch('/api/user/missing-logs/all', { method: 'DELETE' });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not clear unmatched logs.');
                missingLogSelections.clear();
                missingLogChoices.clear();
                openMissingLogsModal(1);
            } catch (error) { showAlert('Unmatched Logs', error.message || 'Could not clear unmatched logs.', false); }
        }

        async function resolveMissingLog(logId, trackId) {
            const id = Number(logId);
            const tid = Number(trackId);
            if (!id || !tid) {
                showAlert('Unmatched Logs', 'Choose a suggested catalog match first.', false);
                return;
            }
            return startMissingLogResolutionBatch([{ log_id: id, track_id: tid }]);
        }

        async function runSelectedMissingLogResolutions() {
            const items = [...missingLogSelections.entries()].map(([log_id, track_id]) => ({ log_id: Number(log_id), track_id: Number(track_id) }))
                .filter(item => item.log_id > 0 && item.track_id > 0);
            if (!items.length) {
                showAlert('Unmatched Logs', 'Select one or more logs and choose a suggested track for each.', false);
                return;
            }
            if (!(await showConfirm('Link Selected Tracks', `Link ${items.length} selected unmatched entr${items.length === 1 ? 'y' : 'ies'} to your library and remove those logs?`, 'Link Selected'))) return;
            return startMissingLogResolutionBatch(items);
        }

        async function startMissingLogResolutionBatch(items) {
            showSecondaryProgressPanel({ status: 'running', progress: 0, total: items.length, message: `Starting unmatched-log batch (${items.length} choice${items.length === 1 ? '' : 's'})...` }, 'missing-logs-bulk', 'Open Unmatched Logs', () => openMissingLogsModal(missingLogsPage));
            closeMissingLogsModal();
            try {
                const response = await fetch('/api/user/missing-logs/resolve/bulk', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items })
                });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not start the unmatched-log batch.');
                for (const item of items) {
                    missingLogSelections.delete(Number(item.log_id));
                    missingLogChoices.delete(Number(item.log_id));
                }
                updateMissingLogSelectionUI();
                pollMissingLogJobStatus();
            } catch (error) {
                activeProgressJobType = null;
                document.getElementById('job-progress-container').classList.add('hidden');
                document.getElementById('job-action-container').classList.add('hidden');
                openMissingLogsModal(missingLogsPage);
                showAlert('Unmatched Logs', error.message || 'Could not start the unmatched-log batch.', false);
            }
        }

        async function pollMissingLogJobStatus(suppressCompletionAlert = false) {
            if (missingLogStatusPollInterval) clearInterval(missingLogStatusPollInterval);
            let inFlight = false;
            const poll = async () => {
                if (inFlight) return;
                inFlight = true;
                try {
                    const response = await fetch('/api/user/missing-logs/resolve/bulk/status');
                    const job = await response.json();
                    if (!response.ok) throw new Error(job.message || 'Could not read unmatched-log progress.');
                    showSecondaryProgressPanel(job, 'missing-logs-bulk', 'Open Unmatched Logs', () => openMissingLogsModal(missingLogsPage));
                    if (job.status === 'completed' || job.status === 'error') {
                        clearInterval(missingLogStatusPollInterval);
                        missingLogStatusPollInterval = null;
                        loadCatalog();
                        const result = job.result || {};
                        const details = Array.isArray(result.errors) ? result.errors.slice(0, 5).map(item => `Log ${item.log_id}: ${item.message}`).join('\n') : '';
                        if (!suppressCompletionAlert) showAlert('Unmatched Logs', `${job.message}${details ? '\n' + details : ''}`, job.status === 'completed' && !(Number(result.failed) > 0));
                    }
                } catch (error) {
                    document.getElementById('job-status-text').innerText = `${error.message || 'Connection interrupted while checking progress.'} Retrying…`;
                } finally {
                    inFlight = false;
                }
            };
            missingLogStatusPollInterval = setInterval(poll, 800);
            poll();
        }

        window.addEventListener('resize', positionJobQueuePanel, { passive: true });
        window.addEventListener('scroll', positionJobQueuePanel, { passive: true });

        function toggleAdminConsoleMobile() {
            const container = document.getElementById('admin-console-container');
            const chevron = document.getElementById('admin-console-chevron');
            if (!container || !chevron) return;
            container.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        }

        function toggleSyncActionsMobile() {
            const container = document.getElementById('sync-actions-container');
            const chevron = document.getElementById('sync-actions-chevron');
            container.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        }

        function toggleFiltersMobile() {
            const container = document.getElementById('filters-container');
            const chevron = document.getElementById('filters-chevron');
            if (!container || !chevron) return;
            container.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        }

        async function resumeProgressAfterRefresh() {
            try {
                const response = await fetch('/api/progress/current', { cache: 'no-store' });
                if (!response.ok) return;
                const job = await response.json();
                if (!job || !job.jobType || job.status === 'idle') return;
                switch (job.jobType) {
                    case 'import':
                        currentSyncContext = job.context === 'auto' ? 'auto' : 'manual';
                        activeJobData = job;
                        activeProgressQueueId = job.queueId || null;
                        pollJobStatus(false, true);
                        break;
                    case 'scan':
                        if (job.scheduled) break;
                        activeProgressQueueId = job.queueId || null;
                        pollScanStatus(true, job.queueId || null);
                        break;
                    case 'organizer':
                    case 'bulk-review':
                        pollOrganizerStatus(true);
                        break;
                    case 'dead-files-bulk':
                        pollDeadFileJobStatus(true);
                        break;
                    case 'missing-logs-bulk':
                        pollMissingLogJobStatus(true);
                        break;
                    case 'restore-tracks-bulk':
                        pollRestoreTracksJobStatus(true);
                        break;
                    case 'library-path':
                        pollLibraryPathJobStatus(true);
                        break;
                }
            } catch (_) {

            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            restoreCatalogPreferences();
            updateImportSourceUI();
            loadCatalog();
            refreshOrganizerReviewCount();
            refreshJobQueue();
            if (queueRefreshTimer) clearInterval(queueRefreshTimer);
            queueRefreshTimer = setInterval(refreshJobQueue, 2500);
            resumeProgressAfterRefresh();
            if (document.getElementById('organizer-review-count')) {
                setInterval(() => {
                    if (organizerStatusPollInterval || activeProgressJobType === 'import') return;
                    fetch('/api/admin/organizer/status').then(r => r.json()).then(data => {

                        if (data.status === 'running' && !data.nestedInScan) pollOrganizerStatus();
                    }).catch(() => {});
                }, 3000);
            }
        });
    </script>
<% } %>

<script>
(() => {
    const overlayId = 'live-offline-overlay';
    const HEALTH_CHECK_TIMEOUT_MS = 2500;
    const QUICK_RETRY_DELAY_MS = 1200;
    let connectionCheckInProgress = false;
    let consecutiveHealthCheckFailures = 0;
    let retryTimer = null;

    function showLiveOfflineOverlay(message) {
        const overlay = document.getElementById(overlayId);
        if (!overlay) return;

        overlay.classList.remove('hidden');
        overlay.classList.add('flex');

        const textEl = document.getElementById('live-status-text');
        const msgEl = document.getElementById('live-offline-msg');
        const dotEl = document.getElementById('live-status-dot');
        if (textEl && !connectionCheckInProgress) textEl.innerText = 'Disconnected from MILO';
        if (msgEl && message) msgEl.innerText = message;
        if (dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-[#ff80a8]';
    }

    function hideLiveOfflineOverlay() {
        const overlay = document.getElementById(overlayId);
        if (!overlay) return;
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
    }

    window.showLiveOfflineOverlay = showLiveOfflineOverlay;
    window.hideLiveOfflineOverlay = hideLiveOfflineOverlay;

    window.checkLiveConnection = async function checkLiveConnection() {
        if (connectionCheckInProgress) return;
        if (retryTimer) {
            window.clearTimeout(retryTimer);
            retryTimer = null;
        }

        const overlay = document.getElementById(overlayId);
        const overlayIsVisible = !!overlay && !overlay.classList.contains('hidden');
        const textEl = document.getElementById('live-status-text');
        const msgEl = document.getElementById('live-offline-msg');
        const dotEl = document.getElementById('live-status-dot');

        if (!navigator.onLine) {
            consecutiveHealthCheckFailures = 2;
            showLiveOfflineOverlay('Your device is offline. Reconnect to the network, then tap the logo to retry.');
            if (textEl) textEl.innerText = 'Device is offline';
            return;
        }

        connectionCheckInProgress = true;
        if (overlayIsVisible) {
            if (textEl) textEl.innerText = 'Checking connection...';
            if (msgEl) msgEl.innerText = 'MILO is checking whether the server is reachable.';
            if (dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-[#00BBFC] animate-ping';
        }

        const controller = new AbortController();
        const timeoutId = window.setTimeout(() => controller.abort(), HEALTH_CHECK_TIMEOUT_MS);
        let serverReachable = false;

        try {
            const response = await fetch('/assets/logo.png?milo-health=' + Date.now(), {
                method: 'HEAD',
                cache: 'no-store',
                signal: controller.signal,
                credentials: 'same-origin'
            });

            serverReachable = response.status < 500;
        } catch (_) {

        } finally {
            window.clearTimeout(timeoutId);
            connectionCheckInProgress = false;
        }

        if (serverReachable) {
            consecutiveHealthCheckFailures = 0;
            if (overlayIsVisible) {
                if (textEl) textEl.innerText = 'Reconnected! Reloading...';
                if (dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-[#2EA8FF]';
                window.location.reload();
            }
            return;
        }

        consecutiveHealthCheckFailures += 1;

        if (overlayIsVisible) {
            if (msgEl) msgEl.innerText = 'MILO cannot reach the server. Check your network and try again.';
            if (textEl) textEl.innerText = 'Still Offline';
            if (dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-[#ff80a8]';
            return;
        }

        if (consecutiveHealthCheckFailures < 5) {
            retryTimer = window.setTimeout(() => {
                retryTimer = null;
                window.checkLiveConnection();
            }, QUICK_RETRY_DELAY_MS);
            return;
        }

        showLiveOfflineOverlay('MILO cannot reach the server. Check your network and tap the logo above to retry.');
        if (textEl) textEl.innerText = 'Still Offline';
        if (dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-[#ff80a8]';
    };

    window.addEventListener('offline', () => {
        consecutiveHealthCheckFailures = 7;
        showLiveOfflineOverlay('Your device lost its network connection. Reconnect, then tap the logo to retry.');
        const textEl = document.getElementById('live-status-text');
        if (textEl) textEl.innerText = 'Device is offline';
    });

    window.addEventListener('online', () => {
        consecutiveHealthCheckFailures = 0;
        window.checkLiveConnection();
    });

    function initializeOfflineHandling() {
        if (!navigator.onLine) {
            consecutiveHealthCheckFailures = 5;
            showLiveOfflineOverlay('Your device is offline. Reconnect to the network, then tap the logo to retry.');
            const textEl = document.getElementById('live-status-text');
            if (textEl) textEl.innerText = 'Device is offline';
            return;
        }

        window.checkLiveConnection();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeOfflineHandling, { once: true });
    } else {
        initializeOfflineHandling();
    }

    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js')
            .then((registration) => {
                console.log('MILO Service Worker registered successfully:', registration.scope);
            })
            .catch((error) => {
                console.error('MILO Service Worker registration failed:', error);
            });
    }

    window.setInterval(() => {
        if (document.visibilityState === 'visible') window.checkLiveConnection();
    }, 40000);
})();
</script>

</body>
</html>
