            };

            fetch('/api/user/sync-settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(res => {
                closeSyncSettingsModal();
                showAlert(res.message);
            });
        }

        function openRemovedLogsModal() {
            fetch('/api/user/removed-logs')
                .then(r => r.json())
                .then(logs => {
                    const container = document.getElementById('removed-logs-list');
                    container.innerHTML = '';
                    if (logs.length === 0) {
                        container.innerHTML = `<div class="text-[#7a7d90] text-center p-4">No removed tracks recorded.</div>`;
                    } else {
                        logs.forEach(l => {
                            const d = document.createElement('label');
                            d.className = 'flex items-center gap-2 bg-[#000000] p-2.5 rounded border border-[#2a2e43]';
                            d.innerHTML = `<input type="checkbox" name="restore-track" value="${l.track_id}" class="accent-[#2B66FD]"> <span>${escapeHtml(l.artist)} - ${escapeHtml(l.title)}</span>`;
                            container.appendChild(d);
                        });
                    }
                    document.getElementById('removed-logs-modal').classList.remove('hidden');
                    document.getElementById('removed-logs-modal').classList.add('flex');
                });
        }

        function closeRemovedLogsModal() {
            document.getElementById('removed-logs-modal').classList.add('hidden');
            document.getElementById('removed-logs-modal').classList.remove('flex');
        }

        function restoreSelectedTracks() {
            const tids = Array.from(document.querySelectorAll('input[name="restore-track"]:checked')).map(cb => parseInt(cb.value));
            if (tids.length === 0) return;

            fetch('/api/user/removed-logs/restore', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ track_ids: tids })
            })
            .then(r => r.json())
            .then(res => {
                closeRemovedLogsModal();
                showAlert(res.message);
                loadCatalog();
            });
        }

        function openMissingLogsModal() {
            fetch('/api/user/missing-logs')
                .then(r => r.json())
                .then(logs => {
                    const container = document.getElementById('missing-logs-list');
                    container.innerHTML = '';
                    if (logs.length === 0) {
                        container.innerHTML = `<div class="text-[#7a7d90] text-center p-4">No unmatched logs recorded.</div>`;
                    } else {
                        logs.forEach(l => {
                            const d = document.createElement('div');
                            d.className = 'bg-[#000000] p-3 rounded border border-[#2a2e43] space-y-2';
                            let sugHtml = '';
                            if (l.suggestions && l.suggestions.length > 0) {
                                sugHtml = `<div class="mt-2 text-[10px] space-y-1">` + l.suggestions.map(s => `
                                    <div class="flex justify-between items-center bg-[#000012] p-1.5 rounded border border-[#1d202f]">
                                        <span>${escapeHtml(s.display)}</span>
                                        <button onclick="resolveMissingLog(${l.id}, ${s.track_id})" class="text-[#00BBFC] hover:underline">Link Track</button>
                                    </div>
                                `).join('') + `</div>`;
                            }
                            d.innerHTML = `<div class="font-medium text-[#ffffff]">${escapeHtml(l.query)}</div>${sugHtml}`;
                            container.appendChild(d);
                        });
                    }
                    document.getElementById('missing-logs-modal').classList.remove('hidden');
                    document.getElementById('missing-logs-modal').classList.add('flex');
                });
        }

        function closeMissingLogsModal() {
            document.getElementById('missing-logs-modal').classList.add('hidden');
            document.getElementById('missing-logs-modal').classList.remove('flex');
        }

        function clearAllMissingLogs() {
            fetch('/api/user/missing-logs/all', { method: 'DELETE' })
                .then(r => r.json())
                .then(() => openMissingLogsModal());
        }

        function resolveMissingLog(logId, trackId) {
            fetch('/api/user/missing-logs/resolve', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ log_id: logId, track_id: trackId })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    openMissingLogsModal();
                    loadCatalog();
                }
            });
        }

        function toggleAdminConsoleMobile() {
            const container = document.getElementById('admin-console-container');
            const chevron = document.getElementById('admin-console-chevron');
            container.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        }

        function toggleSyncActionsMobile() {
            const container = document.getElementById('sync-actions-container');
            const chevron = document.getElementById('sync-actions-chevron');
            container.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        }

        function toggleFiltersMobile() {
            const container = document.getElementById('filters-container');
            const chevron = document.getElementById('filters-chevron');
            container.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadCatalog();
            setInterval(checkLiveConnection, 15000);
        });
    </script>
<% } %>

</body>
</html>
