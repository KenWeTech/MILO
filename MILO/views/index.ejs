        function closeSyncSettingsModal() { closeManagedModal('sync-settings-modal'); }

        function saveSyncSettings() {
            const payload = {
                provider: document.getElementById('ss-provider').value,
                url: document.getElementById('ss-url').value,
                auto_sync: document.getElementById('ss-auto-sync').checked,
                one_for_one: document.getElementById('ss-one-for-one').checked,
                sync_interval: document.getElementById('ss-interval').value,
                spotify_client_id: document.getElementById('ss-spotify-id').value,
                spotify_client_secret: document.getElementById('ss-spotify-secret').value,
                apple_dev_token: document.getElementById('ss-apple-token').value
            };

            fetch('/api/user/sync-settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(async response => {
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || 'Could not save sync settings.');
                closeSyncSettingsModal();
                showAlert('Settings Saved', data.message || 'Sync settings saved.', true);
            })
            .catch(error => showAlert('Settings Not Saved', error.message, false));
