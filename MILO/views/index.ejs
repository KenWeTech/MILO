<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MILO - Music Index & Library Organizer</title>

    <meta name="theme-color" content="#000012">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="MILO">
    <link rel="apple-touch-icon" href="/assets/logo.png">
    <link rel="manifest" href="/manifest.json">

    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #216281; }
        ::-webkit-scrollbar-thumb { background: #00BBFC; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #A05AFA; }
        @keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.05); opacity: 0.4; }
            100% { transform: scale(0.95); opacity: 0.8; }
        }
        .pulse-glow { animation: pulse-ring 2.5s infinite ease-in-out; }
    </style>
</head>

<body class="bg-[#000000] text-[#f1f2f6] min-h-screen flex flex-col font-sans antialiased">

    <div id="live-offline-overlay" class="fixed inset-0 z-[150] bg-[#000000] hidden flex-col items-center justify-center p-4">
        <div class="bg-[#000012] border border-[#216281] p-8 rounded-2xl shadow-2xl w-full max-w-md text-center flex flex-col items-center">
            <button onclick="checkLiveConnection()" class="group focus:outline-none relative flex flex-col items-center transition-transform active:scale-95 mb-4" title="Click to reconnect">
                <img src="/assets/logo.png" alt="MILO Logo" class="w-48 h-48 object-contain pulse-glow group-hover:brightness-125 transition-all">
                <span class="text-xs font-semibold text-[#00BBFC] tracking-wider uppercase mt-2 group-hover:underline flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    Tap Logo to Reconnect
                </span>
            </button>
            <h2 class="text-xl font-bold text-[#ffffff] mb-2">You are Offline</h2>
            <p id="live-offline-msg" class="text-sm text-[#b4b7c5] max-w-xs leading-relaxed mb-6">
                MILO cannot connect to the server right now. Check your network or tap the logo above to refresh.
            </p>
            <div class="w-full bg-[#000000] border border-[#2a2e43] py-2.5 px-4 rounded-lg flex items-center justify-center gap-2 text-xs text-[#7a7d90]">
                <span id="live-status-dot" class="w-2 h-2 rounded-full bg-[#ff80a8]"></span>
                <span id="live-status-text">Disconnected from MILO</span>
            </div>
        </div>
    </div>

<% if (mode === 'login') { %>

    <div class="flex-1 flex items-center justify-center p-4">
        <div class="bg-[#000012] p-8 rounded-2xl shadow-2xl w-full max-w-md border border-[#216281]">
            <div class="text-center mb-4 flex flex-col items-center">
                <div>
                    <img src="/assets/logo.png" alt="MILO" class="w-30 h-30 object-contain -my-24">
                </div>
            </div>

            <h2 class="text-xl font-semibold mb-6 text-[#f1f2f6] text-center" id="random-phrase"></h2>

            <% if (messages && messages.length > 0) { %>
                <div class="bg-[#330816]/50 border border-[#66112c] text-[#ff80a8] p-3 rounded-lg mb-6 text-sm text-center">
                    <%= messages[0] %>
                </div>
            <% } %>

            <form method="POST" class="space-y-5">
                <div>
                    <input type="text" name="username" placeholder="Username" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] focus:ring-1 focus:ring-[#2B66FD] rounded-lg p-3.5 text-[#ffffff] transition-colors outline-none" required>
                </div>
                <div>
                    <input type="password" name="password" placeholder="Password" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] focus:ring-1 focus:ring-[#2B66FD] rounded-lg p-3.5 text-[#ffffff] transition-colors outline-none" required>
                </div>
                <button type="submit" class="w-full bg-[#2C53CA] hover:bg-[#2B66FD] text-[#ffffff] py-3.5 rounded-lg font-semibold shadow-lg shadow-[#004475]/20 transition-all active:scale-[0.98]">
                    Sign In
                </button>
            </form>
        </div>
    </div>

    <script src="/js/login-phrase.js" defer></script>

<% } else { %>

    <header class="bg-[#000012] border-b border-[#216281] sticky top-0 z-40">
        <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row justify-between items-center gap-4 relative">
            <div class="flex items-center">
                <a href="/" class="flex items-center group">
                    <img src="/assets/logo.png" alt="MILO" class="w-[220px] h-[220px] object-fill block -my-20">
                </a>
            </div>
            <div class="flex flex-wrap justify-center sm:justify-end items-center gap-2 sm:gap-4 sm:static absolute top-4 right-4">
                <a href="/logout" class="text-xs sm:text-sm font-medium text-[#b4b7c5] hover:text-[#ffffff] bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] px-3 py-2 rounded-lg transition-colors">
                    <svg class="w-4 h-4 sm:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1"/>
                    </svg>
                    <span class="hidden sm:inline">Logout</span>
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6 space-y-6">
        <% if (current_user.role === 'admin') { %>
        <div class="bg-[#3F3182]/20 border border-[#5B47CA]/50 rounded-xl p-4 sm:p-5 flex flex-col md:flex-row gap-4 justify-between items-start md:items-center">
            <button onclick="toggleAdminConsoleMobile()" class="sm:hidden w-full flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full bg-[#6E57FD] shadow-[0_0_8px_rgba(0,146,252,0.8)]"></div>
                    <span class="text-[#6E57FD] font-semibold text-sm tracking-wide uppercase">Admin Console</span>
                </div>
                <svg id="admin-console-chevron" class="w-4 h-4 text-[#6E57FD] transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>

            <div class="hidden sm:flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-[#6E57FD] shadow-[0_0_8px_rgba(0,146,252,0.8)]"></div>
                <span class="text-[#6E57FD] font-semibold text-sm tracking-wide uppercase">Admin Console</span>
            </div>

            <div id="admin-console-container" class="hidden flex flex-col gap-3 sm:flex sm:flex-row w-full md:w-auto">
                <button onclick="openOrganizerReviewModal()" class="w-full sm:w-auto bg-[#1A76C9] hover:bg-[#0092FC] border border-[#0092FC] px-4 py-2.5 rounded-lg text-sm font-medium text-[#ffffff] transition-colors flex items-center justify-center gap-2">
                    Organizer Review <span id="organizer-review-count" class="min-w-5 text-center bg-[#000000]/40 rounded-full px-1.5 py-0.5 text-[10px]">0</span>
                </button>
                <button onclick="startManualScan()" class="w-full sm:w-auto bg-[#2C53CA] hover:bg-[#2B66FD] px-4 py-2.5 rounded-lg text-sm font-medium text-[#ffffff] transition-colors">
                    Manual Scan
                </button>
                <button onclick="openUserManager()" class="w-full sm:w-auto bg-[#5B47CA] hover:bg-[#6E57FD] px-4 py-2.5 rounded-lg text-sm font-medium text-[#ffffff] transition-colors">
                    Manage Users
                </button>
                <button onclick="openScanSettings()" class="w-full sm:w-auto bg-[#713CCC] hover:bg-[#8A48FF] border border-[#8A48FF] px-4 py-2.5 rounded-lg text-sm font-medium text-[#ffffff] transition-colors">
                    Scan Settings
                </button>
                <button onclick="openDeadFilesModal()" class="w-full sm:w-auto bg-[#814AC8] hover:bg-[#A05AFA] px-4 py-2.5 rounded-lg text-sm font-medium text-[#ffffff] transition-colors">
                    Dead Files
                </button>
            </div>
        </div>
        <% } %>

        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-[#000012]/80 border border-[#216281] p-4 rounded-xl shadow-sm">
            <div class="relative w-full sm:w-auto">
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" id="job-queue-indicator" onclick="toggleJobQueueDetails(event)" aria-controls="job-queue-panel" aria-expanded="false" title="View running and queued work" class="hidden inline-flex items-center gap-2 bg-[#000000] hover:bg-[#0b1420] border border-[#216281] px-2.5 py-1.5 rounded-full text-[11px] font-semibold text-[#d5d7e0] transition-colors">
                        <span id="job-queue-indicator-dot" class="w-2 h-2 rounded-full bg-[#00BBFC] shrink-0"></span>
                        <span id="job-queue-indicator-count" class="min-w-4 text-center text-[#00BBFC] tabular-nums">0</span>
                        <svg id="job-queue-indicator-chevron" class="w-3.5 h-3.5 text-[#7a7d90] transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"></path></svg>
                    </button>
                    <h2 class="text-lg font-bold text-[#ffffff]">Library: <span class="text-[#00BBFC]"><%= current_user.username %></span></h2>
                </div>
                <section id="job-queue-panel" class="hidden absolute left-0 top-full mt-2 z-50 w-[min(88vw,520px)] sm:w-[520px] max-w-[calc(100vw_-_2rem)] max-h-[65vh] overflow-y-auto bg-[#000012] border border-[#216281] rounded-xl p-4 shadow-2xl" aria-live="polite" aria-label="Work queue details">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-3">
                        <h3 class="text-sm font-bold text-[#00BBFC]">Work Queue</h3>
                        <span id="job-queue-summary" class="text-[11px] text-[#7a7d90]">Work runs one task at a time.</span>
                    </div>
                    <div id="job-queue-list" class="space-y-2"></div>
                </section>
            </div>
            <div class="flex items-center gap-4 w-full sm:w-auto justify-between sm:justify-end">
                <div class="bg-[#000000] border border-[#216281] px-4 py-2 rounded-lg text-center flex-1 sm:flex-none">
                    <span class="text-[#b4b7c5] block text-[10px] sm:text-xs font-semibold uppercase tracking-wider">Total Available</span>
                    <span id="stat-total" class="font-bold text-[#ffffff] text-base sm:text-lg">0</span>
                </div>
                <div class="bg-[#000000] border border-[#216281] px-4 py-2 rounded-lg text-center flex-1 sm:flex-none">
                    <span class="text-[#b4b7c5] block text-[10px] sm:text-xs font-semibold uppercase tracking-wider">Selected Tracks</span>
                    <span id="stat-library" class="font-bold text-[#00BBFC] text-base sm:text-lg">0</span>
                </div>
            </div>
        </div>

        <div class="border-b border-[#216281] pb-6">
            <button onclick="toggleSyncActionsMobile()" class="sm:hidden w-full flex justify-between items-center bg-[#000012] border border-[#216281] px-4 py-2.5 rounded-lg text-sm font-semibold text-[#00BBFC] transition-colors">
                <span>Sync & Import Controls</span>
                <svg id="sync-actions-chevron" class="w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div id="sync-actions-container" class="hidden flex flex-col sm:flex sm:flex-row gap-3 pt-3 sm:pt-0">
                <button onclick="autoSync()" class="flex-1 sm:flex-none bg-[#1A76C9] hover:bg-[#0092FC] border border-[#0092FC] text-[#E9DFFF] px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors">
                    Sync Playlist
                </button>
                <button onclick="openImportModal('manual')" class="flex-1 sm:flex-none bg-[#232F6B]/40 hover:bg-[#2B66FD]/50 border border-[#2B66FD]/50 px-5 py-2.5 rounded-lg text-sm font-semibold text-[#2B66FD] transition-colors">
                    Manual Import
                </button>
                <button onclick="openSyncSettings()" class="text-xs sm:text-sm font-medium text-[#5B47CA] hover:text-[#6E57FD] bg-[#241C40]/30 hover:bg-[#362A6B]/50 border border-[#362A6B]/50 px-3 py-2 rounded-lg transition-colors">
                    Sync Settings
                </button>
                <button onclick="openRemovedLogsModal()" class="text-xs sm:text-sm font-medium text-[#713CCC] hover:text-[#8A48FF] bg-[#291A41]/30 hover:bg-[#4C2B83]/50 border border-[#4C2B83]/50 px-3 py-2 rounded-lg transition-colors">
                    Restore Tracks
                </button>
                <button onclick="openMissingLogsModal()" class="text-xs sm:text-sm font-medium text-[#814AC8] hover:text-[#A05AFA] bg-[#2D1D40]/30 hover:bg-[#643B97]/50 border border-[#643B97]/50 px-3 py-2 rounded-lg transition-colors">
                    Unmatched Logs
                </button>
            </div>
        </div>

        <div id="job-progress-container" class="hidden w-full bg-[#000012] p-5 rounded-xl border border-[#216281] mb-6 shadow-xl">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center text-sm mb-4 gap-2">
                <span id="job-status-text" class="font-semibold text-[#00BBFC]">Initializing Sync...</span>
                <span id="job-progress-text" class="text-[#b4b7c5] font-mono bg-[#000000] px-2 py-1 rounded">0 / 0</span>
            </div>
            <div class="w-full bg-[#000000] rounded-full h-2.5 overflow-hidden border border-[#216281]">
                <div id="job-progress-bar" class="bg-[#2B66FD] h-full transition-all duration-300 ease-out shadow-[0_0_10px_rgba(0,146,252,0.5)]" style="width: 0%"></div>
            </div>
            <div id="job-action-container" class="hidden mt-5 flex flex-col sm:flex-row justify-end gap-3">
                <button onclick="clearJob()" class="w-full sm:w-auto px-5 py-2.5 bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] rounded-lg text-sm font-medium transition-colors">Dismiss</button>
                <button id="job-review-btn" onclick="reviewJobResults()" class="w-full sm:w-auto px-5 py-2.5 bg-[#2C53CA] hover:bg-[#2B66FD] rounded-lg text-sm font-semibold text-[#ffffff] shadow-lg shadow-[#005540]/20 transition-all active:scale-95">Review Results</button>
            </div>
        </div>

        <div class="bg-[#000012] border border-[#216281] rounded-xl p-4">
            <input type="text" id="search-input" onkeyup="handleSearchInput()" placeholder="Search artist, album, or title..." class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] focus:ring-1 focus:ring-[#2B66FD] rounded-lg p-2.5 text-sm text-[#ffffff] placeholder-[#7a7d90] outline-none transition-colors">

            <button onclick="toggleFiltersMobile()" class="sm:hidden w-full flex justify-between items-center mt-4 bg-[#000012] border-b border-[#216281] px-4 py-2.5 rounded-lg text-sm font-semibold text-[#00BBFC] transition-colors">
                <span>Filters & Sorting</span>
                <svg id="filters-chevron" class="w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>

            <div id="filters-container" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-4 sm:mt-4 sm:grid">
                <select id="library-filter" onchange="resetPageAndLoad()" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] focus:ring-1 focus:ring-[#2B66FD] rounded-lg p-2.5 text-sm text-[#f1f2f6] outline-none appearance-none">
                    <option value="all">Filter: All Tracks</option>
                    <option value="added">Filter: Added to Library</option>
                    <option value="unadded">Filter: Not Added</option>
                </select>
                <select id="sort-by" onchange="handleSortByChange()" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] focus:ring-1 focus:ring-[#2B66FD] rounded-lg p-2.5 text-sm text-[#f1f2f6] outline-none appearance-none">
                    <option value="artist">Sort by Artist</option>
                    <option value="title">Sort by Title</option>
                    <option value="album">Sort by Album</option>
                    <option value="added">Sort by Recently Added</option>
                </select>
                <select id="sort-order" onchange="resetPageAndLoad()" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] focus:ring-1 focus:ring-[#2B66FD] rounded-lg p-2.5 text-sm text-[#f1f2f6] outline-none appearance-none">
                    <option value="asc">Ascending Order</option>
                    <option value="desc">Descending Order</option>
                </select>
                <select id="page-limit" onchange="resetPageAndLoad()" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] focus:ring-1 focus:ring-[#2B66FD] rounded-lg p-2.5 text-sm text-[#f1f2f6] outline-none appearance-none">
                    <option value="25">25 per page</option>
                    <option value="50" selected>50 per page</option>
                    <option value="100">100 per page</option>
                    <option value="250">250 per page</option>
                    <option value="500">500 per page</option>
                    <option value="all">Show All</option>
                </select>
            </div>
        </div>

        <div class="bg-[#000012] border border-[#216281] rounded-xl overflow-hidden shadow-sm">
            <div class="w-full overflow-x-auto">
                <table class="w-full text-left text-sm text-[#d5d7e0]">
                    <thead class="bg-[#000000] border-b border-[#216281] text-[#b4b7c5] text-xs uppercase tracking-wider font-semibold">
                        <tr>
                            <th class="p-4 w-auto sm:w-1/3">Track</th>
                            <th class="p-4 w-1/4 hidden sm:table-cell">Artist</th>
                            <th class="p-4 w-1/4 hidden sm:table-cell">Album</th>
                            <th class="p-4 w-24 text-right pr-4 sm:pr-6">Action</th>
                        </tr>
                    </thead>
                    <tbody id="catalog-table" class="divide-y divide-[#1d202f]/50"></tbody>
                </table>
            </div>
        </div>

        <div id="pagination-controls" class="flex flex-col sm:flex-row justify-between items-center gap-4 bg-[#000012] border border-[#216281] rounded-xl p-4">
            <div id="pagination-info" class="text-xs sm:text-sm text-[#b4b7c5]">
                Showing <span id="page-start-count" class="font-semibold text-[#ffffff]">0</span> - <span id="page-end-count" class="font-semibold text-[#ffffff]">0</span> of <span id="page-total-count" class="font-semibold text-[#00BBFC]">0</span> tracks
            </div>
            <div class="flex items-center gap-2">
                <button id="btn-first-page" onclick="goToPage(1)" class="px-3 py-1.5 text-xs bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] text-[#d5d7e0] rounded-lg transition-colors disabled:opacity-40 disabled:cursor-not-allowed">First</button>
                <button id="btn-prev-page" onclick="changePage(-1)" class="px-3 py-1.5 text-xs bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] text-[#d5d7e0] rounded-lg transition-colors disabled:opacity-40 disabled:cursor-not-allowed">Prev</button>
                <span id="page-indicator" class="text-xs font-semibold px-2 text-[#ffffff]">Page 1 of 1</span>
                <button id="btn-next-page" onclick="changePage(1)" class="px-3 py-1.5 text-xs bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] text-[#d5d7e0] rounded-lg transition-colors disabled:opacity-40 disabled:cursor-not-allowed">Next</button>
                <button id="btn-last-page" onclick="goToPage(totalPages)" class="px-3 py-1.5 text-xs bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] text-[#d5d7e0] rounded-lg transition-colors disabled:opacity-40 disabled:cursor-not-allowed">Last</button>
            </div>
        </div>
    </main>

    <div id="system-alert-modal" class="fixed z-[100] inset-0 bg-[#000000]/80 backdrop-blur-sm items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[#000012] border border-[#2a2e43] rounded-2xl w-full max-w-sm shadow-2xl flex flex-col p-6 text-center transform transition-all">
            <div id="alert-icon-container" class="mx-auto flex items-center justify-center h-12 w-12 rounded-full mb-4 bg-[#330816]">

                <svg id="alert-icon-error" class="h-6 w-6 text-[#ff80a8] hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>

                <svg id="alert-icon-success" class="h-6 w-6 text-[#00BBFC] hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
            </div>
            <h3 id="alert-modal-title" class="text-lg font-bold text-[#00BBFC] mb-2">Notification</h3>
            <p id="alert-modal-msg" class="text-sm text-[#b4b7c5] mb-6">Message goes here.</p>

            <div id="alert-actions-error" class="hidden flex-col-reverse sm:flex-row justify-center gap-3 w-full">
                <button onclick="closeAppAlert()" class="w-full sm:w-auto px-5 py-2.5 bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] text-[#f1f2f6] rounded-lg text-sm font-medium transition-colors">Dismiss</button>
                <button onclick="forceRefreshCheck()" id="btn-force-refresh" class="w-full sm:w-auto px-5 py-2.5 bg-[#2C53CA] hover:bg-[#2B66FD] text-[#ffffff] rounded-lg text-sm font-semibold shadow-lg shadow-[#004475]/20 transition-all active:scale-95">Refresh</button>
            </div>

            <div id="alert-actions-success" class="hidden justify-center w-full">
                <button onclick="closeAppAlert()" class="w-full px-8 py-2.5 bg-[#2C53CA] hover:bg-[#2B66FD] text-[#ffffff] rounded-lg text-sm font-semibold shadow-lg shadow-[#004475]/20 transition-all active:scale-95">OK</button>
            </div>
        </div>
    </div>

    <div id="system-confirm-modal" class="fixed z-[110] inset-0 bg-[#000000]/80 backdrop-blur-sm items-center justify-center hidden p-4 sm:p-6" onclick="if(event.target===this)resolveAppConfirm(false)">
        <div class="bg-[#000012] border border-[#216281] rounded-2xl w-full max-w-md shadow-2xl p-6" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
            <div class="w-12 h-12 rounded-full bg-[#1A76C9]/20 border border-[#216281] flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-[#00BBFC]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
            </div>
            <h3 id="confirm-modal-title" class="text-lg font-bold text-[#00BBFC] text-center mb-2">Please Confirm</h3>
            <p id="confirm-modal-msg" class="text-sm text-[#b4b7c5] whitespace-pre-line text-center mb-6"></p>
            <div class="flex flex-col-reverse sm:flex-row gap-3 justify-center">
                <button onclick="resolveAppConfirm(false)" class="w-full sm:w-auto px-5 py-2.5 bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] text-[#f1f2f6] rounded-lg text-sm font-medium">Cancel</button>
                <button id="confirm-modal-accept" onclick="resolveAppConfirm(true)" class="w-full sm:w-auto px-5 py-2.5 bg-[#2C53CA] hover:bg-[#2B66FD] text-white rounded-lg text-sm font-semibold">Continue</button>
            </div>
        </div>
    </div>

    <div id="scan-settings-modal" class="fixed z-[90] inset-0 bg-[#000000]/80 backdrop-blur-sm items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[#000012] border border-[#216281] rounded-2xl w-full max-w-3xl shadow-2xl flex flex-col max-h-[90vh] overflow-hidden">
            <div class="p-5 border-b border-[#216281] flex justify-between items-center bg-[#000012]">
                <h3 class="text-lg font-bold text-[#8A48FF]">Scan Settings</h3>
                <button onclick="closeScanSettingsModal()" class="text-[#7a7d90] hover:text-[#ffffff] transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="p-6 overflow-y-auto space-y-6 text-sm">
                <div id="scan-settings-loading" class="flex items-center gap-2 text-xs text-[#7a7d90] bg-[#000000] border border-[#2a2e43] rounded-lg px-3 py-2">
                    <span class="inline-block w-3.5 h-3.5 border-2 border-[#216281] border-t-[#00BBFC] rounded-full animate-spin"></span>
                    Loading current scan settings…
                </div>

                <div class="bg-[#000000] p-4 rounded-xl border border-[#2a2e43]">
                    <label for="sys-incremental-scan-interval" class="block text-xs font-semibold text-[#00BBFC] uppercase tracking-wider mb-1">Quick Scan Schedule</label>
                    <p class="text-xs text-[#7a7d90] mb-3">A faster pass checks pool paths, file sizes, and modification times. New or changed files are hashed and have their embedded metadata refreshed; matching dead catalog paths are then checked for recovery. Files whose contents changed while preserving both size and timestamp require a detailed full scan.</p>
                    <select id="sys-incremental-scan-interval" class="w-full bg-[#000012] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-[#ffffff] outline-none">
                        <option value="0">Manual only (scheduled scans disabled)</option>
                        <option value="30">Every 30 minutes</option>
                        <option value="60">Every hour</option>
                        <option value="120">Every 2 hours</option>
                        <option value="240">Every 4 hours</option>
                        <option value="360">Every 6 hours</option>
                        <option value="720">Every 12 hours</option>
                        <option value="1440">Daily</option>
                        <option value="4320">Every 3 days</option>
                        <option value="10080">Weekly</option>
                    </select>
                    <p class="text-[11px] text-[#7a7d90] mt-2">This schedule is separate from the detailed full scan. MILO runs only one maintenance job at a time; a due full scan takes priority, followed by this quick scan, then user sync jobs.</p>
                </div>

                <div class="bg-[#000000] p-4 rounded-xl border border-[#2a2e43]">
                    <label class="block text-xs font-semibold text-[#00BBFC] uppercase tracking-wider mb-1">Full Catalog &amp; Organizer Scan Schedule</label>
                    <p class="text-xs text-[#7a7d90] mb-3">A full scan hashes and reads the master pool, refreshes the catalog, processes staging folders, and reconciles moved/upgraded paths. Choose a conservative cadence; run a scan manually when needed.</p>
                    <select id="sys-rescan-interval" class="w-full bg-[#000012] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-[#ffffff] outline-none">
                        <option value="0">Manual only (scheduled scans disabled)</option>
                        <option value="360">Every 6 hours</option>
                        <option value="720">Every 12 hours</option>
                        <option value="1440">Daily</option>
                        <option value="4320">Every 3 days</option>
                        <option value="10080">Weekly</option>
                        <option value="43200">Every 30 days</option>
                    </select>
                    <p class="text-[11px] text-[#7a7d90] mt-2">The detailed scan hashes every pool file, refreshes metadata and identity records, processes organizer staging folders, and reconciles moved/upgraded paths. Use this when repairing a new installation or when the quick scan is not enough.</p>
                    <button id="btn-run-full-scan-now" onclick="startFullMasterScan()" disabled class="mt-3 w-full sm:w-auto bg-[#2C53CA] hover:bg-[#2B66FD] disabled:opacity-40 disabled:cursor-not-allowed px-4 py-2.5 rounded-lg text-xs font-semibold text-white transition-colors">Run Detailed Full Scan Now</button>
                    <p class="text-[11px] text-[#7a7d90] mt-2">Uses the currently saved settings. Save first if you edited the options above.</p>
                </div>
                <div class="bg-[#000000] p-4 rounded-xl border border-[#2a2e43]">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input id="sys-auto-approve-metadata" type="checkbox" class="mt-0.5 accent-[#2B66FD]">
                        <span>
                            <span class="block text-xs font-semibold text-[#00BBFC] uppercase tracking-wider">Metadata Auto-Approval During Scheduled Scans</span>
                            <span class="block text-xs text-[#7a7d90] mt-1">Automatically approve newly found “Metadata approval required” items during scheduled scans only when the candidate has a valid destination, no existing file occupies it, and no other pending review claims the same path. Anything uncertain remains in Organizer Review. Manual scans and previously pending items are not auto-approved.</span>
                        </span>
                    </label>
                </div>

                <div class="bg-[#000000] p-4 rounded-xl border border-[#2a2e43]">
                    <div class="flex justify-between items-center mb-1">
                        <label class="block text-xs font-semibold text-[#00BBFC] uppercase tracking-wider">Exempt Folders</label>
                    </div>
                    <p class="text-xs text-[#7a7d90] mb-3">Folders excluded from catalog indexing during master pool scans.</p>

                    <div id="exempt-folders-list" class="space-y-2 mb-3 max-h-40 overflow-y-auto"></div>

                    <div class="flex gap-2">
                        <input type="text" id="new-exempt-folder-input" placeholder="e.g. C:/Media/Music/Exempt" class="flex-1 bg-[#000012] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-xs text-[#ffffff] outline-none">
                        <button onclick="addExemptFolder()" class="bg-[#2C53CA] hover:bg-[#2B66FD] text-[#ffffff] px-4 py-2.5 rounded-lg text-xs font-semibold transition-colors">
                            Add Folder
                        </button>
                    </div>
                </div>

                <div class="bg-[#000000] p-4 rounded-xl border border-[#2a2e43]">
                    <div class="flex justify-between items-center mb-1">
                        <label class="block text-xs font-semibold text-[#00BBFC] uppercase tracking-wider">Dump Folders - Staging</label>
                    </div>
                    <p class="text-xs text-[#7a7d90] mb-3">Define one or multiple folders that contain files you want MILO to process and optionally tag them to a specific user for auto-assignment during organizer operations.</p>

                    <div id="dump-folders-list" class="space-y-2 mb-3 max-h-52 overflow-y-auto"></div>

                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2">
                        <input type="text" id="new-dump-folder-input" placeholder="e.g. C:/Media/Music/Imports or /media/music/imports" class="sm:col-span-7 bg-[#000012] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-xs text-[#ffffff] outline-none">
                        <select id="new-dump-folder-user-select" class="sm:col-span-3 bg-[#000012] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-xs text-[#f1f2f6] outline-none">
                            <option value="">Unassigned / Global</option>
                        </select>
                        <button onclick="addDumpFolder()" class="sm:col-span-2 bg-[#5B47CA] hover:bg-[#6E57FD] text-[#ffffff] px-3 py-2.5 rounded-lg text-xs font-semibold transition-colors">
                            Add Dump
                        </button>
                    </div>
                </div>

                <div class="bg-[#000000] p-4 rounded-xl border border-[#2a2e43]">
                    <label class="block text-xs font-semibold text-[#00BBFC] uppercase tracking-wider mb-1">Trash Folder - Duplicate Staging</label>
                    <p class="text-xs text-[#7a7d90] mb-3">MILO puts duplicates here for review when the organizer runs. The organizer can only permanently deletes files that are physically inside this folder when prompted.</p>
                    <input type="text" id="sys-trash-folder" placeholder="e.g. C:/Media/Music/TrashStaging" class="w-full bg-[#000012] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-xs text-[#ffffff] outline-none">
                </div>

                <div class="bg-[#000000] p-4 rounded-xl border border-[#2a2e43] space-y-3">
                    <div>
                        <label for="sys-organizer-script" class="block text-xs font-semibold text-[#00BBFC] uppercase tracking-wider mb-1">Organizer Naming Script</label>
                        <p class="text-xs text-[#7a7d90] mb-2">Use a Picard-style script to set folder and filename structure if you don't want to use the default. Supports tag fields and Picard-style $if2, $if, $left, $right, $num, $eq, $gt, $upper, $lower, $trim, and $replace functions.</p>
                        <textarea id="sys-organizer-script" rows="4" spellcheck="false" class="w-full bg-[#000012] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-3 text-xs text-[#ffffff] outline-none font-mono" placeholder="$if2(%albumartist%,%artist%)/%album%/$num(%tracknumber%,2) - %title%"></textarea>
                    </div>
                    <label class="flex items-start gap-2 text-xs text-[#d5d7e0]">
                        <input id="sys-organizer-rename" type="checkbox" class="mt-0.5 accent-[#2B66FD]">
                        <span><strong class="text-[#ffffff]">Rename audio files using the script.</strong> When unchecked, the script still determines the destination folders but the original filename is kept.</span>
                    </label>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-t border-[#2a2e43] pt-3">
                        <p class="text-[11px] text-[#7a7d90]">Files missing core embedded tags stay in the dump until an administrator approves them.</p>
                        <button id="btn-run-organizer-now" onclick="startOrganizerRun()" disabled class="shrink-0 bg-[#2C53CA] hover:bg-[#2B66FD] disabled:opacity-40 disabled:cursor-not-allowed px-4 py-2.5 rounded-lg text-xs font-semibold text-white transition-colors">Run Organizer Now</button>
                    </div>
                    <p class="text-[10px] text-[#7a7d90]">The manual run uses saved settings. Save settings first if you changed the script or rename option above.</p>
                </div>
            </div>

            <div class="p-4 border-t border-[#216281] flex justify-end gap-3 bg-[#000012]">
                <button onclick="closeScanSettingsModal()" class="px-4 py-2 bg-[#1d202f] hover:bg-[#2a2e43] rounded-lg text-xs font-semibold transition-colors">Cancel</button>
                <button id="btn-save-scan-settings" onclick="saveScanSettings()" disabled class="px-5 py-2 bg-[#713CCC] hover:bg-[#8A48FF] disabled:opacity-40 disabled:cursor-not-allowed rounded-lg text-xs font-semibold text-[#ffffff] transition-colors">Save Settings</button>
            </div>
        </div>
    </div>

    <!-- Organizer Review Modal -->
    <div id="organizer-review-modal" class="fixed z-[95] inset-0 bg-[#000000]/80 backdrop-blur-sm items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[#000012] border border-[#216281] rounded-2xl w-full max-w-6xl shadow-2xl flex flex-col max-h-[94vh] overflow-hidden">
            <div class="p-5 border-b border-[#216281] flex justify-between items-center bg-[#000012] gap-3">
                <div>
                    <h3 class="text-lg font-bold text-[#0092FC]">Organizer Review</h3>
                    <p class="text-xs text-[#7a7d90] mt-1">Filter pending items, compare candidate and pool metadata, and resolve a page or an entire filtered result set.</p>
                </div>
                <div class="flex gap-2 items-center shrink-0">
                    <button onclick="loadOrganizerReview(organizerReviewCurrentPage)" class="text-xs px-3 py-2 rounded-lg bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43]">Refresh</button>
                    <button onclick="closeOrganizerReviewModal()" class="text-[#7a7d90] hover:text-[#ffffff] transition-colors" aria-label="Close organizer review">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
            </div>

            <div class="p-4 border-b border-[#216281] space-y-3 bg-[#000000]/60">
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-2">
                    <input id="organizer-review-search" type="search" oninput="queueOrganizerReviewSearch()" onkeydown="if(event.key==='Enter'){event.preventDefault();organizerReviewFiltersChanged();}" placeholder="Search file path, metadata, reason..." class="sm:col-span-6 w-full bg-[#000012] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-xs text-[#ffffff] outline-none">
                    <select id="organizer-review-kind" onchange="organizerReviewFiltersChanged()" class="sm:col-span-4 w-full bg-[#000012] border border-[#2a2e43] rounded-lg p-2.5 text-xs text-[#f1f2f6] outline-none">
                        <option value="all">All review types</option>
                        <option value="duplicate">Exact duplicates</option>
                        <option value="path_conflict">Naming-path conflicts</option>
                        <option value="quality_upgrade">Higher-quality version available</option>
                        <option value="similar">Similar embedded metadata (different path)</option>
                        <option value="low_match">Possible matches (incomplete metadata)</option>
                        <option value="metadata">Metadata approval required</option>
                        <option value="error">Organizer errors</option>
                    </select>
                    <select id="organizer-review-location" onchange="organizerReviewFiltersChanged()" class="sm:col-span-2 w-full bg-[#000012] border border-[#2a2e43] rounded-lg p-2.5 text-xs text-[#f1f2f6] outline-none">
                        <option value="all">All locations</option>
                        <option value="outside_trash">Outside Trash</option>
                        <option value="trash">In Trash</option>
                    </select>
                </div>
                <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-3">
                    <div class="flex flex-wrap items-center gap-3 text-xs">
                        <label class="flex items-center gap-2 text-[#d5d7e0]"><input id="organizer-select-visible" type="checkbox" onchange="toggleOrganizerVisibleSelection(this.checked)" class="accent-[#2B66FD]"><span>Select visible page</span></label>
                        <button id="organizer-select-filtered" onclick="selectAllOrganizerFiltered()" class="px-3 py-2 rounded-lg bg-[#1A76C9]/30 hover:bg-[#1A76C9]/50 border border-[#216281] text-[#00BBFC]">Select all filtered results</button>
                        <button onclick="clearOrganizerSelection()" class="px-3 py-2 rounded-lg bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] text-[#b4b7c5]">Clear selection</button>
                        <span id="organizer-selection-summary" class="text-[#7a7d90]">0 selected</span>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-2">
                        <select id="organizer-review-limit" onchange="organizerReviewFiltersChanged()" class="w-full sm:w-auto bg-[#000012] border border-[#2a2e43] rounded-lg p-2.5 text-xs text-[#f1f2f6] outline-none">
                            <option value="25">25 / page</option>
                            <option value="50" selected>50 / page</option>
                            <option value="100">100 / page</option>
                        </select>
                        <select id="organizer-bulk-action" class="w-full sm:w-auto bg-[#000012] border border-[#2a2e43] rounded-lg p-2.5 text-xs text-[#f1f2f6] outline-none">
                            <option value="approve">Approve &amp; organize unmatched files</option>
                            <option value="keep_both">Keep both / organize separately</option>
                            <option value="overwrite">Overwrite matched pool song</option>
                            <option value="upgrade">Upgrade to higher-quality version</option>
                            <option value="stage_trash">Move candidate(s) to Trash</option>
                            <option value="delete">Permanently delete candidate(s) already in Trash</option>
                            <option value="keep_dump">Keep candidate(s) in Dump</option>
                        </select>
                        <button onclick="runOrganizerBulkAction()" class="px-4 py-2.5 rounded-lg bg-[#2C53CA] hover:bg-[#2B66FD] text-xs font-semibold text-white whitespace-nowrap">Process Selection</button>
                    </div>
                </div>
                <div id="organizer-review-result-count" class="text-[11px] text-[#7a7d90]">Loading pending review count...</div>
            </div>

            <div class="p-4 sm:p-5 overflow-y-auto flex-1 min-h-0 space-y-3" id="organizer-review-list">
                <div class="text-sm text-[#7a7d90]">Loading organizer review items...</div>
            </div>

            <div class="p-4 border-t border-[#216281] flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-[#000012]">
                <div id="organizer-review-page-info" class="text-xs text-[#b4b7c5]">Page 1 of 1</div>
                <div class="flex gap-2 justify-end">
                    <button id="organizer-review-prev" onclick="loadOrganizerReview(organizerReviewCurrentPage - 1)" class="px-4 py-2 bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] rounded-lg text-xs font-semibold disabled:opacity-40" disabled>Previous</button>
                    <button id="organizer-review-next" onclick="loadOrganizerReview(organizerReviewCurrentPage + 1)" class="px-4 py-2 bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] rounded-lg text-xs font-semibold disabled:opacity-40" disabled>Next</button>
                </div>
            </div>
        </div>
    </div>

    <!-- User Manager Modal -->
    <div id="user-manager-modal" class="fixed z-[90] inset-0 bg-[#000000]/80 backdrop-blur-sm items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[#000012] border border-[#216281] rounded-2xl w-full max-w-3xl shadow-2xl flex flex-col max-h-[90vh] overflow-hidden">
            <div class="p-5 border-b border-[#216281] flex justify-between items-center bg-[#000012]">
                <h3 class="text-lg font-bold text-[#6E57FD]">User Management</h3>
                <button onclick="closeUserManagerModal()" class="text-[#7a7d90] hover:text-[#ffffff] transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="p-6 overflow-y-auto space-y-6">
                <!-- Create/Edit Form -->
                <div class="bg-[#000000] p-4 rounded-xl border border-[#2a2e43]">
                    <h4 id="user-form-title" class="text-xs font-semibold text-[#00BBFC] uppercase tracking-wider mb-4">Add New User</h4>
                    <form id="user-form" onsubmit="handleUserFormSubmit(event)" class="space-y-4">
                        <input type="hidden" id="edit-user-id" value="">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs text-[#b4b7c5] mb-1">Username</label>
                                <input type="text" id="um-username" required class="w-full bg-[#000012] border border-[#2a2e43] focus:border-[#6E57FD] rounded-lg p-2.5 text-xs text-[#ffffff] outline-none">
                            </div>
                            <div>
                                <label class="block text-xs text-[#b4b7c5] mb-1">Password <span id="um-pass-help" class="text-[10px] text-[#7a7d90]">(Leave blank to keep unchanged when editing)</span></label>
                                <input type="password" id="um-password" class="w-full bg-[#000012] border border-[#2a2e43] focus:border-[#6E57FD] rounded-lg p-2.5 text-xs text-[#ffffff] outline-none">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs text-[#b4b7c5] mb-1">User Library Directory Path</label>
                            <input type="text" id="um-library-path" required placeholder="e.g. John or /media/music/John" class="w-full bg-[#000012] border border-[#2a2e43] focus:border-[#6E57FD] rounded-lg p-2.5 text-xs text-[#ffffff] outline-none">
                            <p class="text-[10px] text-[#7a7d90] mt-1">Enter a folder name under LIBRARY_PATH (for example, Ken) or an absolute path for your operating system (for example, /media/music/Ken in Linux/Docker or C:/Media/Music/Ken on Windows).</p>
                        </div>

                        <div>
                            <label class="block text-xs text-[#b4b7c5] mb-1">Role</label>
                            <select id="um-role" class="w-full bg-[#000012] border border-[#2a2e43] focus:border-[#6E57FD] rounded-lg p-2.5 text-xs text-[#f1f2f6] outline-none">
                                <option value="user">User</option>
                                <option value="admin">Administrator</option>
                            </select>
                            <p class="text-[10px] text-[#7a7d90] mt-1">Administrators can access organizer, scan, and user-management controls.</p>
                        </div>

                        <div>
                            <label class="block text-xs text-[#b4b7c5] mb-1">Linking Mode</label>
                            <select id="um-index-mode" class="w-full bg-[#000012] border border-[#2a2e43] focus:border-[#6E57FD] rounded-lg p-2.5 text-xs text-[#f1f2f6] outline-none">
                                <option value="standard">Standard</option>
                                <option value="advanced">Advanced</option>
                            </select>
                        </div>

                        <div class="flex justify-end gap-2 pt-2">
                            <button type="button" onclick="resetUserForm()" class="px-4 py-2 bg-[#1d202f] hover:bg-[#2a2e43] rounded-lg text-xs font-semibold transition-colors">Reset</button>
                            <button type="submit" id="um-submit-btn" class="px-5 py-2 bg-[#5B47CA] hover:bg-[#6E57FD] rounded-lg text-xs font-semibold text-[#ffffff] transition-colors">Create User</button>
                        </div>
                    </form>
                </div>

                <!-- Existing Users List -->
                <div>
                    <h4 class="text-xs font-semibold text-[#b4b7c5] uppercase tracking-wider mb-3">Registered Users</h4>
                    <div class="overflow-x-auto bg-[#000000] rounded-xl border border-[#2a2e43]">
                        <table class="w-full text-left text-xs">
                            <thead class="border-b border-[#2a2e43] text-[#7a7d90] uppercase font-semibold">
                                <tr>
                                    <th class="p-3">User</th>
                                    <th class="p-3">Role</th>
                                    <th class="p-3">Mode</th>
                                    <th class="p-3">Library Path</th>
                                    <th class="p-3 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="user-list-tbody" class="divide-y divide-[#1d202f]"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Dead Files Modal -->
    <div id="dead-files-modal" class="fixed z-[90] inset-0 bg-[#000000]/80 backdrop-blur-sm items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[#000012] border border-[#216281] rounded-2xl w-full max-w-2xl shadow-2xl flex flex-col max-h-[90vh] overflow-hidden">
            <div class="p-5 border-b border-[#216281] flex justify-between items-center bg-[#000012]">
                <h3 class="text-lg font-bold text-[#A05AFA]">Dead Files &amp; Catalog Repair</h3>
                <button onclick="closeDeadFilesModal()" class="text-[#7a7d90] hover:text-[#ffffff] transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="p-6 overflow-y-auto space-y-4">
                <p class="text-xs text-[#b4b7c5]">These catalog entries point to missing paths. MILO checks for a replacement using embedded title and artist metadata and considers album compatibility and file quality. Repair updates the existing catalog entry while preserving library assignments; Clear Entry only removes the stale catalog record, not an audio file.</p>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-[#000000] border border-[#2a2e43] rounded-lg p-3">
                    <div class="flex flex-wrap items-center gap-3 text-xs">
                        <label class="flex items-center gap-2"><input id="dead-files-select-repairable" type="checkbox" onchange="toggleDeadFileAllSelection(this.checked)" class="accent-[#2B66FD]"><span>Select all repairable entries</span></label>
                        <span id="dead-files-selection-count" class="text-[#7a7d90]">0 selected · 0 repairable</span>
                    </div>
                    <button id="btn-repair-dead-selected" onclick="repairSelectedDeadFiles()" disabled class="px-4 py-2 rounded-lg bg-[#814AC8] hover:bg-[#A05AFA] disabled:opacity-40 disabled:cursor-not-allowed text-xs font-semibold text-white">Repair Selected</button>
                </div>
                <div id="dead-files-container" class="bg-[#000000] border border-[#2a2e43] rounded-xl max-h-[55vh] overflow-y-auto p-4 space-y-3"></div>
            </div>

            <div class="p-4 border-t border-[#216281] flex justify-between items-center bg-[#000012]">
                <span id="dead-files-count" class="text-xs text-[#7a7d90]">0 missing files detected</span>
                <button onclick="purgeDeadFiles()" id="btn-purge-dead" class="px-5 py-2 bg-[#814AC8] hover:bg-[#A05AFA] rounded-lg text-xs font-semibold text-[#ffffff] transition-colors">
                    Purge All Dead Files
                </button>
            </div>
        </div>
    </div>

    <!-- Import Modal -->
    <div id="import-modal" class="fixed z-[90] inset-0 bg-[#000000]/80 backdrop-blur-sm items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[#000012] border border-[#216281] rounded-2xl w-full max-w-2xl shadow-2xl flex flex-col max-h-[90vh] overflow-hidden">
            <div class="p-5 border-b border-[#216281] flex justify-between items-center bg-[#000012]">
                <h3 class="text-lg font-bold text-[#2B66FD]" id="import-modal-title">Manual Import</h3>
                <button onclick="closeImportModal()" class="text-[#7a7d90] hover:text-[#ffffff] transition-colors" aria-label="Close import modal">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="p-6 overflow-y-auto flex-1 space-y-4 text-sm">
                <div id="import-setup" class="space-y-4">
                    <div>
                        <label for="import-source" class="block text-xs font-medium text-[#b4b7c5] mb-1">Source Format</label>
                        <select id="import-source" onchange="updateImportSourceUI()" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-sm text-[#f1f2f6] outline-none">
                            <option value="text">Plain Text List (One per line)</option>
                            <option value="text_playlist">Personal Text Playlist (This User)</option>
                            <option value="spotify">Spotify Playlist</option>
                            <option value="youtube">YouTube Music Playlist</option>
                            <option value="apple">Apple Music Playlist</option>
                        </select>
                    </div>
                    <div id="import-input-wrapper">
                        <label id="import-input-label" for="import-text-data" class="block text-xs font-medium text-[#b4b7c5] mb-1">Data Input</label>
                        <textarea id="import-text-data" rows="8" placeholder="Artist - Song Title 1&#10;Artist - Song Title 2" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-3 text-xs text-[#ffffff] outline-none font-mono resize-y"></textarea>
                    </div>
                    <p id="import-source-help" class="text-xs text-[#7a7d90]">Paste artist and title entries, one per line. MILO will compare them with the master pool before changing your library.</p>
                    <label id="import-save-row" class="flex items-start gap-2 cursor-pointer bg-[#000000] border border-[#216281] rounded-lg p-3">
                        <input type="checkbox" id="import-save-to-playlist" class="mt-0.5 accent-[#2B66FD]">
                        <span class="text-xs text-[#b4b7c5]">Also save these text entries to my Text Playlist for future syncs.</span>
                    </label>
                    <div id="import-progress-status" class="hidden text-xs text-[#00BBFC] bg-[#000000] border border-[#216281] rounded-lg p-3">Preparing import...</div>
                </div>

                <div id="import-diff" class="hidden space-y-6">
                    <div id="diff-warning" class="hidden text-xs text-[#A05AFA] bg-[#2D1D40]/30 border border-[#643B97]/50 rounded-lg p-3"></div>
                    <div class="space-y-2">
                        <h4 class="text-sm font-semibold text-[#0092FC] flex justify-between items-center border-b border-[#216281] pb-1">
                            Tracks to Add <span id="diff-add-count" class="bg-[#1E416B]/50 text-[#2EA8FF] px-2 py-0.5 rounded text-xs">0</span>
                        </h4>
                        <ul id="diff-add" class="text-xs bg-[#000000] border border-[#216281] p-3 rounded-lg max-h-40 overflow-y-auto space-y-1.5"></ul>
                    </div>
                    <div class="space-y-2">
                        <h4 class="text-sm font-semibold text-[#b4b7c5] flex justify-between items-center border-b border-[#216281] pb-1">
                            Already in Library <span id="diff-exist-count" class="bg-[#1d202f] text-[#d5d7e0] px-2 py-0.5 rounded text-xs">0</span>
                        </h4>
                        <ul id="diff-exist" class="text-xs bg-[#000000] border border-[#216281] p-3 rounded-lg max-h-32 overflow-y-auto space-y-1.5"></ul>
                    </div>
                    <div class="space-y-2">
                        <h4 class="text-sm font-semibold text-[#8934F9] flex justify-between items-center border-b border-[#216281] pb-1">
                            Match Failures <span id="diff-miss-count" class="bg-[#2D1D40]/50 text-[#A05AFA] px-2 py-0.5 rounded text-xs">0</span>
                        </h4>
                        <ul id="diff-miss" class="text-xs bg-[#000000] border border-[#216281] p-3 rounded-lg max-h-40 overflow-y-auto space-y-1.5 font-mono"></ul>
                    </div>
                </div>
            </div>

            <div class="p-4 border-t border-[#216281] bg-[#000012]/50">
                <div id="setup-actions" class="flex flex-col-reverse sm:flex-row justify-end gap-3">
                    <button onclick="closeImportModal()" class="w-full sm:w-auto px-5 py-2.5 bg-[#1d202f] hover:bg-[#2a2e43] text-[#f1f2f6] rounded-lg text-sm font-medium transition-colors">Cancel</button>
                    <button id="import-generate-btn" onclick="previewImport()" class="w-full sm:w-auto px-5 py-2.5 bg-[#2C53CA] hover:bg-[#2B66FD] text-[#ffffff] rounded-lg text-sm font-medium transition-colors">Start</button>
                </div>
                <div id="diff-actions" class="hidden flex-col-reverse sm:flex-row justify-end gap-3">
                    <button onclick="resetImportModal()" id="import-back-btn" class="w-full sm:w-auto px-5 py-2.5 bg-[#1d202f] hover:bg-[#2a2e43] text-[#f1f2f6] rounded-lg text-sm font-medium transition-colors">Back to Edit</button>
                    <button onclick="closeImportModal()" id="import-close-btn" class="hidden w-full sm:w-auto px-5 py-2.5 bg-[#1d202f] hover:bg-[#2a2e43] text-[#f1f2f6] rounded-lg text-sm font-medium transition-colors">Close</button>
                    <button onclick="confirmImport()" id="diff-sync-btn" class="w-full sm:w-auto px-5 py-2.5 bg-[#2C53CA] hover:bg-[#2B66FD] text-[#ffffff] rounded-lg text-sm font-bold transition-colors">Sync Now</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Sync Settings Modal -->
    <div id="sync-settings-modal" class="fixed z-[90] inset-0 bg-[#000000]/80 backdrop-blur-sm items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[#000012] border border-[#216281] rounded-2xl w-full max-w-lg shadow-2xl flex flex-col max-h-[90vh] overflow-hidden">
            <div class="p-5 border-b border-[#216281] flex justify-between items-center bg-[#000012]">
                <h3 class="text-lg font-bold text-[#6E57FD]">User Sync Settings</h3>
                <button onclick="closeSyncSettingsModal()" class="text-[#7a7d90] hover:text-[#ffffff] transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="p-6 overflow-y-auto space-y-4 text-xs">
                <div>
                    <label class="block text-[#b4b7c5] mb-1">Default Provider</label>
                    <select id="ss-provider" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-[#f1f2f6] outline-none">
                        <option value="" <%= !['spotify', 'youtube', 'apple'].includes(current_user.sync_provider) ? 'selected' : '' %>>No default provider (Text Playlist only)</option>
                        <option value="spotify" <%= current_user.sync_provider === 'spotify' ? 'selected' : '' %>>Spotify</option>
                        <option value="youtube" <%= current_user.sync_provider === 'youtube' ? 'selected' : '' %>>YouTube Music</option>
                        <option value="apple" <%= current_user.sync_provider === 'apple' ? 'selected' : '' %>>Apple Music</option>
                    </select>
                </div>

                <div>
                    <label class="block text-[#b4b7c5] mb-1">Playlist URL / ID</label>
                    <input type="text" id="ss-url" placeholder="https://..." value="<%= current_user.sync_url || '' %>" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-[#ffffff] outline-none">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <label class="flex items-center gap-2 cursor-pointer bg-[#000000] p-3 rounded-lg border border-[#2a2e43]">
                        <input type="checkbox" id="ss-auto-sync" <%= current_user.auto_sync ? 'checked' : '' %> class="accent-[#2B66FD]">
                        <span class="text-[#ffffff]">Enable Auto Sync</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer bg-[#000000] p-3 rounded-lg border border-[#2a2e43]">
                        <input type="checkbox" id="ss-one-for-one" <%= current_user.one_for_one ? 'checked' : '' %> class="accent-[#2B66FD]">
                        <span class="text-[#ffffff]">1-for-1 Playlist Mirror</span>
                    </label>
                </div>

                <div>
                    <label class="block text-[#b4b7c5] mb-1">Automatic Sync Cadence</label>
                    <select id="ss-interval" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-[#ffffff] outline-none">
                        <option value="0" <%= Number(current_user.sync_interval || 0) === 0 ? 'selected' : '' %>>Manual sync only</option>
                        <option value="60" <%= Number(current_user.sync_interval || 0) === 60 ? 'selected' : '' %>>Hourly</option>
                        <option value="180" <%= Number(current_user.sync_interval || 0) === 180 ? 'selected' : '' %>>Every 3 hours</option>
                        <option value="360" <%= Number(current_user.sync_interval || 0) === 360 ? 'selected' : '' %>>Every 6 hours</option>
                        <option value="720" <%= Number(current_user.sync_interval || 0) === 720 ? 'selected' : '' %>>Every 12 hours</option>
                        <option value="1440" <%= Number(current_user.sync_interval || 0) === 1440 ? 'selected' : '' %>>Daily</option>
                        <option value="10080" <%= Number(current_user.sync_interval || 0) === 10080 ? 'selected' : '' %>>Weekly</option>
                        <option value="43200" <%= Number(current_user.sync_interval || 0) === 43200 ? 'selected' : '' %>>Every 30 days</option>
                    </select>
                    <p class="text-[11px] text-[#7a7d90] mt-2">Scheduled syncs share one server-wide queue with catalog maintenance. MILO runs one sync at a time, gives a due full scan priority, waits at least 5 minutes between sync/import jobs across all users, and starts each user's cooldown after that user's sync finishes. Missed intervals are combined into one run, not replayed.</p>
                </div>

                <div class="border-t border-[#216281] pt-4 space-y-3">
                    <div>
                        <span class="block font-semibold text-[#00BBFC]">Personal Text Playlist</span>
                        <p class="text-[11px] text-[#7a7d90] mt-1">Keep one artist/title entry per line. This playlist is independent of your provider playlist and is included in Sync Playlist and scheduled syncs. External apps, automations, and shortcuts can add entries here using the API key below.</p>
                    </div>
                    <textarea id="ss-text-playlist" rows="7" placeholder="Artist Name - Song Title&#10;Another Artist - Another Song" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-3 text-xs text-[#ffffff] outline-none font-mono resize-y"></textarea>
                    <p id="ss-text-playlist-status" class="text-[10px] text-[#7a7d90]">Loading personal Text Playlist...</p>
                    <div class="flex justify-end">
                        <button id="ss-text-playlist-save-btn" type="button" onclick="saveTextPlaylist()" disabled class="px-4 py-2 bg-[#1A76C9] hover:bg-[#0092FC] disabled:opacity-50 disabled:cursor-not-allowed rounded-lg text-xs font-semibold text-white">Save Text Playlist</button>
                    </div>
                    <p class="text-[10px] text-[#7a7d90]">Duplicate entries are ignored. An unmatched entry stays saved so a future sync can find it if the track is added to the master pool.</p>
                </div>

                <div class="border-t border-[#216281] pt-4 space-y-3">
                    <div>
                        <span class="block font-semibold text-[#00BBFC]">Text Playlist API Access</span>
                        <p class="text-[11px] text-[#7a7d90] mt-1">Generate a user-specific API key for an external app, automation, or shortcut. Send a JSON POST to <code>/api/integrations/text-playlist</code> with <code>artist</code> and <code>title</code>, and include the key in the <code>X-MILO-API-Key</code> header. Keep the key private.</p>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-2">
                        <input type="password" id="ss-text-playlist-api-key" readonly placeholder="Generate a key to display it once" class="min-w-0 flex-1 bg-[#000000] border border-[#2a2e43] rounded-lg p-2.5 text-[#ffffff] outline-none font-mono text-[11px]">
                        <button type="button" onclick="copyTextPlaylistApiKey()" class="px-3 py-2 bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] rounded-lg text-xs font-semibold">Select / Copy</button>
                    </div>
                    <p id="ss-text-playlist-api-key-status" class="text-[11px] text-[#7a7d90]">Checking API key status...</p>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" onclick="generateTextPlaylistApiKey()" class="px-4 py-2 bg-[#1A76C9] hover:bg-[#0092FC] rounded-lg text-xs font-semibold text-white">Generate / Replace Key</button>
                        <button type="button" onclick="revokeTextPlaylistApiKey()" class="px-4 py-2 bg-[#330816] hover:bg-[#66112c] border border-[#66112c] rounded-lg text-xs font-semibold text-[#ff80a8]">Revoke Key</button>
                    </div>
                </div>

                <div class="border-t border-[#2a2e43] pt-3 space-y-3">
                    <span class="block font-semibold text-[#00BBFC]">API Credentials (Optional)</span>
                    <input type="text" id="ss-spotify-id" placeholder="Spotify Client ID" value="<%= current_user.spotify_client_id || '' %>" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-[#ffffff] outline-none">
                    <input type="password" id="ss-spotify-secret" placeholder="Spotify Client Secret" value="<%= current_user.spotify_client_secret || '' %>" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-[#ffffff] outline-none">
                    <input type="text" id="ss-apple-token" placeholder="Apple Developer Token" value="<%= current_user.apple_dev_token || '' %>" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-[#ffffff] outline-none">
                </div>
            </div>

            <div class="p-4 border-t border-[#216281] flex justify-end gap-3 bg-[#000012]">
                <button onclick="closeSyncSettingsModal()" class="px-4 py-2 bg-[#1d202f] hover:bg-[#2a2e43] rounded-lg text-xs font-semibold transition-colors">Cancel</button>
                <button onclick="saveSyncSettings()" class="px-5 py-2 bg-[#5B47CA] hover:bg-[#6E57FD] rounded-lg text-xs font-semibold text-[#ffffff] transition-colors">Save Settings</button>
            </div>
        </div>
    </div>

    <!-- Removed Logs / Restore Tracks Modal -->
    <div id="removed-logs-modal" class="fixed z-[90] inset-0 bg-[#000000]/80 backdrop-blur-sm items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[#000012] border border-[#216281] rounded-2xl w-full max-w-xl shadow-2xl flex flex-col max-h-[90vh] overflow-hidden">
            <div class="p-5 border-b border-[#216281] flex justify-between items-center bg-[#000012]">
                <h3 class="text-lg font-bold text-[#8A48FF]">Removed Tracks History</h3>
                <button onclick="closeRemovedLogsModal()" class="text-[#7a7d90] hover:text-[#ffffff] transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="px-5 py-3 border-b border-[#216281] flex flex-wrap items-center justify-between gap-3 bg-[#000000]/60">
                <div class="flex items-center gap-3 text-xs">
                    <label class="flex items-center gap-2"><input id="restore-tracks-select-all" type="checkbox" onchange="toggleRestoreTrackSelection(this.checked)" class="accent-[#2B66FD]"><span>Select all visible</span></label>
                    <span id="restore-tracks-selection-count" class="text-[#7a7d90]">0 selected</span>
                </div>
            </div>
            <div class="p-6 overflow-y-auto max-h-80 space-y-2 text-xs" id="removed-logs-list"></div>

            <div class="p-4 border-t border-[#216281] flex justify-between items-center bg-[#000012]">
                <span class="text-xs text-[#7a7d90]">Restoring selected tracks runs in the background.</span>
                <button id="restore-tracks-submit" onclick="restoreSelectedTracks()" disabled class="px-5 py-2 bg-[#713CCC] hover:bg-[#8A48FF] disabled:opacity-40 disabled:cursor-not-allowed rounded-lg text-xs font-semibold text-[#ffffff] transition-colors">Restore Selected Tracks</button>
            </div>
        </div>
    </div>

    <!-- Missing Track Logs Modal -->
    <div id="missing-logs-modal" class="fixed z-[90] inset-0 bg-[#000000]/80 backdrop-blur-sm items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[#000012] border border-[#216281] rounded-2xl w-full max-w-2xl shadow-2xl flex flex-col max-h-[90vh] overflow-hidden">
            <div class="p-5 border-b border-[#216281] flex justify-between items-center bg-[#000012]">
                <h3 class="text-lg font-bold text-[#A05AFA]">Unmatched Track Logs</h3>
                <button onclick="closeMissingLogsModal()" class="text-[#7a7d90] hover:text-[#ffffff] transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="p-4 border-b border-[#216281] space-y-3 bg-[#000000]/60">
                <div class="flex flex-col gap-3">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div class="flex flex-wrap items-center gap-3 text-xs">
                            <label class="flex items-center gap-2"><input id="missing-logs-select-visible" type="checkbox" onchange="toggleMissingLogsVisibleSelection(this.checked)" class="accent-[#2B66FD]"><span>Select visible logs</span></label>
                            <span id="missing-logs-selection-count" class="text-[#7a7d90]">0 selected across pages</span>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <button id="missing-logs-skip-selected" onclick="runSelectedMissingLogSkips()" disabled class="px-3 py-2 bg-[#4C2B83] hover:bg-[#643B97] disabled:opacity-40 disabled:cursor-not-allowed text-white rounded-lg text-xs font-semibold transition-colors">Skip Selected</button>
                            <button id="missing-logs-link-selected" onclick="runSelectedMissingLogResolutions()" disabled class="px-3 py-2 bg-[#713CCC] hover:bg-[#8A48FF] disabled:opacity-40 disabled:cursor-not-allowed text-white rounded-lg text-xs font-semibold transition-colors">Link Selected</button>
                        </div>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-t border-[#2a2e43] pt-3">
                        <span class="text-[10px] text-[#7a7d90] uppercase tracking-wider">Log Management</span>
                        <div class="flex flex-wrap gap-2">
                            <button onclick="openMissingLogsHistoryModal()" class="px-3 py-2 bg-[#1d202f] hover:bg-[#2a2e43] text-[#d5d7e0] rounded-lg text-xs font-semibold transition-colors">History</button>
                            <button onclick="clearAllMissingLogs()" class="px-3 py-2 bg-[#330816] hover:bg-[#66112c] text-[#ff80a8] rounded-lg text-xs font-semibold transition-colors">Clear All Logs</button>
                        </div>
                    </div>
                </div>
                <p class="text-[10px] text-[#7a7d90]">Choose the suggested match for each selected log. You can select items across pages and submit them together. History and Clear All Logs are separate log-management actions.</p>
            </div>
            <div class="p-6 overflow-y-auto max-h-80 space-y-3 text-xs" id="missing-logs-list"></div>

            <div class="p-4 border-t border-[#216281] flex justify-between items-center bg-[#000012]">
                <span id="missing-logs-page-info" class="text-xs text-[#7a7d90]">Page 1 of 1</span>
                <div class="flex gap-2">
                    <button id="missing-logs-prev" onclick="changeMissingLogsPage(-1)" disabled class="px-3 py-2 bg-[#1d202f] hover:bg-[#2a2e43] disabled:opacity-40 border border-[#2a2e43] rounded-lg text-xs font-semibold">Previous</button>
                    <button id="missing-logs-next" onclick="changeMissingLogsPage(1)" disabled class="px-3 py-2 bg-[#1d202f] hover:bg-[#2a2e43] disabled:opacity-40 border border-[#2a2e43] rounded-lg text-xs font-semibold">Next</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Unmatched Track Log History Modal -->
    <div id="missing-logs-history-modal" class="fixed z-[90] inset-0 bg-[#000000]/80 backdrop-blur-sm items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[#000012] border border-[#216281] rounded-2xl w-full max-w-3xl shadow-2xl flex flex-col max-h-[90vh] overflow-hidden">
            <div class="p-5 border-b border-[#216281] flex justify-between items-center bg-[#000012]">
                <h3 class="text-lg font-bold text-[#A05AFA]">Unmatched Log History</h3>
                <button onclick="closeMissingLogsHistoryModal()" class="text-[#7a7d90] hover:text-[#ffffff] transition-colors" aria-label="Close history">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            <div id="missing-logs-history-list" class="p-5 overflow-y-auto space-y-3 text-xs max-h-[65vh]"><div class="text-[#7a7d90] text-center p-4">Loading history…</div></div>
            <div class="p-4 border-t border-[#216281] flex justify-end bg-[#000012]">
                <button onclick="closeMissingLogsHistoryModal()" class="px-5 py-2 bg-[#1d202f] hover:bg-[#2a2e43] rounded-lg text-xs font-semibold">Close</button>
            </div>
        </div>
    </div>

    <!-- Job Results Modal -->
    <div id="job-results-modal" class="fixed z-[90] inset-0 bg-[#000000]/80 backdrop-blur-sm items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[#000012] border border-[#216281] rounded-2xl w-full max-w-2xl shadow-2xl flex flex-col max-h-[90vh] overflow-hidden">
            <div class="p-5 border-b border-[#216281] flex justify-between items-center bg-[#000012]">
                <h3 class="text-lg font-bold text-[#0092FC]">Sync Results Review</h3>
                <button onclick="closeJobResultsModal()" class="text-[#7a7d90] hover:text-[#ffffff] transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="p-6 overflow-y-auto space-y-4 max-h-96 text-xs" id="job-results-content"></div>

            <div class="p-4 border-t border-[#216281] flex justify-end gap-3 bg-[#000012]">
                <button onclick="closeJobResultsModal()" class="px-4 py-2 bg-[#1d202f] hover:bg-[#2a2e43] rounded-lg text-xs font-semibold transition-colors">Dismiss</button>
                <button onclick="confirmJobImport()" class="px-5 py-2 bg-[#2C53CA] hover:bg-[#2B66FD] rounded-lg text-xs font-semibold text-[#ffffff] transition-colors">Apply Selection</button>
            </div>
        </div>
    </div>

    <script>
        let currentPage = 1, totalPages = 1, totalTracks = 0;
        const currentViewerIsAdmin = <%= current_user.role === 'admin' ? 'true' : 'false' %>;
        const catalogPreferencesKey = 'milo.catalog.preferences.v1:<%= Number(current_user.id) %>';
        let searchDebounce = null;
        let activeJobData = null;
        let currentSyncContext = 'manual';
        let pendingTracks = [];
        let existingTracks = [];
        let importPreviewMode = false;
        let importStatusPollInterval = null;
        let hasTextPlaylistApiKey = false;
        let textPlaylistLoaded = false;
        let currentExemptFolders = [];
        let currentDumpFolders = [];
        let systemUsersList = [];
        let organizerCurrentItems = [];
        let organizerReviewCurrentPage = 1;
        let organizerReviewPages = 1;
        let organizerReviewFilteredCount = 0;
        let organizerSelectedIds = new Set();
        let organizerSelectAllFiltered = false;
        let organizerReviewSearchDebounce = null;
        let organizerStatusPollInterval = null;
        let masterScanStatusPollInterval = null;
        let deadFileStatusPollInterval = null;
        let missingLogStatusPollInterval = null;
        let restoreStatusPollInterval = null;
        let libraryPathStatusPollInterval = null;
        let restoreTrackSelections = new Set();
        let activeProgressJobType = null;
        let activeProgressQueueId = null;
        let deadFileRepairChoices = new Map();
        let deadFileSelectedIds = new Set();
        let missingLogsPage = 1;
        let missingLogsPages = 1;
        let missingLogsCount = 0;
        let missingLogsCurrentItems = [];
        let missingLogsLoadToken = 0;
        let missingLogSelections = new Map();
        let missingLogChoices = new Map();
        let catalogRequestToken = 0;
        let catalogAbortController = null;
        let organizerReviewLoadToken = 0;
        let modalRequestGeneration = 0;
        let activeManagedModalId = null;
        const managedModalIds = [
            'scan-settings-modal', 'organizer-review-modal', 'user-manager-modal',
            'dead-files-modal', 'import-modal', 'sync-settings-modal',
            'removed-logs-modal', 'missing-logs-modal', 'missing-logs-history-modal', 'job-results-modal'
        ];

        // Only one async modal may own the screen at a time. Showing a modal is
        // immediate; async responses carry a generation token so a slow older
        // request cannot reopen itself over a newer modal.
        function showManagedModal(modalId, loadingContainerId = null, loadingText = 'Loading...') {
            modalRequestGeneration++;
            activeManagedModalId = modalId;
            for (const id of managedModalIds) {
                const other = document.getElementById(id);
                if (!other) continue;
                if (id !== modalId) {
                    other.classList.add('hidden');
                    other.classList.remove('flex');
                }
            }
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
            if (loadingContainerId) {
                const container = document.getElementById(loadingContainerId);
                if (container) container.innerHTML = `<div class="flex items-center justify-center gap-3 text-xs text-[#7a7d90] p-5"><span class="inline-block w-4 h-4 border-2 border-[#216281] border-t-[#00BBFC] rounded-full animate-spin"></span><span>${escapeHtml(loadingText)}</span></div>`;
            }
            return modalRequestGeneration;
        }

        function isManagedModalCurrent(modalId, generation) {
            const modal = document.getElementById(modalId);
            return activeManagedModalId === modalId && modalRequestGeneration === generation && !!modal && !modal.classList.contains('hidden');
        }

        function closeManagedModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
            if (activeManagedModalId === modalId) {
                modalRequestGeneration++;
                activeManagedModalId = null;
            }
        }

        let appConfirmResolver = null;
        function showConfirm(title, message, confirmLabel = 'Continue') {
            const modal = document.getElementById('system-confirm-modal');
            if (!modal) return Promise.resolve(false);
            if (typeof appConfirmResolver === 'function') appConfirmResolver(false);
            document.getElementById('confirm-modal-title').innerText = title || 'Please Confirm';
            document.getElementById('confirm-modal-msg').innerText = message || '';
            document.getElementById('confirm-modal-accept').innerText = confirmLabel;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            return new Promise(resolve => {
                appConfirmResolver = resolve;
                const accept = document.getElementById('confirm-modal-accept');
                if (accept) accept.focus();
            });
        }

        function resolveAppConfirm(confirmed) {
            const modal = document.getElementById('system-confirm-modal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
            const resolver = appConfirmResolver;
            appConfirmResolver = null;
            if (typeof resolver === 'function') resolver(!!confirmed);
        }

        function showAlert(title, message, isSuccess) {
            let modalTitle = "Error";
            let modalMsg = "";
            let isOk = false;

            // 1. Handled JSON response objects: showAlert(res) or Error objects: showAlert(err)
            if (typeof title === 'object' && title !== null) {
                if (title instanceof Error) {
                    isOk = false;
                    modalMsg = title.message;
                    modalTitle = "Error";
                } else {
                    // Strictly check success === true
                    isOk = title.success === true;
                    modalMsg = title.message || title.msg || title.error || JSON.stringify(title);
                    modalTitle = title.title || (isOk ? "Success" : "Error");
                }
            } 
            // 2. Handle the 2-argument form: showAlert("Settings saved!", true)
            else if (typeof message === 'boolean') {
                isOk = message;
                modalMsg = title || "";
                modalTitle = isOk ? "Success" : "Error";
            }
            // 3. Handled 3 arguments with explicit boolean: showAlert("Title", "Message", true)
            else if (typeof isSuccess === 'boolean' || typeof isSuccess === 'string') {
                isOk = (isSuccess === true || isSuccess === 'true');
                modalTitle = title || (isOk ? "Success" : "Error");
                modalMsg = message || "";
            }
            // 4. Handled single string argument: showAlert("Master pool directory not found.")
            else if (message === undefined && isSuccess === undefined) {
                modalMsg = title || "";
                const hasErrorWord = /error|fail|invalid|unauthorized|exception|cannot|could not|not found|missing|denied|unable/i.test(modalMsg);
                const hasSuccessWord = /success|updated|saved|completed|done|created|purged|restored/i.test(modalMsg);
                isOk = hasSuccessWord && !hasErrorWord;
                modalTitle = isOk ? "Success" : "Error";
            }
            // 5. Fallback for 2 string args without boolean: showAlert("Scan", "Master pool directory not found.")
            else {
                modalTitle = title || "Notification";
                modalMsg = message || "";
                const combined = `${modalTitle} ${modalMsg}`;
                const hasErrorWord = /error|fail|invalid|unauthorized|exception|cannot|could not|not found|missing|denied|unable/i.test(combined);
                const hasSuccessWord = /success|updated|saved|completed|done|created|purged|restored/i.test(combined);
                isOk = hasSuccessWord && !hasErrorWord;
            }

            // DOM Updates
            const modal = document.getElementById('system-alert-modal');
            const titleEl = document.getElementById('alert-modal-title');
            const msgEl = document.getElementById('alert-modal-msg');
            const errorIcon = document.getElementById('alert-icon-error');
            const successIcon = document.getElementById('alert-icon-success');
            const errorBtns = document.getElementById('alert-actions-error');
            const successBtns = document.getElementById('alert-actions-success');
            const iconContainer = document.getElementById('alert-icon-container');

            if (titleEl) {
                titleEl.innerText = modalTitle;
                titleEl.classList.toggle('text-[#00BBFC]', isOk);
                titleEl.classList.toggle('text-[#ff80a8]', !isOk);
            }
            if (msgEl) msgEl.innerText = modalMsg;

            if (isOk) {
                if (successIcon) successIcon.classList.remove('hidden');
                if (errorIcon) errorIcon.classList.add('hidden');
                if (successBtns) {
                    successBtns.classList.remove('hidden');
                    successBtns.classList.add('flex');
                }
                if (errorBtns) {
                    errorBtns.classList.add('hidden');
                    errorBtns.classList.remove('flex');
                }
                if (iconContainer) {
                    iconContainer.classList.remove('bg-[#330816]');
                    iconContainer.classList.add('bg-[#001a2c]');
                }
            } else {
                if (errorIcon) errorIcon.classList.remove('hidden');
                if (successIcon) successIcon.classList.add('hidden');
                if (errorBtns) {
                    errorBtns.classList.remove('hidden');
                    errorBtns.classList.add('flex');
                }
                if (successBtns) {
                    successBtns.classList.add('hidden');
                    successBtns.classList.remove('flex');
                }
                if (iconContainer) {
                    iconContainer.classList.remove('bg-[#001a2c]');
                    iconContainer.classList.add('bg-[#330816]');
                }
            }

            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        }

        function closeAppAlert() {
            const modal = document.getElementById('system-alert-modal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        function forceRefreshCheck() {
            window.location.reload();
        }

        function saveCatalogPreferences() {
            try {
                localStorage.setItem(catalogPreferencesKey, JSON.stringify({
                    search: document.getElementById('search-input').value,
                    filter: document.getElementById('library-filter').value,
                    sort: document.getElementById('sort-by').value,
                    order: document.getElementById('sort-order').value,
                    limit: document.getElementById('page-limit').value,
                    page: currentPage
                }));
            } catch (_) {
                // Catalog preferences are optional; private browsing may block storage.
            }
        }

        function restoreCatalogPreferences() {
            try {
                const saved = JSON.parse(localStorage.getItem(catalogPreferencesKey) || 'null');
                if (!saved || typeof saved !== 'object') return;
                const filter = document.getElementById('library-filter');
                const sort = document.getElementById('sort-by');
                const order = document.getElementById('sort-order');
                const limit = document.getElementById('page-limit');
                const search = document.getElementById('search-input');
                if (saved.filter && Array.from(filter.options).some(option => option.value === saved.filter)) filter.value = saved.filter;
                if (saved.sort && Array.from(sort.options).some(option => option.value === saved.sort)) sort.value = saved.sort;
                if (saved.order && Array.from(order.options).some(option => option.value === saved.order)) order.value = saved.order;
                if (saved.limit && Array.from(limit.options).some(option => option.value === saved.limit)) limit.value = saved.limit;
                if (typeof saved.search === 'string') search.value = saved.search;
                currentPage = Number.isSafeInteger(Number(saved.page)) && Number(saved.page) > 0 ? Number(saved.page) : 1;
            } catch (_) {
                currentPage = 1;
            }
        }

        function loadCatalog() {
            const q = document.getElementById('search-input').value;
            const sort = document.getElementById('sort-by').value;
            const order = document.getElementById('sort-order').value;
            const filter = document.getElementById('library-filter').value;
            const limit = document.getElementById('page-limit').value;
            saveCatalogPreferences();
            const requestToken = ++catalogRequestToken;
            if (catalogAbortController) catalogAbortController.abort();
            catalogAbortController = new AbortController();
            const tbody = document.getElementById('catalog-table');
            tbody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-xs text-[#7a7d90]"><span class="inline-flex items-center justify-center gap-2"><span class="inline-block w-3 h-3 border-2 border-[#216281] border-t-[#00BBFC] rounded-full animate-spin"></span>Loading catalog…</span></td></tr>`;

            fetch(`/api/catalog?q=${encodeURIComponent(q)}&sort=${encodeURIComponent(sort)}&order=${encodeURIComponent(order)}&library_filter=${encodeURIComponent(filter)}&page=${currentPage}&limit=${encodeURIComponent(limit)}`, { signal: catalogAbortController.signal })
                .then(r => {
                    if (!r.ok) throw new Error(`Catalog request failed (${r.status}).`);
                    return r.json();
                })
                .then(data => {
                    if (requestToken !== catalogRequestToken) return;
                    if (!data || !Array.isArray(data.tracks) || !data.stats) throw new Error('The catalog response was incomplete.');
                    renderCatalogTable(data.tracks);
                    updatePaginationUI(data.stats);
                    saveCatalogPreferences();
                })
                .catch(err => {
                    if (err && err.name === 'AbortError') return;
                    if (requestToken !== catalogRequestToken) return;
                    tbody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-xs text-[#ff80a8]">${escapeHtml(err.message || 'Could not load the catalog.')}</td></tr>`;
                });
        }

        function renderCatalogTable(tracks) {
            const tbody = document.getElementById('catalog-table');
            tbody.innerHTML = '';

            if (tracks.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-xs text-[#7a7d90]">No matching tracks found.</td></tr>`;
                return;
            }

            tracks.forEach(track => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-[#1d202f]/30 transition-colors cursor-pointer sm:cursor-default';
                tr.setAttribute('onclick', `toggleMobileRow(${Number(track.id)})`);
                tr.innerHTML = `
                    <td class="p-4 font-medium text-[#f1f2f6]">
                        <div class="flex items-center justify-between gap-2">
                            <div class="min-w-0 truncate max-w-[180px] sm:max-w-xs font-semibold text-[#fcfcfc]">
                                ${escapeHtml(track.title)}
                                <div class="sm:hidden text-xs text-[#b4b7c5] font-normal truncate mt-0.5">${escapeHtml(track.artist || '')}</div>
                            </div>
                            <button type="button" class="sm:hidden text-[#7a7d90] hover:text-[#d5d7e0] ml-1 p-1 shrink-0" aria-label="Show track details" tabindex="-1">
                                <svg id="chevron-${Number(track.id)}" class="w-4 h-4 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                            </button>
                        </div>
                    </td>
                    <td class="p-4 text-[#b4b7c5] truncate max-w-[150px] hidden sm:table-cell">${escapeHtml(track.artist || '')}</td>
                    <td class="p-4 text-[#7a7d90] truncate max-w-[180px] hidden sm:table-cell">${escapeHtml(track.album || '')}</td>
                    <td class="p-4 text-right pr-4 sm:pr-6" onclick="event.stopPropagation()">
                        <button type="button" data-track-id="${Number(track.id)}" data-in-library="${track.in_library ? 'true' : 'false'}" onclick="toggleTrack(${Number(track.id)})" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors ${track.in_library ? 'bg-[#330816] hover:bg-[#66112c] text-[#ff80a8] border border-[#66112c]' : 'bg-[#003B63] hover:bg-[#0092FC] text-[#00BBFC] border border-[#0092FC]'}">
                            ${track.in_library ? 'Remove' : 'Add'}
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);

                const details = document.createElement('tr');
                details.id = `details-${Number(track.id)}`;
                details.className = 'hidden sm:hidden bg-[#000000]/80 border-b border-[#216281]/80';
                const durationSeconds = Number(track.duration);
                const durationLabel = Number.isFinite(durationSeconds) && durationSeconds > 0
                    ? `${Math.floor(durationSeconds / 60)}:${String(Math.floor(durationSeconds % 60)).padStart(2, '0')}`
                    : '';
                const formatLabel = String(track.format || '').trim();
                details.innerHTML = `
                    <td colspan="2" class="p-3 text-xs space-y-1.5">
                        <div><span class="text-[#7a7d90] uppercase font-semibold text-[10px]">Album:</span> <span class="text-[#d5d7e0] ml-1 break-words">${escapeHtml(track.album || 'Unknown album')}</span></div>
                        <div><span class="text-[#7a7d90] uppercase font-semibold text-[10px]">${durationLabel ? 'Track Length:' : 'Format:'}</span> <span class="text-[#d5d7e0] ml-1 break-words">${escapeHtml(durationLabel || formatLabel || 'Unknown')}</span></div>
                    </td>
                `;
                tbody.appendChild(details);
            });
        }

        function toggleMobileRow(trackId) {
            if (window.matchMedia('(min-width: 640px)').matches) return;
            const details = document.getElementById(`details-${Number(trackId)}`);
            const chevron = document.getElementById(`chevron-${Number(trackId)}`);
            if (!details) return;
            const opening = details.classList.contains('hidden');
            details.classList.toggle('hidden', !opening);
            if (chevron) chevron.classList.toggle('rotate-180', opening);
        }

        function updatePaginationUI(stats) {
            totalTracks = stats.total;
            totalPages = stats.totalPages;
            currentPage = stats.page;

            document.getElementById('stat-total').innerText = stats.total;
            document.getElementById('stat-library').innerText = stats.library;

            const start = stats.filtered === 0 ? 0 : (currentPage - 1) * (stats.limit === 'all' ? stats.filtered : stats.limit) + 1;
            const end = stats.limit === 'all' ? stats.filtered : Math.min(currentPage * stats.limit, stats.filtered);

            document.getElementById('page-start-count').innerText = start;
            document.getElementById('page-end-count').innerText = end;
            document.getElementById('page-total-count').innerText = stats.filtered;
            document.getElementById('page-indicator').innerText = `Page ${currentPage} of ${totalPages}`;

            document.getElementById('btn-first-page').disabled = currentPage <= 1;
            document.getElementById('btn-prev-page').disabled = currentPage <= 1;
            document.getElementById('btn-next-page').disabled = currentPage >= totalPages;
            document.getElementById('btn-last-page').disabled = currentPage >= totalPages;
        }

        function handleSearchInput() {
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(() => {
                currentPage = 1;
                loadCatalog();
            }, 300);
        }

        function resetPageAndLoad() { currentPage = 1; loadCatalog(); }
        function handleSortByChange() {
            currentPage = 1;
            // Recently added has always meant newest first when selected. Users can
            // still manually switch the order afterward with the order selector.
            if (document.getElementById('sort-by').value === 'added') {
                document.getElementById('sort-order').value = 'desc';
            }
            loadCatalog();
        }
        function changePage(delta) { goToPage(currentPage + delta); }
        function goToPage(page) {
            if (page >= 1 && page <= totalPages) {
                currentPage = page;
                loadCatalog();
            }
        }

        function styleCatalogTrackButton(button, inLibrary) {
            button.className = `px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors ${inLibrary
                ? 'bg-[#330816] hover:bg-[#66112c] text-[#ff80a8] border border-[#66112c]'
                : 'bg-[#003B63] hover:bg-[#0092FC] text-[#00BBFC] border border-[#0092FC]'}`;
        }

        async function toggleTrack(trackId) {
            const button = document.querySelector(`button[data-track-id="${Number(trackId)}"]`);
            if (!button || button.disabled) return;
            const wasInLibrary = button.dataset.inLibrary === 'true';
            button.disabled = true;
            button.innerText = wasInLibrary ? 'Removing…' : 'Adding…';
            try {
                const response = await fetch('/api/user/toggle-track', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ track_id: Number(trackId) })
                });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || `Could not ${wasInLibrary ? 'remove' : 'add'} this track.`);
                const inLibrary = !!result.in_library;
                button.dataset.inLibrary = inLibrary ? 'true' : 'false';
                button.innerText = inLibrary ? 'Remove' : 'Add';
                styleCatalogTrackButton(button, inLibrary);
                const count = document.getElementById('stat-library');
                if (count && inLibrary !== wasInLibrary) {
                    const current = Number.parseInt(count.innerText, 10) || 0;
                    count.innerText = String(Math.max(0, current + (inLibrary ? 1 : -1)));
                }
                const filter = document.getElementById('library-filter').value;
                if ((inLibrary && filter === 'unadded') || (!inLibrary && filter === 'added')) {
                    currentPage = 1;
                    loadCatalog();
                    return;
                }
                button.disabled = false;
            } catch (error) {
                button.innerText = wasInLibrary ? 'Remove' : 'Add';
                styleCatalogTrackButton(button, wasInLibrary);
                button.disabled = false;
                showAlert('Library Update Failed', error.message || 'Could not update this track in your library.', false);
            }
        }

        // The main-page action is the fast incremental scan. If the catalog/index is empty,
        // the server automatically falls back to the detailed full scan.
        function startManualScan() {
            startCatalogScan('/api/catalog/quick-scan', 'Starting quick scan...');
        }

        // The detailed full scan is available from Scan Settings rather than the main page.
        function startFullMasterScan() {
            closeScanSettingsModal();
            startCatalogScan('/api/catalog/scan', 'Starting detailed full catalog and organizer scan...');
        }

        function startCatalogScan(endpoint, initialMessage) {
            // Every click reaches the server queue. The shared progress panel follows the
            // task requested here; the Work Queue panel continues showing any task already running.
            if (masterScanStatusPollInterval) clearInterval(masterScanStatusPollInterval);
            masterScanStatusPollInterval = null;
            if (importStatusPollInterval) clearInterval(importStatusPollInterval);
            importStatusPollInterval = null;
            if (organizerStatusPollInterval) clearInterval(organizerStatusPollInterval);
            organizerStatusPollInterval = null;
            if (deadFileStatusPollInterval) clearInterval(deadFileStatusPollInterval);
            deadFileStatusPollInterval = null;
            if (missingLogStatusPollInterval) clearInterval(missingLogStatusPollInterval);
            missingLogStatusPollInterval = null;
            if (restoreStatusPollInterval) clearInterval(restoreStatusPollInterval);
            restoreStatusPollInterval = null;
            if (libraryPathStatusPollInterval) clearInterval(libraryPathStatusPollInterval);
            libraryPathStatusPollInterval = null;
            activeProgressQueueId = '__queue-request-pending__';
            const container = document.getElementById('job-progress-container');
            container.classList.remove('hidden');
            document.getElementById('job-status-text').innerText = initialMessage;
            document.getElementById('job-progress-text').innerText = '0 / 0';
            document.getElementById('job-progress-bar').style.width = '8%';
            document.getElementById('job-progress-bar').classList.add('animate-pulse');
            document.getElementById('job-action-container').classList.add('hidden');
            document.getElementById('job-review-btn').classList.add('hidden');
            activeProgressJobType = 'scan';

            fetch(endpoint, { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    if (!res.success) {
                        if (masterScanStatusPollInterval) clearInterval(masterScanStatusPollInterval);
                        masterScanStatusPollInterval = null;
                        activeProgressJobType = null;
                        activeProgressQueueId = null;
                        document.getElementById('job-progress-container').classList.add('hidden');
                        showAlert(res.message || 'Could not start the catalog scan.');
                        refreshJobQueue();
                    } else {
                        activeProgressQueueId = res.queue_id || null;
                        refreshJobQueue();
                        pollScanStatus(false, res.queue_id || null);
                    }
                })
                .catch(() => {
                    activeProgressJobType = null;
                    activeProgressQueueId = null;
                    document.getElementById('job-progress-container').classList.add('hidden');
                    showAlert('Could not contact the catalog scan endpoint.');
                    refreshJobQueue();
                });
        }

        function pollScanStatus(suppressCompletionAlert = false, queueId = null) {
            // Scans are admin-only. This client guard complements the server-side
            // authorization on both scan-status and individual queue-task endpoints.
            if (!currentViewerIsAdmin) return;
            const container = document.getElementById('job-progress-container');
            if (!container) return;
            if (importStatusPollInterval) clearInterval(importStatusPollInterval);
            importStatusPollInterval = null;
            container.classList.remove('hidden');
            activeProgressJobType = 'scan';
            if (queueId) activeProgressQueueId = queueId;
            if (masterScanStatusPollInterval) return;

            const poll = () => {
                fetch(queueId ? `/api/job-queue/${encodeURIComponent(queueId)}` : '/api/catalog/scan-status', { cache: 'no-store' })
                    .then(r => r.json())
                    .then(data => {
                        document.getElementById('job-status-text').innerText = data.message || 'Scanning master pool...';
                        const progress = Number(data.progress) || 0;
                        const total = Number(data.total) || 0;
                        document.getElementById('job-progress-text').innerText = `${progress} / ${total}`;
                        const terminal = data.status === 'completed' || data.status === 'error' || data.status === 'cancelled';
                        const bar = document.getElementById('job-progress-bar');
                        bar.style.width = total > 0 ? `${Math.min(100, (progress / total) * 100)}%` : (terminal ? '100%' : '8%');
                        bar.classList.toggle('animate-pulse', !terminal && total === 0);

                        if (!terminal) return;
                        clearInterval(masterScanStatusPollInterval);
                        masterScanStatusPollInterval = null;
                        document.getElementById('job-action-container').classList.remove('hidden');
                        const reviewButton = document.getElementById('job-review-btn');
                        const quickScanRequested = /new\/changed-song scan|quick scan/i.test(String(data.trigger || ''));
                        const openReview = data.status === 'completed' && data.type !== 'incremental' && !quickScanRequested;
                        // Dismiss already exists in the action row; hide the review action
                        // completely for quick/incremental scans instead of duplicating it.
                        reviewButton.classList.toggle('hidden', !openReview);
                        if (openReview) {
                            reviewButton.innerText = 'Open Organizer Review';
                            reviewButton.onclick = openOrganizerReviewModal;
                        }
                        refreshOrganizerReviewCount();
                        if (data.status === 'completed') {
                            loadCatalog();
                            if (!suppressCompletionAlert) showAlert('Scan Completed', data.message || 'Master-pool scan completed.', true);
                        } else if (data.status === 'cancelled') {
                            if (!suppressCompletionAlert) showAlert('Queue Item Removed', data.message || 'The scan was removed before it started.', true);
                        } else {
                            if (!suppressCompletionAlert) showAlert('Scan Error', data.message || 'Master-pool scan failed.', false);
                        }
                        activeProgressQueueId = null;
                        refreshJobQueue();
                    })
                    .catch(() => {
                        clearInterval(masterScanStatusPollInterval);
                        masterScanStatusPollInterval = null;
                        document.getElementById('job-status-text').innerText = 'Lost contact while checking master-pool scan progress.';
                        document.getElementById('job-action-container').classList.remove('hidden');
                        document.getElementById('job-review-btn').classList.add('hidden');
                        document.getElementById('job-progress-bar').classList.remove('animate-pulse');
                    });
            };
            poll();
            masterScanStatusPollInterval = setInterval(poll, 1000);
        }

        // Scan Settings Modal & Handlers
        function openScanSettings() {
            const modalToken = showManagedModal('scan-settings-modal');
            document.getElementById('scan-settings-loading').classList.remove('hidden');
            document.getElementById('btn-save-scan-settings').disabled = true;
            document.getElementById('btn-run-organizer-now').disabled = true;
            document.getElementById('btn-run-full-scan-now').disabled = true;
            fetch('/api/admin/scan-settings')
                .then(r => r.json())
                .then(data => {
                    if (!isManagedModalCurrent('scan-settings-modal', modalToken)) return;
                    document.getElementById('sys-rescan-interval').value = data.master_scan_interval || 0;
                    document.getElementById('sys-incremental-scan-interval').value = data.incremental_scan_interval || 0;
                    document.getElementById('sys-auto-approve-metadata').checked = data.auto_approve_metadata === true;
                    document.getElementById('sys-trash-folder').value = data.trash_folder || '';
                    document.getElementById('sys-organizer-script').value = (data.organizer && data.organizer.naming_script) || ['$if2(%albumartist%,%artist%)/', '', '$if2(%album%,%title% \\(Single\\))$if($if2(%originaldate%,%date%), \\($left($if2(%originaldate%,%date%),4)\\),)/', '', '$if($gt(%totaldiscs%,1),%discnumber%-,)', '', '$if(%tracknumber%,$num(%tracknumber%,2) - ,)', '', '$if(%_multiartist%,%artist% - ,)', '', '%title%', '', '$if($eq(%_extension%,flac),$if($eq(%_bits_per_sample%,24), [FLAC 24bit], [FLAC]),$if($eq(%_codec%,ALAC), [ALAC],$if($eq(%_extension%,mp3), [MP3-%_bitrate%k],)))'].join('\n');
                    document.getElementById('sys-organizer-rename').checked = !!(data.organizer && data.organizer.rename_files === '1');

                    currentExemptFolders = data.exempt_folders || [];
                    currentDumpFolders = data.dump_folders || [];
                    systemUsersList = data.users || [];

                    populateUserDropdown();
                    renderExemptFolders();
                    renderDumpFolders();
                    document.getElementById('scan-settings-loading').classList.add('hidden');
                    document.getElementById('btn-save-scan-settings').disabled = false;
                    document.getElementById('btn-run-organizer-now').disabled = false;
                    document.getElementById('btn-run-full-scan-now').disabled = false;

                })
                .catch(() => {
                    if (!isManagedModalCurrent('scan-settings-modal', modalToken)) return;
                    document.getElementById('scan-settings-loading').innerText = 'Could not load settings. Close the modal and try again.';
                    document.getElementById('btn-run-full-scan-now').disabled = true;
                    showAlert('Scan Settings', 'Could not load scan settings.', false);
                });
        }

        function closeScanSettingsModal() { closeManagedModal('scan-settings-modal'); }

        function populateUserDropdown() {
            const select = document.getElementById('new-dump-folder-user-select');
            select.innerHTML = '<option value="">Unassigned / Global</option>';
            systemUsersList.forEach(u => {
                const opt = document.createElement('option');
                opt.value = u.id;
                opt.innerText = u.username;
                select.appendChild(opt);
            });
        }

        function renderExemptFolders() {
            const list = document.getElementById('exempt-folders-list');
            list.innerHTML = '';
            if (currentExemptFolders.length === 0) {
                list.innerHTML = `<div class="text-xs text-[#7a7d90] italic">No exempt folders configured.</div>`;
                return;
            }
            currentExemptFolders.forEach((folder, idx) => {
                const row = document.createElement('div');
                row.className = 'flex items-center justify-between bg-[#000012] p-2.5 rounded-lg border border-[#2a2e43] text-xs';
                row.innerHTML = `
                    <span class="font-mono text-[#ffffff] truncate mr-2">${escapeHtml(folder)}</span>
                    <button onclick="removeExemptFolder(${idx})" class="text-[#ff80a8] hover:text-[#ff3366] transition-colors">Remove</button>
                `;
                list.appendChild(row);
            });
        }

        function addExemptFolder() {
            const input = document.getElementById('new-exempt-folder-input');
            const val = input.value.trim();
            if (val && !currentExemptFolders.includes(val)) {
                currentExemptFolders.push(val);
                input.value = '';
                renderExemptFolders();
            }
        }

        function removeExemptFolder(idx) {
            currentExemptFolders.splice(idx, 1);
            renderExemptFolders();
        }

        function renderDumpFolders() {
            const list = document.getElementById('dump-folders-list');
            list.innerHTML = '';
            if (currentDumpFolders.length === 0) {
                list.innerHTML = `<div class="text-xs text-[#7a7d90] italic">No dump folders configured.</div>`;
                return;
            }
            currentDumpFolders.forEach((item, idx) => {
                const folderPath = typeof item === 'string' ? item : item.path;
                const taggedUserId = typeof item === 'object' ? item.user_id : null;

                const row = document.createElement('div');
                row.className = 'flex flex-col sm:flex-row items-start sm:items-center justify-between bg-[#000012] p-2.5 rounded-lg border border-[#2a2e43] text-xs gap-2';

                let userOptions = `<option value="" ${!taggedUserId ? 'selected' : ''}>Unassigned / Global</option>`;
                systemUsersList.forEach(u => {
                    userOptions += `<option value="${u.id}" ${taggedUserId == u.id ? 'selected' : ''}>${escapeHtml(u.username)}</option>`;
                });

                row.innerHTML = `
                    <span class="font-mono text-[#ffffff] truncate flex-1">${escapeHtml(folderPath)}</span>
                    <div class="flex items-center gap-2 w-full sm:w-auto">
                        <select onchange="updateDumpFolderUser(${idx}, this.value)" class="bg-[#000000] border border-[#2a2e43] text-[#00BBFC] text-xs rounded px-2 py-1 outline-none">
                            ${userOptions}
                        </select>
                        <button onclick="removeDumpFolder(${idx})" class="text-[#ff80a8] hover:text-[#ff3366] transition-colors ml-2">Remove</button>
                    </div>
                `;
                list.appendChild(row);
            });
        }

        function addDumpFolder() {
            const input = document.getElementById('new-dump-folder-input');
            const userSelect = document.getElementById('new-dump-folder-user-select');
            const pathVal = input.value.trim();
            const userVal = userSelect.value ? parseInt(userSelect.value) : null;

            if (pathVal) {
                currentDumpFolders.push({ path: pathVal, user_id: userVal });
                input.value = '';
                userSelect.value = '';
                renderDumpFolders();
            }
        }

        function updateDumpFolderUser(idx, val) {
            const user_id = val ? parseInt(val) : null;
            if (typeof currentDumpFolders[idx] === 'string') {
                currentDumpFolders[idx] = { path: currentDumpFolders[idx], user_id };
            } else {
                currentDumpFolders[idx].user_id = user_id;
            }
        }

        function removeDumpFolder(idx) {
            currentDumpFolders.splice(idx, 1);
            renderDumpFolders();
        }

        function saveScanSettings() {
            const interval = document.getElementById('sys-rescan-interval').value;
            const trashFolder = document.getElementById('sys-trash-folder').value.trim();

            fetch('/api/admin/scan-settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    master_scan_interval: interval,
                    incremental_scan_interval: document.getElementById('sys-incremental-scan-interval').value,
                    auto_approve_metadata: document.getElementById('sys-auto-approve-metadata').checked,
                    exempt_folders: currentExemptFolders,
                    dump_folders: currentDumpFolders,
                    trash_folder: trashFolder,
                    naming_script: document.getElementById('sys-organizer-script').value,
                    organizer_rename_files: document.getElementById('sys-organizer-rename').checked
                })
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    closeScanSettingsModal();
                    showAlert("Scan settings updated successfully.");
                } else {
                    showAlert(res.message || "Failed to save settings.");
                }
            });
        }

        // Organizer Run, Progress, and Review Logic
        function startOrganizerRun() {
            showOrganizerProgressPanel({ status: 'running', progress: 0, total: 0, message: 'Starting organizer...' });
            fetch('/api/admin/organizer/run', { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    if (!res.success) {
                        activeProgressJobType = null;
                        document.getElementById('job-progress-container').classList.add('hidden');
                        showAlert('Organizer', res.message || 'Could not start the organizer.', false);
                        return;
                    }
                    closeScanSettingsModal();
                    pollOrganizerStatus();
                })
                .catch(() => {
                    activeProgressJobType = null;
                    document.getElementById('job-progress-container').classList.add('hidden');
                    showAlert('Organizer Error', 'Could not contact the organizer endpoint.', false);
                });
        }

        function showOrganizerProgressPanel(data) {
            const container = document.getElementById('job-progress-container');
            if (!container) return;
            if (activeProgressJobType !== 'bulk-review') activeProgressJobType = 'organizer';
            container.classList.remove('hidden');
            document.getElementById('job-status-text').innerText = data.message || 'Organizer is working...';
            document.getElementById('job-progress-text').innerText = `${Number(data.progress) || 0} / ${Number(data.total) || 0}`;
            const total = Number(data.total) || 0;
            const progress = Number(data.progress) || 0;
            const terminal = data.status === 'completed' || data.status === 'error';
            document.getElementById('job-progress-bar').style.width = total > 0 ? `${Math.min(100, (progress / total) * 100)}%` : (terminal ? '100%' : '8%');
            document.getElementById('job-progress-bar').classList.toggle('animate-pulse', !terminal && total === 0);
            const actions = document.getElementById('job-action-container');
            const reviewButton = document.getElementById('job-review-btn');
            if (terminal) {
                actions.classList.remove('hidden');
                reviewButton.classList.remove('hidden');
                reviewButton.innerText = 'Open Organizer Review';
                reviewButton.onclick = openOrganizerReviewModal;
            } else {
                actions.classList.add('hidden');
            }
        }

        function pollOrganizerStatus(suppressCompletionAlert = false) {
            const container = document.getElementById('job-progress-container');
            if (container) container.classList.remove('hidden');
            if (organizerStatusPollInterval) return;
            const poll = () => {
                fetch('/api/admin/organizer/status')
                    .then(r => r.json())
                    .then(data => {
                        if (data.status === 'running') {
                            showOrganizerProgressPanel(data);
                            return;
                        }
                        if (data.status === 'completed' || data.status === 'error') {
                            showOrganizerProgressPanel(data);
                            clearInterval(organizerStatusPollInterval);
                            organizerStatusPollInterval = null;
                            refreshOrganizerReviewCount();
                            if (typeof loadCatalog === 'function') loadCatalog();
                            if (document.getElementById('organizer-review-modal') && !document.getElementById('organizer-review-modal').classList.contains('hidden')) {
                                loadOrganizerReview(organizerReviewCurrentPage);
                            }
                            return;
                        }
                        showOrganizerProgressPanel({ status: 'running', progress: 0, total: 0, message: 'Waiting for organizer status...' });
                    })
                    .catch(() => {
                        clearInterval(organizerStatusPollInterval);
                        organizerStatusPollInterval = null;
                        showOrganizerProgressPanel({ status: 'error', progress: 0, total: 0, message: 'Lost contact while checking organizer status.' });
                    });
            };
            poll();
            organizerStatusPollInterval = setInterval(poll, 1000);
        }

        function openOrganizerReviewModal() {
            showManagedModal('organizer-review-modal', 'organizer-review-list', 'Loading organizer review…');
            loadOrganizerReview(1);
        }

        function closeOrganizerReviewModal() {
            organizerReviewLoadToken++;
            closeManagedModal('organizer-review-modal');
        }

        function organizerReviewFilters() {
            return {
                kind: document.getElementById('organizer-review-kind')?.value || 'all',
                search: document.getElementById('organizer-review-search')?.value.trim() || '',
                location: document.getElementById('organizer-review-location')?.value || 'all',
                limit: document.getElementById('organizer-review-limit')?.value || '50'
            };
        }

        function organizerReviewFiltersChanged() {
            if (organizerReviewSearchDebounce) clearTimeout(organizerReviewSearchDebounce);
            organizerSelectedIds.clear();
            organizerSelectAllFiltered = false;
            organizerReviewCurrentPage = 1;
            loadOrganizerReview(1);
        }

        function queueOrganizerReviewSearch() {
            if (organizerReviewSearchDebounce) clearTimeout(organizerReviewSearchDebounce);
            organizerReviewSearchDebounce = setTimeout(organizerReviewFiltersChanged, 300);
        }

        function refreshOrganizerReviewCount() {
            const badge = document.getElementById('organizer-review-count');
            if (!badge) return;
            fetch('/api/admin/organizer/review?limit=10')
                .then(r => r.json())
                .then(data => { if (data.success) badge.innerText = String(data.count || 0); })
                .catch(() => {});
        }

        function loadOrganizerReview(page = organizerReviewCurrentPage) {
            const list = document.getElementById('organizer-review-list');
            if (!list) return;
            const loadToken = ++organizerReviewLoadToken;
            const modalToken = modalRequestGeneration;
            const filters = organizerReviewFilters();
            const requestedPage = Math.max(1, Number(page) || 1);
            list.innerHTML = '<div class="text-sm text-[#7a7d90]">Loading organizer review items...</div>';
            const query = new URLSearchParams({ kind: filters.kind, q: filters.search, location: filters.location, page: String(requestedPage), limit: filters.limit });
            fetch(`/api/admin/organizer/review?${query.toString()}`)
                .then(r => r.json())
                .then(data => {
                    if (loadToken !== organizerReviewLoadToken || !isManagedModalCurrent('organizer-review-modal', modalToken)) return;
                    if (!data.success) {
                        list.innerHTML = `<div class="text-sm text-[#ff80a8]">${escapeHtml(data.message || 'Unable to load review items.')}</div>`;
                        return;
                    }
                    const badge = document.getElementById('organizer-review-count');
                    if (badge) badge.innerText = String(data.count || 0);
                    organizerCurrentItems = data.items || [];
                    organizerReviewCurrentPage = data.page || requestedPage;
                    organizerReviewPages = data.pages || 1;
                    organizerReviewFilteredCount = data.filteredCount || 0;
                    document.getElementById('organizer-review-result-count').innerText = `${data.filteredCount || 0} matching review items · ${data.count || 0} pending total`;
                    document.getElementById('organizer-review-page-info').innerText = `Page ${organizerReviewCurrentPage} of ${organizerReviewPages}`;
                    document.getElementById('organizer-review-prev').disabled = organizerReviewCurrentPage <= 1;
                    document.getElementById('organizer-review-next').disabled = organizerReviewCurrentPage >= organizerReviewPages;
                    document.getElementById('organizer-select-filtered').innerText = organizerSelectAllFiltered
                        ? `All ${data.filteredCount || 0} filtered results selected`
                        : `Select all ${data.filteredCount || 0} filtered results`;
                    const visibleSelect = document.getElementById('organizer-select-visible');
                    visibleSelect.checked = !organizerSelectAllFiltered && organizerCurrentItems.length > 0 && organizerCurrentItems.every(item => organizerSelectedIds.has(Number(item.id)));
                    visibleSelect.disabled = organizerSelectAllFiltered || organizerCurrentItems.length === 0;
                    if (!organizerCurrentItems.length) {
                        list.innerHTML = '<div class="bg-[#000000] border border-[#2a2e43] rounded-xl p-6 text-sm text-[#7a7d90] text-center">No organizer items match these filters.</div>';
                        updateOrganizerSelectionSummary();
                        return;
                    }
                    list.innerHTML = '';
                    organizerCurrentItems.forEach(item => {
                        const row = document.createElement('div');
                        row.className = 'bg-[#000000] border border-[#2a2e43] rounded-xl p-4 space-y-3';
                        const confidence = `${Math.round((Number(item.confidence) || 0) * 100)}%`;
                        const tags = item.tags || {};
                        const embedded = item.embedded || {};
                        const matchedMetadata = item.matched_metadata || {};
                        const category = item.kind === 'duplicate' ? 'Exact Duplicate' : item.kind === 'path_conflict' ? 'Naming-Path Conflict' : item.kind === 'quality_upgrade' ? 'Higher-Quality Version Available' : item.kind === 'similar' ? 'Similar Metadata · Different Path' : item.kind === 'low_match' ? 'Possible Match · Incomplete Tags' : item.kind === 'error' ? 'Organizer Error' : 'Metadata Approval Required';
                        const matchedBlock = item.matched_path
                            ? (item.match_is_meaningful
                                ? `<div><span class="text-[#00BBFC] font-semibold">Compared with existing pool file:</span><div class="font-mono text-xs text-[#d5d7e0] break-all mt-1">${escapeHtml(item.matched_path)}</div><div class="text-[11px] text-[#7a7d90] mt-1">Metadata match confidence: ${confidence}${item.matched_exists ? '' : ' · recorded match path is missing'}</div></div>`
                                : `<div><span class="text-[#A05AFA] font-semibold">Naming destination is occupied:</span><div class="font-mono text-xs text-[#d5d7e0] break-all mt-1">${escapeHtml(item.matched_path)}</div><div class="text-[11px] text-[#7a7d90] mt-1">The embedded metadata does not support identifying this as the same song. This is a path conflict, not a duplicate match.</div></div>`)
                            : '<div class="text-xs text-[#7a7d90]">No existing pool file has been linked as a metadata match.</div>';
                        const metadataBlock = item.matched_path && item.match_is_meaningful
                            ? renderOrganizerMetadataComparison(embedded, matchedMetadata)
                            : renderOrganizerMetadataFallback(embedded, tags);
                        let actions = '';
                        if (item.candidate_in_trash) {
                            actions += `<button onclick="resolveOrganizerReview(${item.id}, 'delete')" class="px-3 py-2 rounded-lg bg-[#61152b] hover:bg-[#8b1b3d] text-xs font-semibold">Delete Candidate (Trash)</button>`;
                        } else {
                            actions += `<button onclick="resolveOrganizerReview(${item.id}, 'stage_trash')" class="px-3 py-2 rounded-lg bg-[#814AC8] hover:bg-[#A05AFA] text-xs font-semibold">Move Candidate to Trash</button>`;
                        }
                        if (item.matched_path) {
                            if (item.matched_exists && item.is_quality_upgrade) {
                                actions += `<button onclick="resolveOrganizerReview(${item.id}, 'upgrade')" class="px-3 py-2 rounded-lg bg-[#1A76C9] hover:bg-[#0092FC] text-xs font-semibold">Upgrade Pool Version</button>`;
                            } else if (item.matched_exists && item.can_overwrite) {
                                // Keep the explicit admin override for meaningful possible matches.
                                actions += `<button onclick="resolveOrganizerReview(${item.id}, 'overwrite')" class="px-3 py-2 rounded-lg bg-[#713CCC] hover:bg-[#8A48FF] text-xs font-semibold">Overwrite Pool Song</button>`;
                            }
                            if (item.kind !== 'duplicate') {
                                actions += `<button onclick="resolveOrganizerReview(${item.id}, 'keep_both')" class="px-3 py-2 rounded-lg bg-[#2C53CA] hover:bg-[#2B66FD] text-xs font-semibold">Keep Both / Organize Separately</button>`;
                            }
                        } else {
                            actions += `<button onclick="resolveOrganizerReview(${item.id}, 'approve')" class="px-3 py-2 rounded-lg bg-[#2C53CA] hover:bg-[#2B66FD] text-xs font-semibold">Approve &amp; Organize</button>`;
                        }
                        if (!item.candidate_in_trash) {
                            actions += `<button onclick="resolveOrganizerReview(${item.id}, 'keep_dump')" class="px-3 py-2 rounded-lg bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] text-xs font-semibold">Keep in Dump</button>`;
                        }
                        const isSelected = organizerSelectAllFiltered || organizerSelectedIds.has(Number(item.id));
                        row.innerHTML = `
                            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2">
                                <div class="flex gap-3 min-w-0">
                                    <input type="checkbox" class="mt-1 accent-[#2B66FD] shrink-0" aria-label="Select review item ${item.id}" ${isSelected ? 'checked' : ''} ${organizerSelectAllFiltered ? 'disabled' : ''} onchange="toggleOrganizerItemSelection(${item.id}, this.checked)">
                                    <div class="min-w-0">
                                        <div class="text-sm font-semibold text-[#ffffff]">${escapeHtml(category)}</div>
                                        <div class="text-xs text-[#b4b7c5] mt-1">${escapeHtml(item.reason || '')}</div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 self-start shrink-0">
                                    <span class="text-[10px] uppercase tracking-wider text-[#00BBFC] border border-[#216281] rounded-md px-2 py-1">${escapeHtml(item.kind)}</span>
                                    <span class="text-[10px] text-[#7a7d90]">#${item.id}</span>
                                </div>
                            </div>
                            <div><div class="text-[10px] uppercase tracking-wider text-[#7a7d90] mb-1">Candidate file</div><div class="font-mono text-xs text-[#ffffff] break-all">${escapeHtml(item.candidate_path || item.source_path || '')}</div></div>
                            ${matchedBlock}
                            ${metadataBlock}
                            ${item.planned_path ? `<div><div class="text-[10px] uppercase tracking-wider text-[#7a7d90] mb-1">Planned destination</div><div class="font-mono text-xs text-[#b4b7c5] break-all">${escapeHtml(item.planned_path)}</div></div>` : `<div><div class="text-[10px] uppercase tracking-wider text-[#7a7d90] mb-1">Planned destination</div><div class="font-mono text-xs text-[#ff80a8] break-all">Not generated — the naming script needs more usable tag values, or it produced an invalid path.</div></div>`}
                            <div class="text-[11px] text-[#7a7d90]">${item.is_quality_upgrade ? 'The candidate appears to be a better-quality encoding. Upgrade preserves the existing pool version in Trash and updates the catalog to the new path.' : item.matched_path ? (item.can_overwrite ? 'Overwrite is available for this meaningful possible match. MILO preserves the old pool file in Trash first. Keep Both organizes this candidate separately.' : (item.match_is_meaningful ? 'The metadata suggests the same track, but overwrite is not available for this file format or evidence level. Keep Both preserves both files.' : 'This path is occupied by a file whose embedded metadata does not identify it as the same song. Overwrite is disabled; Keep Both preserves both files.')) : 'Approve & Organize explicitly allows this reviewed file into the pool using your naming script. Incomplete embedded metadata is never organized automatically.'}</div>
                            <div class="flex flex-wrap gap-2 pt-1">${actions}</div>
                        `;
                        list.appendChild(row);
                    });
                    updateOrganizerSelectionSummary();
                })
                .catch(() => { list.innerHTML = '<div class="text-sm text-[#ff80a8]">Could not contact the organizer review endpoint.</div>'; });
        }

        function organizerMetadataValue(tags, field) {
            tags = tags || {};
            if (field === 'artist') return tags.artist || '';
            if (field === 'albumartist') return tags.albumartist || '';
            if (field === 'date') return tags.originaldate || tags.date || '';
            if (field === 'track') return tags.tracknumber || '';
            if (field === 'disc') return tags.totaldiscs ? `${tags.discnumber || '?'} / ${tags.totaldiscs}` : (tags.discnumber || '');
            if (field === 'duration') return Number(tags.duration) > 0 ? formatOrganizerDuration(tags.duration) : '';
            if (field === 'format') return tags._codec || String(tags._extension || '').toUpperCase();
            if (field === 'bitrate') return tags._bitrate ? `${tags._bitrate} kbps` : '';
            return tags[field] || '';
        }

        function formatOrganizerDuration(value) {
            const seconds = Number(value);
            if (!Number.isFinite(seconds) || seconds <= 0) return 'Unknown';
            const total = Math.round(seconds);
            const hours = Math.floor(total / 3600);
            const minutes = Math.floor((total % 3600) / 60);
            const remaining = total % 60;
            return hours > 0 ? `${hours}:${String(minutes).padStart(2, '0')}:${String(remaining).padStart(2, '0')}` : `${minutes}:${String(remaining).padStart(2, '0')}`;
        }

        function organizerCompareEqual(field, left, right) {
            if (!left || !right || left === 'Unknown' || right === 'Unknown') return null;
            if (field === 'duration') return Math.abs(Number(left) - Number(right)) <= 1.5;
            const normalize = value => String(value).normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/[^\p{L}\p{N}]+/gu, ' ').trim().toLowerCase();
            return normalize(left) === normalize(right);
        }

        function renderOrganizerMetadataComparison(candidate, matched) {
            const fields = [['Title', 'title'], ['Artist', 'artist'], ['Album Artist', 'albumartist'], ['Album', 'album'], ['Original Date / Date', 'date'], ['Track', 'track'], ['Disc', 'disc'], ['Duration', 'duration'], ['Format / Codec', 'format'], ['Bitrate', 'bitrate']];
            const rows = fields.map(([label, field]) => {
                const leftRaw = organizerMetadataValue(candidate, field);
                const rightRaw = organizerMetadataValue(matched, field);
                const left = leftRaw || 'Missing';
                const right = rightRaw || 'Missing';
                const equal = field === 'duration'
                    ? organizerCompareEqual(field, candidate.duration, matched.duration)
                    : organizerCompareEqual(field, leftRaw, rightRaw);
                const status = equal === null ? 'Not enough data' : equal ? 'Match' : 'Different';
                const statusClass = equal === null ? 'text-[#7a7d90]' : equal ? 'text-[#00BBFC]' : 'text-[#ff80a8]';
                return `<tr class="border-t border-[#2a2e43]"><td class="p-2 text-[#7a7d90] whitespace-nowrap">${label}</td><td class="p-2 text-[#ffffff] break-words">${escapeHtml(left)}</td><td class="p-2 text-[#ffffff] break-words">${escapeHtml(right)}</td><td class="p-2 ${statusClass} whitespace-nowrap">${status}</td></tr>`;
            }).join('');
            return `<div class="bg-[#000012] border border-[#216281] rounded-lg overflow-hidden"><div class="p-3 text-[10px] uppercase tracking-wider text-[#00BBFC] font-semibold">Embedded metadata comparison</div><div class="overflow-x-auto"><table class="w-full text-xs text-left"><thead class="bg-[#000000] text-[#b4b7c5]"><tr><th class="p-2 font-semibold">Field</th><th class="p-2 font-semibold">Candidate (embedded)</th><th class="p-2 font-semibold">Existing pool file</th><th class="p-2 font-semibold">Comparison</th></tr></thead><tbody>${rows}</tbody></table></div></div>`;
        }

        function renderOrganizerMetadataFallback(embedded, suggested) {
            const fields = [['Title', 'title'], ['Artist', 'artist'], ['Album Artist', 'albumartist'], ['Album', 'album'], ['Original Date / Date', 'date'], ['Track', 'track'], ['Disc', 'disc'], ['Duration', 'duration']];
            const embeddedCell = (tags, field) => escapeHtml(organizerMetadataValue(tags, field) || 'Missing');
            const hintFields = [
                ['Title from filename', suggested.source_path_title || (!embedded.title ? suggested.title : '')],
                ['Artist from folders', suggested.source_path_artist || (!embedded.artist && !embedded.albumartist ? suggested.artist : '')],
                ['Album from folders', suggested.source_path_album || (!embedded.album ? suggested.album : '')]
            ];
            const hintCell = value => escapeHtml(value || 'No path clue');
            return `<div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs"><div class="bg-[#000012] border border-[#2a2e43] rounded-lg p-3"><div class="text-[10px] uppercase tracking-wider text-[#00BBFC] mb-2">Candidate embedded metadata</div>${fields.map(([label, field]) => `<div class="grid grid-cols-[8rem_1fr] gap-2 py-1 border-t border-[#2a2e43]/70"><span class="text-[#7a7d90]">${label}</span><span class="text-[#d5d7e0] break-words">${embeddedCell(embedded, field)}</span></div>`).join('')}</div><div class="bg-[#000012] border border-[#2a2e43] rounded-lg p-3"><div class="text-[10px] uppercase tracking-wider text-[#7a7d90] mb-2">Path / filename clues only — not embedded tags</div>${hintFields.map(([label, value]) => `<div class="grid grid-cols-[8rem_1fr] gap-2 py-1 border-t border-[#2a2e43]/70"><span class="text-[#7a7d90]">${label}</span><span class="text-[#d5d7e0] break-words">${hintCell(value)}</span></div>`).join('')}</div></div>`;
        }

        function updateOrganizerSelectionSummary() {
            const summary = document.getElementById('organizer-selection-summary');
            if (!summary) return;
            summary.innerText = organizerSelectAllFiltered
                ? `${organizerReviewFilteredCount} filtered items selected`
                : `${organizerSelectedIds.size} selected across pages`;
        }

        function toggleOrganizerItemSelection(id, checked) {
            const key = Number(id);
            if (checked) organizerSelectedIds.add(key);
            else organizerSelectedIds.delete(key);
            const visibleSelect = document.getElementById('organizer-select-visible');
            if (visibleSelect) visibleSelect.checked = !organizerSelectAllFiltered && organizerCurrentItems.length > 0 && organizerCurrentItems.every(item => organizerSelectedIds.has(Number(item.id)));
            updateOrganizerSelectionSummary();
        }

        function toggleOrganizerVisibleSelection(checked) {
            if (organizerSelectAllFiltered) return;
            organizerCurrentItems.forEach(item => {
                const key = Number(item.id);
                if (checked) organizerSelectedIds.add(key);
                else organizerSelectedIds.delete(key);
            });
            loadOrganizerReview(organizerReviewCurrentPage);
        }

        function selectAllOrganizerFiltered() {
            if (!organizerReviewFilteredCount) return;
            organizerSelectAllFiltered = true;
            organizerSelectedIds.clear();
            loadOrganizerReview(organizerReviewCurrentPage);
        }

        function clearOrganizerSelection() {
            organizerSelectAllFiltered = false;
            organizerSelectedIds.clear();
            loadOrganizerReview(organizerReviewCurrentPage);
        }

        async function runOrganizerBulkAction() {
            const action = document.getElementById('organizer-bulk-action').value;
            if (!organizerSelectAllFiltered && !organizerSelectedIds.size) {
                showAlert('Organizer Review', 'Select one or more review items first.', false);
                return;
            }
            if (action === 'delete' && !(await showConfirm('Delete Candidates', 'Permanently delete selected candidates that are physically inside the configured Trash folder? Items outside Trash will fail safely.', 'Delete'))) return;
            if (action === 'overwrite' && !(await showConfirm('Overwrite Pool Songs', 'Overwrite the matched pool songs? Each existing pool file will first be preserved in Trash. Items without a valid match will fail safely.', 'Overwrite'))) return;
            if (action === 'upgrade' && !(await showConfirm('Upgrade Pool Songs', 'Upgrade selected tracks to a higher-quality version? The existing pool version will be preserved in Trash and the catalog path will be updated.', 'Upgrade'))) return;
            if (action === 'approve' && !(await showConfirm('Approve Unmatched Files', 'Approve and organize selected unmatched files using the saved naming script? Files that have an existing match will not be approved by this action.', 'Approve'))) return;
            const filters = organizerReviewFilters();
            const payload = organizerSelectAllFiltered
                ? { allFiltered: true, filters: { kind: filters.kind, search: filters.search, location: filters.location }, action }
                : { ids: [...organizerSelectedIds], action };
            activeProgressJobType = 'bulk-review';
            closeOrganizerReviewModal();
            showOrganizerProgressPanel({ status: 'running', progress: 0, total: organizerSelectAllFiltered ? organizerReviewFilteredCount : organizerSelectedIds.size, message: 'Starting bulk organizer review...' });
            fetch('/api/admin/organizer/review/bulk', {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
            })
                .then(r => r.json())
                .then(res => {
                    if (!res.success) {
                        activeProgressJobType = null;
                        document.getElementById('job-progress-container').classList.add('hidden');
                        document.getElementById('job-action-container').classList.add('hidden');
                        openOrganizerReviewModal();
                        showAlert('Organizer Review', res.message || 'Bulk action could not be started.', false);
                        return;
                    }
                    organizerSelectedIds.clear();
                    organizerSelectAllFiltered = false;
                    pollOrganizerStatus();
                })
                .catch(() => {
                    activeProgressJobType = null;
                    document.getElementById('job-progress-container').classList.add('hidden');
                    document.getElementById('job-action-container').classList.add('hidden');
                    openOrganizerReviewModal();
                    showAlert('Organizer Error', 'Could not contact the bulk review endpoint.', false);
                });
        }

        async function resolveOrganizerReview(id, action) {
            if (action === 'delete' && !(await showConfirm('Delete Candidate', 'Permanently delete this candidate from the configured Trash folder? This cannot be undone.', 'Delete'))) return;
            if (action === 'overwrite' && !(await showConfirm('Replace Pool Song', 'Replace the matched pool song? The existing pool file will first be preserved in the configured Trash folder.', 'Replace'))) return;
            if (action === 'upgrade' && !(await showConfirm('Upgrade Pool Song', 'Upgrade to this verified higher-quality version? The old pool file will be preserved in Trash and the catalog path updated.', 'Upgrade'))) return;
            fetch(`/api/admin/organizer/review/${id}/action`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action })
            })
            .then(r => r.json())
            .then(res => {
                if (!res.success) {
                    showAlert('Organizer Review', res.message || 'The review action could not be completed.', false);
                    return;
                }
                loadOrganizerReview(organizerReviewCurrentPage);
                refreshOrganizerReviewCount();
                if (typeof loadCatalog === 'function') loadCatalog();
                if (action !== 'stage_trash') showAlert('Organizer Review', res.message || 'Review action completed.', true);
            })
            .catch(() => showAlert('Organizer Error', 'Could not contact the organizer review endpoint.', false));
        }

        // User Manager Modal Logic
        function openUserManager() {
            showManagedModal('user-manager-modal');
            loadUsersList();
            resetUserForm();
        }

        function closeUserManagerModal() { closeManagedModal('user-manager-modal'); }

        function loadUsersList() {
            const tbody = document.getElementById('user-list-tbody');
            tbody.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-xs text-[#7a7d90]">Loading users…</td></tr>';
            fetch('/api/admin/users')
                .then(r => r.json())
                .then(users => {
                    if (activeManagedModalId !== 'user-manager-modal' || document.getElementById('user-manager-modal').classList.contains('hidden')) return;
                    tbody.innerHTML = '';
                    users.forEach(u => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td class="p-3 font-semibold text-[#ffffff]">${escapeHtml(u.username)}</td>
                            <td class="p-3 text-[#b4b7c5]">${escapeHtml(u.role)}</td>
                            <td class="p-3 text-[#00BBFC] font-mono">${escapeHtml(u.index_mode || 'standard')}</td>
                            <td class="p-3 text-[#7a7d90] font-mono">${escapeHtml(u.library_path)}</td>
                            <td class="p-3 text-right space-x-2">
                                <button type="button" data-user-id="${Number(u.id)}" data-username="${escapeHtml(u.username)}" data-library-path="${escapeHtml(u.library_path)}" data-index-mode="${escapeHtml(u.index_mode || 'standard')}" data-role="${escapeHtml(u.role || 'user')}" onclick="editUserFromButton(this)" class="text-[#00BBFC] hover:underline">Edit</button>
                                ${u.role !== 'admin' ? `<button onclick="deleteUser(${u.id})" class="text-[#ff80a8] hover:underline">Delete</button>` : ''}
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                });
        }

        function editUserFromButton(button) {
            if (!button) return;
            editUser(Number(button.dataset.userId), button.dataset.username || '', button.dataset.libraryPath || '', button.dataset.indexMode || 'standard', button.dataset.role || 'user');
        }

        function resetUserForm() {
            document.getElementById('edit-user-id').value = '';
            document.getElementById('um-username').value = '';
            document.getElementById('um-password').value = '';
            document.getElementById('um-library-path').value = '';
            document.getElementById('um-index-mode').value = 'standard';
            document.getElementById('um-role').value = 'user';
            document.getElementById('user-form-title').innerText = 'Add New User';
            document.getElementById('um-submit-btn').innerText = 'Create User';
        }

        function editUser(id, username, path, mode, role = 'user') {
            document.getElementById('edit-user-id').value = id;
            document.getElementById('um-username').value = username;
            document.getElementById('um-password').value = '';
            document.getElementById('um-library-path').value = path;
            document.getElementById('um-index-mode').value = mode || 'standard';
            document.getElementById('um-role').value = role === 'admin' ? 'admin' : 'user';
            document.getElementById('user-form-title').innerText = 'Edit User: ' + username;
            document.getElementById('um-submit-btn').innerText = 'Save Changes';
        }

        async function handleUserFormSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('edit-user-id').value;
            const payload = {
                username: document.getElementById('um-username').value,
                password: document.getElementById('um-password').value,
                library_path: document.getElementById('um-library-path').value,
                index_mode: document.getElementById('um-index-mode').value,
                role: document.getElementById('um-role').value
            };
            const button = document.getElementById('um-submit-btn');
            const priorLabel = button.innerText;
            button.disabled = true;
            button.innerText = 'Saving…';
            try {
                const response = await fetch(id ? `/api/admin/users/${id}` : '/api/admin/users', {
                    method: id ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not save user settings.');
                resetUserForm();
                if (result.task === 'library-path-migration') {
                    closeUserManagerModal();
                    showSecondaryProgressPanel({ status: 'running', progress: 0, total: 0, message: result.message }, 'library-path', 'Open User Management', openUserManager);
                    pollLibraryPathJobStatus();
                } else {
                    loadUsersList();
                    showAlert(id ? 'User Updated' : 'User Created', result.message || (id ? 'User updated.' : 'User created.'), true);
                }
            } catch (error) {
                showAlert('User Settings', error.message || 'Could not save user settings.', false);
            } finally {
                button.disabled = false;
                button.innerText = priorLabel;
            }
        }

        async function deleteUser(id) {
            if (!(await showConfirm('Delete User', 'Are you sure you want to delete this user? MILO will remove managed library links and their assignments/logs, while leaving unrelated files untouched.', 'Delete User'))) return;
            try {
                const response = await fetch(`/api/admin/users/${id}`, { method: 'DELETE' });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not delete this user.');
                if (result.task === 'user-delete') {
                    closeUserManagerModal();
                    showSecondaryProgressPanel({ status: 'running', progress: 0, total: 0, message: result.message }, 'library-path', 'Open User Management', openUserManager);
                    pollLibraryPathJobStatus();
                } else {
                    loadUsersList();
                    showAlert('User Deleted', result.message || 'User deleted.', true);
                }
            } catch (error) {
                showAlert('Delete User', error.message || 'Could not delete this user.', false);
            }
        }

        async function pollLibraryPathJobStatus(suppressCompletionAlert = false) {
            if (libraryPathStatusPollInterval) clearInterval(libraryPathStatusPollInterval);
            let inFlight = false;
            const poll = async () => {
                if (inFlight) return;
                inFlight = true;
                try {
                    const response = await fetch('/api/admin/users/library-path/job-status', { cache: 'no-store' });
                    const job = await response.json();
                    if (!response.ok) throw new Error(job.message || 'Could not read user-library task progress.');
                    showSecondaryProgressPanel(job, 'library-path', 'Open User Management', openUserManager);
                    if (job.status === 'completed' || job.status === 'error') {
                        clearInterval(libraryPathStatusPollInterval);
                        libraryPathStatusPollInterval = null;
                        if (job.task === 'user-delete' || job.task === 'library-path-migration') {
                            loadUsersListIfOpen();
                            // A prior completed scan may still be the server's globally

                            fetch('/api/catalog/scan-status', { cache: 'no-store' })
                                .then(r => r.ok ? r.json() : null)
                                .then(scan => {
                                    if (scan && (scan.status === 'completed' || scan.status === 'error')) {
                                        return fetch('/api/catalog/scan-dismiss', { method: 'POST' });
                                    }
                                }).catch(() => {});
                        }
                        if (!suppressCompletionAlert) showAlert('User Library', job.message || 'User library task finished.', job.status === 'completed');
                    }
                } catch (error) {
                    const status = document.getElementById('job-status-text');
                    if (status) status.innerText = `${error.message || 'Connection interrupted while checking user-library progress.'} Retrying…`;
                } finally { inFlight = false; }
            };
            libraryPathStatusPollInterval = setInterval(poll, 800);
            poll();
        }

        function loadUsersListIfOpen() {
            const modal = document.getElementById('user-manager-modal');
            if (modal && !modal.classList.contains('hidden') && activeManagedModalId === 'user-manager-modal') loadUsersList();
        }

        function openDeadFilesModal() {
            const modalToken = showManagedModal('dead-files-modal', 'dead-files-container', 'Checking catalog folders for missing files, then matching indexed metadata for replacements…');
            document.getElementById('dead-files-count').innerText = 'Checking catalog folders…';
            fetch('/api/admin/dead-files')
                .then(async response => {
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.message || 'Could not load missing catalog entries.');
                    return data;
                })
                .then(files => {
                    if (!isManagedModalCurrent('dead-files-modal', modalToken)) return;
                    const container = document.getElementById('dead-files-container');
                    container.innerHTML = '';
                    deadFileRepairChoices = new Map();
                    if (!Array.isArray(files)) {
                        container.innerHTML = `<div class="text-xs text-[#ff80a8] text-center p-4">${escapeHtml(files.message || 'Could not load missing catalog entries.')}</div>`;
                        document.getElementById('dead-files-count').innerText = 'Unable to load missing files';
                        updateDeadFileSelectionUI();
                        return;
                    }
                    document.getElementById('dead-files-count').innerText = `${files.length} dead catalog entries detected`;
                    if (!files.length) {
                        deadFileSelectedIds.clear();
                        container.innerHTML = `<div class="text-xs text-[#7a7d90] text-center p-4">No missing catalog files detected.</div>`;
                    } else {
                        files.forEach(f => {
                            const row = document.createElement('div');
                            row.className = 'bg-[#000012] border border-[#2a2e43] rounded-lg p-3 space-y-2';
                            const replacement = f.replacement;
                            const deadId = Number(f.id);
                            if (replacement && replacement.path) deadFileRepairChoices.set(deadId, replacement.path);
                            const selectable = !!(replacement && replacement.path);
                            const selected = deadFileSelectedIds.has(deadId) && selectable;
                            row.innerHTML = `
                                <div class="flex items-start gap-2">
                                    <input type="checkbox" ${selectable ? '' : 'disabled'} ${selected ? 'checked' : ''} onchange="toggleDeadFileSelection(${deadId}, this.checked)" class="mt-1 accent-[#2B66FD] disabled:opacity-30" aria-label="Select ${escapeHtml(f.title || 'catalog entry')} for repair">
                                    <div class="text-sm font-semibold text-[#ffffff] min-w-0">${escapeHtml(f.artist || 'Unknown artist')} — ${escapeHtml(f.title || 'Unknown title')}</div>
                                </div>
                                <div><div class="text-[10px] uppercase text-[#7a7d90] mb-1">Missing catalog path</div><div class="font-mono text-xs text-[#ff80a8] break-all">${escapeHtml(f.path || '')}</div></div>
                                ${f.album ? `<div class="text-[11px] text-[#7a7d90]">Album: ${escapeHtml(f.album)}</div>` : ''}
                                ${replacement ? `<div class="border-t border-[#2a2e43] pt-2 space-y-1"><div class="text-[10px] uppercase text-[#00BBFC]">Possible replacement · ${escapeHtml(replacement.format || 'Audio')}${replacement.is_higher_quality ? ' · Higher quality' : ''}</div><div class="font-mono text-xs text-[#d5d7e0] break-all">${escapeHtml(replacement.path)}</div><div class="text-[11px] text-[#b4b7c5]">${escapeHtml(replacement.artist || 'Unknown artist')} — ${escapeHtml(replacement.title || 'Unknown title')}${replacement.album ? ` · ${escapeHtml(replacement.album)}` : ''}</div><div class="text-[11px] text-[#7a7d90]">${replacement.duration ? `Duration: ${formatOrganizerDuration(replacement.duration)}` : 'Duration: Unknown'}${replacement.bitrate ? ` · ${escapeHtml(String(replacement.bitrate))} kbps` : ''}${replacement.bit_depth ? ` · ${escapeHtml(String(replacement.bit_depth))}-bit` : ''} · Missing entry format: ${escapeHtml(f.missing_format || 'Unknown')}</div><div class="text-[11px] ${replacement.album_match ? 'text-[#00BBFC]' : 'text-[#A05AFA]'}">${escapeHtml(replacement.message || '')}</div><button data-dead-id="${deadId}" data-replacement="${escapeHtml(replacement.path)}" onclick="repairDeadFileFromButton(this)" class="mt-1 px-3 py-2 rounded-lg bg-[#1A76C9] hover:bg-[#0092FC] text-xs font-semibold">Repair Catalog Path</button></div>` : (f.ambiguous_matches ? `<div class="text-[11px] text-[#A05AFA]">Several files have matching title and artist metadata, and there is no unique replacement. Run a rescan or verify the files manually.</div>` : `<div class="text-[11px] text-[#7a7d90]">No replacement with matching embedded title and artist was found.</div>`)}
                                <div class="flex justify-end border-t border-[#2a2e43] pt-2"><button onclick="clearDeadFile(${deadId})" class="px-3 py-2 rounded-lg bg-[#330816] hover:bg-[#66112c] text-xs font-semibold text-[#ff80a8]">Clear Stale Catalog Entry</button></div>
                            `;
                            container.appendChild(row);
                        });
                    }
                    for (const id of [...deadFileSelectedIds]) {
                        if (!deadFileRepairChoices.has(id)) deadFileSelectedIds.delete(id);
                    }
                    updateDeadFileSelectionUI();
                })
                .catch(error => {
                    if (!isManagedModalCurrent('dead-files-modal', modalToken)) return;
                    document.getElementById('dead-files-container').innerHTML = `<div class="text-xs text-[#ff80a8] text-center p-4">${escapeHtml(error.message || 'Could not contact the Dead Files endpoint.')}</div>`;
                    document.getElementById('dead-files-count').innerText = 'Unable to load missing files';
                    updateDeadFileSelectionUI();
                });
        }

        function updateDeadFileSelectionUI() {
            const selectedCount = [...deadFileSelectedIds].filter(id => deadFileRepairChoices.has(id)).length;
            const repairableCount = deadFileRepairChoices.size;
            const count = document.getElementById('dead-files-selection-count');
            const master = document.getElementById('dead-files-select-repairable');
            const button = document.getElementById('btn-repair-dead-selected');
            if (count) count.innerText = `${selectedCount} selected · ${repairableCount} repairable`;
            if (button) button.disabled = selectedCount === 0;
            if (master) {
                master.checked = repairableCount > 0 && selectedCount === repairableCount;
                master.indeterminate = selectedCount > 0 && selectedCount < repairableCount;
                master.disabled = repairableCount === 0;
            }
        }

        function toggleDeadFileSelection(id, checked) {
            const deadId = Number(id);
            if (!deadFileRepairChoices.has(deadId)) return;
            if (checked) deadFileSelectedIds.add(deadId);
            else deadFileSelectedIds.delete(deadId);
            updateDeadFileSelectionUI();
        }

        function toggleDeadFileAllSelection(checked) {
            if (checked) for (const id of deadFileRepairChoices.keys()) deadFileSelectedIds.add(Number(id));
            else deadFileSelectedIds.clear();
            document.querySelectorAll('#dead-files-container input[type="checkbox"]').forEach(input => {
                if (!input.disabled) input.checked = !!checked;
            });
            updateDeadFileSelectionUI();
        }

        function showSecondaryProgressPanel(data, jobType, actionLabel, actionHandler) {
            const container = document.getElementById('job-progress-container');
            if (!container) return;
            activeProgressJobType = jobType;
            container.classList.remove('hidden');
            document.getElementById('job-status-text').innerText = data.message || 'Processing selected items…';
            const progress = Number(data.progress) || 0;
            const total = Number(data.total) || 0;
            document.getElementById('job-progress-text').innerText = `${progress.toLocaleString()} / ${total.toLocaleString()}`;
            const terminal = data.status === 'completed' || data.status === 'error';
            document.getElementById('job-progress-bar').style.width = total > 0 ? `${Math.min(100, (progress / total) * 100)}%` : (terminal ? '100%' : '8%');
            document.getElementById('job-progress-bar').classList.toggle('animate-pulse', !terminal && (total === 0 || progress === 0));
            const actions = document.getElementById('job-action-container');
            const reviewButton = document.getElementById('job-review-btn');
            if (terminal) {
                actions.classList.remove('hidden');
                reviewButton.classList.remove('hidden');
                reviewButton.innerText = actionLabel;
                reviewButton.onclick = actionHandler;
            } else {
                actions.classList.add('hidden');
            }
        }

        async function startDeadFileTask(endpoint, payload, initialMessage) {
            closeDeadFilesModal();
            showSecondaryProgressPanel({ status: 'running', progress: 0, total: payload && payload.items ? payload.items.length : 0, message: initialMessage }, 'dead-files-bulk', 'Open Dead Files', openDeadFilesModal);
            try {
                const response = await fetch(endpoint, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload || {})
                });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not start the Dead Files task.');
                deadFileSelectedIds.clear();
                pollDeadFileJobStatus();
            } catch (error) {
                activeProgressJobType = null;
                document.getElementById('job-progress-container').classList.add('hidden');
                document.getElementById('job-action-container').classList.add('hidden');
                openDeadFilesModal();
                showAlert('Dead Files', error.message || 'Could not start the Dead Files task.', false);
            }
        }

        async function pollDeadFileJobStatus(suppressCompletionAlert = false) {
            if (deadFileStatusPollInterval) clearInterval(deadFileStatusPollInterval);
            let inFlight = false;
            const poll = async () => {
                if (inFlight) return;
                inFlight = true;
                try {
                    const response = await fetch('/api/admin/dead-files/job-status');
                    const job = await response.json();
                    if (!response.ok) throw new Error(job.message || 'Could not read Dead Files progress.');
                    showSecondaryProgressPanel(job, 'dead-files-bulk', 'Open Dead Files', openDeadFilesModal);
                    if (job.status === 'completed' || job.status === 'error') {
                        clearInterval(deadFileStatusPollInterval);
                        deadFileStatusPollInterval = null;
                        loadCatalog();
                        const result = job.result || {};
                        const summary = job.task === 'dead-files-purge'
                            ? `${job.message}${job.status === 'completed' ? ` Cleared ${Number(result.purged) || 0} catalog entr${Number(result.purged) === 1 ? 'y' : 'ies'}.` : ''}`
                            : `${job.message}${Array.isArray(result.items) ? '\n' + result.items.filter(item => !item.success).slice(0, 5).map(item => `
                        if (!suppressCompletionAlert) showAlert('Dead Files', summary, job.status === 'completed' && !(Number(result.failed) > 0));
                    }
                } catch (error) {
                    document.getElementById('job-status-text').innerText = `${error.message || 'Connection interrupted while checking progress.'} Retrying…`;
                } finally {
                    inFlight = false;
                }
            };
            deadFileStatusPollInterval = setInterval(poll, 800);
            poll();
        }

        async function repairSelectedDeadFiles() {
            const items = [...deadFileSelectedIds]
                .filter(id => deadFileRepairChoices.has(id))
                .map(id => ({ id: Number(id), replacement_path: deadFileRepairChoices.get(id) }));
            if (!items.length) {
                showAlert('Dead Files', 'Select one or more entries with a verified replacement first.', false);
                return;
            }
            if (!(await showConfirm('Repair Selected Catalog Paths', `Repair ${items.length} selected catalog entr${items.length === 1 ? 'y' : 'ies'} to their verified replacement files? Existing library assignments will be preserved.`, 'Repair Selected'))) return;
            return startDeadFileTask('/api/admin/dead-files/repair/bulk', { items }, `Starting catalog repair for ${items.length} selected entr${items.length === 1 ? 'y' : 'ies'}...`);
        }

        async function repairDeadFileFromButton(button) {
            const deadId = Number(button.dataset.deadId);
            const replacementPath = button.dataset.replacement;
            if (!(await showConfirm('Repair Catalog Path', `Repair catalog entry #${deadId} to this file?\n\n${replacementPath}\n\nExisting library assignments will be preserved.`, 'Repair Path'))) return;
            return startDeadFileTask('/api/admin/dead-files/repair/bulk', {
                items: [{ id: deadId, replacement_path: replacementPath }]
            }, `Starting repair for catalog entry #${deadId}...`);
        }

        async function clearDeadFile(id) {
            if (!(await showConfirm('Clear Dead Catalog Entry', `Clear stale catalog entry #${id}? This removes only the catalog record and associated library links; it does not delete audio files.`, 'Clear Entry'))) return;
            try {
                const response = await fetch(`/api/admin/dead-files/${id}`, { method: 'DELETE' });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not clear this catalog entry.');
                deadFileSelectedIds.delete(Number(id));
                showAlert('Dead Files', 'Stale catalog entry cleared.', true);
                loadCatalog();
                openDeadFilesModal();
            } catch (error) { showAlert('Dead Files', error.message || 'Could not contact the catalog repair endpoint.', false); }
        }

        function closeDeadFilesModal() { closeManagedModal('dead-files-modal'); }

        async function purgeDeadFiles() {
            if (!(await showConfirm('Clear Dead Catalog Entries', 'Check the catalog for stale entries pointing to missing files, then remove those catalog records? This does not delete audio files.', 'Purge Dead Entries'))) return;
            return startDeadFileTask('/api/admin/dead-files/purge', {}, 'Starting Dead Files catalog check...');
        }

        let queueRefreshInFlight = false;
        let queueRefreshTimer = null;
        let jobQueueExpanded = false;

        function positionJobQueuePanel() {
            const panel = document.getElementById('job-queue-panel');
            const indicator = document.getElementById('job-queue-indicator');
            if (!panel || !indicator || !jobQueueExpanded || panel.classList.contains('hidden')) return;

            if (!window.matchMedia('(max-width: 639px)').matches) {
                panel.style.position = '';
                panel.style.left = '';
                panel.style.right = '';
                panel.style.top = '';
                panel.style.bottom = '';
                panel.style.width = '';
                panel.style.maxWidth = '';
                return;
            }

            const triggerRect = indicator.getBoundingClientRect();
            const viewportWidth = document.documentElement.clientWidth || window.innerWidth;
            const viewportHeight = window.innerHeight;
            const width = Math.max(0, Math.min(Math.round(viewportWidth * 0.88), 520, viewportWidth - 32));
            const left = Math.max(16, Math.min(triggerRect.left, viewportWidth - width - 16));
            const panelHeight = Math.min(panel.scrollHeight || viewportHeight * 0.65, viewportHeight * 0.65);
            let top = triggerRect.bottom + 8;
            if (top + panelHeight > viewportHeight - 12) top = triggerRect.top - panelHeight - 8;
            top = Math.max(12, Math.min(top, viewportHeight - panelHeight - 12));

            panel.style.position = 'fixed';
            panel.style.left = `${left}px`;
            panel.style.right = 'auto';
            panel.style.top = `${top}px`;
            panel.style.bottom = 'auto';
            panel.style.width = `${width}px`;
            panel.style.maxWidth = `calc(100vw - 32px)`;
        }

        function toggleJobQueueDetails(event) {

            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            const panel = document.getElementById('job-queue-panel');
            const indicator = document.getElementById('job-queue-indicator');
            const chevron = document.getElementById('job-queue-indicator-chevron');
            if (!panel || !indicator || indicator.classList.contains('hidden')) return;
            jobQueueExpanded = !jobQueueExpanded;
            panel.classList.toggle('hidden', !jobQueueExpanded);
            indicator.setAttribute('aria-expanded', String(jobQueueExpanded));
            if (chevron) chevron.classList.toggle('rotate-180', jobQueueExpanded);
            if (jobQueueExpanded) positionJobQueuePanel();
            else {
                panel.style.position = '';
                panel.style.left = '';
                panel.style.right = '';
                panel.style.top = '';
                panel.style.bottom = '';
                panel.style.width = '';
                panel.style.maxWidth = '';
            }
        }

        async function refreshJobQueue() {
            if (queueRefreshInFlight) return;
            queueRefreshInFlight = true;
            try {
                const response = await fetch('/api/job-queue', { cache: 'no-store' });
                if (!response.ok) return;
                const data = await response.json();

                const tasks = (Array.isArray(data.tasks) ? data.tasks : [])
                    .filter(task => currentViewerIsAdmin || task.ownedByViewer === true);
                const panel = document.getElementById('job-queue-panel');
                const list = document.getElementById('job-queue-list');
                const summary = document.getElementById('job-queue-summary');
                const indicator = document.getElementById('job-queue-indicator');
                const indicatorCount = document.getElementById('job-queue-indicator-count');
                const indicatorDot = document.getElementById('job-queue-indicator-dot');
                const indicatorChevron = document.getElementById('job-queue-indicator-chevron');
                if (!panel || !list || !summary || !indicator || !indicatorCount) return;
                if (!tasks.length) {
                    indicator.classList.add('hidden');
                    panel.classList.add('hidden');
                    indicator.setAttribute('aria-expanded', 'false');
                    if (indicatorChevron) indicatorChevron.classList.remove('rotate-180');
                    jobQueueExpanded = false;
                    panel.style.position = '';
                    panel.style.left = '';
                    panel.style.right = '';
                    panel.style.top = '';
                    panel.style.bottom = '';
                    panel.style.width = '';
                    panel.style.maxWidth = '';
                    list.innerHTML = '';
                    return;
                }
                indicator.classList.remove('hidden');
                panel.classList.toggle('hidden', !jobQueueExpanded);
                const waiting = tasks.filter(task => task.status === 'queued').length;
                const runningCount = tasks.filter(task => task.status === 'running').length;
                indicatorCount.innerText = String(tasks.length);
                indicator.title = `${runningCount} running · ${waiting} waiting. Click to view the work queue.`;
                indicator.setAttribute('aria-expanded', String(jobQueueExpanded));
                if (indicatorDot) {
                    indicatorDot.classList.toggle('bg-[#00BBFC]', runningCount > 0);
                    indicatorDot.classList.toggle('bg-[#A05AFA]', runningCount === 0);
                }
                if (indicatorChevron) indicatorChevron.classList.toggle('rotate-180', jobQueueExpanded);
                summary.innerText = waiting
                    ? `${runningCount ? `${runningCount} running · ` : ''}${waiting} waiting · tasks run one at a time`
                    : 'A task is running';
                const currentTask = tasks.find(task => task.status === 'running');
                const focusedTaskIsDifferent = !!(activeProgressQueueId && currentTask && activeProgressQueueId !== currentTask.id);

                if (currentTask && currentTask.kind === 'scan' && currentViewerIsAdmin && !currentTask.scheduled && !masterScanStatusPollInterval && activeProgressJobType !== 'import' && !focusedTaskIsDifferent) {
                    activeProgressQueueId = currentTask.id;
                    pollScanStatus(true, currentTask.id);
                } else if (currentTask && currentTask.kind === 'sync' && currentTask.ownedByViewer && activeProgressJobType !== 'import' && !focusedTaskIsDifferent) {
                    fetch('/api/import/status', { cache: 'no-store' }).then(r => r.json()).then(job => {
                        if (!['queued', 'fetching', 'processing'].includes(job.status) || activeProgressJobType === 'import') return;
                        currentSyncContext = job.context === 'auto' ? 'auto' : 'manual';
                        activeJobData = job;
                        activeProgressQueueId = job.queueId || currentTask.id;
                        pollJobStatus(false, true);
                    }).catch(() => {});
                }
                list.innerHTML = tasks.map(task => {
                    const running = task.status === 'running';
                    const positionText = running ? 'Running now' : `Position ${Number(task.position) || '—'}`;
                    const statusText = running ? 'In progress' : (task.scheduled ? 'Scheduled · waiting' : 'Waiting');
                    const progressText = running && Number(task.total) > 0 ? ` · ${Number(task.progress) || 0} / ${Number(task.total)}` : '';
                    const removeButton = task.canCancel && task.status === 'queued'
                        ? `<button type="button" onclick="cancelQueuedTask('${escapeHtml(task.id)}')" class="shrink-0 px-3 py-1.5 text-xs font-semibold rounded-md border border-[#66112c] text-[#ff80a8] hover:bg-[#66112c]/40">Remove</button>`
                        : '';
                    const message = task.message && (running || task.status === 'queued')
                        ? `<div class="text-[11px] text-[#7a7d90] mt-1 break-words">${escapeHtml(task.message)}</div>`
                        : '';
                    return `<div class="flex items-start justify-between gap-3 bg-[#000000]/60 border border-[#216281]/70 rounded-lg p-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="text-xs font-bold ${running ? 'text-[#00BBFC]' : 'text-[#d5d7e0]'}">${escapeHtml(positionText)}</span>
                                <span class="text-xs text-[#f1f2f6]">${escapeHtml(task.label || 'MILO task')}</span>
                                <span class="text-[10px] uppercase tracking-wide text-[#7a7d90]">${escapeHtml(statusText)}${escapeHtml(progressText)}</span>
                            </div>
                            ${message}
                        </div>
                        ${removeButton}
                    </div>`;
                }).join('');
                if (jobQueueExpanded) positionJobQueuePanel();
            } catch (_) {

            } finally {
                queueRefreshInFlight = false;
            }
        }

        async function cancelQueuedTask(taskId) {
            try {
                const response = await fetch(`/api/job-queue/${encodeURIComponent(taskId)}/cancel`, { method: 'POST' });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || 'Could not remove the queued task.');
                await refreshJobQueue();
                if (activeProgressQueueId !== taskId) {
                    showAlert('Removed from Queue', data.message || 'The task was removed before it started.', true);
                }
            } catch (error) {
                showAlert('Queue Update Failed', error.message || 'Could not remove the queued task.', false);
            }
        }

        function autoSync() {
            currentSyncContext = 'auto';
            fetch('/api/import/start-job', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ source_type: 'auto' })
            })
            .then(async response => {
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || 'Could not start sync.');
                activeProgressQueueId = data.queue_id || null;
                refreshJobQueue();
                pollJobStatus(false);
            })
            .catch(error => showAlert('Sync Could Not Start', error.message, false));
        }

