        function openSyncSettings() {
            const generation = showManagedModal('sync-settings-modal');
            textPlaylistLoaded = false;
            document.getElementById('ss-text-playlist-save-btn').disabled = true;
            document.getElementById('ss-text-playlist-status').innerText = 'Loading personal Text Playlist...';
            fetch('/api/user/text-playlist')
                .then(async response => {
                    const data = await response.json();
                    if (!response.ok || !data.success) throw new Error(data.message || 'Could not load the Text Playlist.');
                    if (!isManagedModalCurrent('sync-settings-modal', generation)) return;
                    document.getElementById('ss-text-playlist').value = data.text || '';
                    textPlaylistLoaded = true;
                    document.getElementById('ss-text-playlist-save-btn').disabled = false;
                    document.getElementById('ss-text-playlist-status').innerText = `Loaded ${Array.isArray(data.items) ? data.items.length : 0} saved entry/entries. Save text-list changes with the button above.`;
                    hasTextPlaylistApiKey = !!data.has_api_key;
                    document.getElementById('ss-text-playlist-api-key-status').innerText = hasTextPlaylistApiKey
                        ? 'An API key is active. Generating a replacement will invalidate the current key.'
                        : 'No API key has been generated yet.';
                })
                .catch(error => {
                    if (isManagedModalCurrent('sync-settings-modal', generation)) {
                        document.getElementById('ss-text-playlist-api-key-status').innerText = error.message;
                        document.getElementById('ss-text-playlist-status').innerText = 'Could not load the personal Text Playlist. It has not been changed.';
                    }
                });
