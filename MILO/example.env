# MILO configuration
#
# Copy this file to .env and update the values for your installation.
# Do not commit real credentials, secrets, or private paths.

# Server Secret Key (used for session signing)
FLASK_SECRET_KEY=change-this-to-a-random-secret

# Path to your SQLite database file
DB_PATH=data/milo.db

# Master pool directory path (using double backslashes for Windows)
MASTER_POOL_DIR=

# Optional Spotify API Credentials (leave blank if not using Spotify sync)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Optional Apple Music Developer Token (leave blank if not using Apple Music sync)
APPLE_DEVELOPER_TOKEN=

# Optional DrivePool drive paths, separated by commas example D:,G:,S:
DRIVEPOOL_DRIVES=

# Optional admin library path
# Leave blank to use MILO's default admin library behavior.
ADMIN_LIBRARY_PATH=
