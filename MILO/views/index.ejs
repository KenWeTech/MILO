        async function previewImport() {
            const source_type = document.getElementById('import-source').value;
            const input_data = source_type === 'text_playlist' ? '' : document.getElementById('import-text-data').value;
            if (source_type !== 'text_playlist' && !String(input_data || '').trim()) {
                showAlert('Import Data Required', source_type === 'text' ? 'Paste at least one track entry, one per line.' : 'Enter a playlist URL or ID.', false);
                return;
            }

            const button = document.getElementById('import-generate-btn');
            button.disabled = true;
            button.innerText = 'Starting...';
            try {
                const response = await fetch('/api/import/start-job', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        source_type,
                        input_data,
                        save_to_text_playlist: source_type === 'text' && document.getElementById('import-save-to-playlist').checked
                    })
                });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not start import.');
                currentSyncContext = 'manual';
                activeProgressQueueId = result.queue_id || null;
                importPreviewMode = true;
                document.getElementById('import-progress-status').innerText = result.message || 'Added to the work queue. Your library will not change until you click Sync Now.';
                refreshJobQueue();
                document.getElementById('import-progress-status').classList.remove('hidden');
                document.getElementById('setup-actions').classList.add('hidden');
