<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MILO - Music Index & Library Organizer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #216281; }
        ::-webkit-scrollbar-thumb { background: #00BBFC; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #A05AFA; }
    </style>
</head>

<body class="bg-[#000000] text-[#f1f2f6] min-h-screen flex flex-col font-sans antialiased">

<% if (mode === 'login') { %>

    <div class="flex-1 flex items-center justify-center p-4">
        <div class="bg-[#000012] p-8 rounded-2xl shadow-2xl w-full max-w-md border border-[#216281]">
            <div class="text-center mb-4 flex flex-col items-center">
                <div>
                    <img src="/asset/logo.png" alt="MILO" class="w-30 h-30 object-contain -my-24">
                </div>
            </div>

            <h2 class="text-xl font-semibold mb-6 text-[#f1f2f6] text-center" id="random-phrase"></h2>

            <% if (messages && messages.length > 0) { %>
                <div class="bg-[#330816]/50 border border-[#66112c] text-[#ff80a8] p-3 rounded-lg mb-6 text-sm text-center">
                    <%= messages[0] %>
                </div>
            <% } %>

            <form method="POST" class="space-y-5">
                <div>
                    <input type="text" name="username" placeholder="Username" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] focus:ring-1 focus:ring-[#2B66FD] rounded-lg p-3.5 text-[#ffffff] transition-colors outline-none" required>
                </div>
                <div>
                    <input type="password" name="password" placeholder="Password" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] focus:ring-1 focus:ring-[#2B66FD] rounded-lg p-3.5 text-[#ffffff] transition-colors outline-none" required>
                </div>
                <button type="submit" class="w-full bg-[#2C53CA] hover:bg-[#2B66FD] text-[#ffffff] py-3.5 rounded-lg font-semibold shadow-lg shadow-[#004475]/20 transition-all active:scale-[0.98]">
                    Sign In
                </button>
            </form>
        </div>
    </div>

    <script src="/js/login-phrase.js" defer></script>

<% } else { %>

    <header class="bg-[#000012] border-b border-[#216281] sticky top-0 z-40">
        <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row justify-between items-center gap-4 relative">
            <div class="flex items-center">
                <a href="/" class="flex items-center group">
                    <img src="/asset/logo.png" alt="MILO" class="w-[220px] h-[220px] object-fill block -my-20">
                </a>
            </div>
            <div class="flex flex-wrap justify-center sm:justify-end items-center gap-2 sm:gap-4 sm:static absolute top-4 right-4">
                <a href="/logout" class="text-xs sm:text-sm font-medium text-[#b4b7c5] hover:text-[#ffffff] bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] px-3 py-2 rounded-lg transition-colors">

                    <svg class="w-4 h-4 sm:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1"/>
                    </svg>

                    <span class="hidden sm:inline">Logout</span>
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6 space-y-6">
        <% if (current_user.role === 'admin') { %>

        <div class="bg-[#3F3182]/20 border border-[#5B47CA]/50 rounded-xl p-4 sm:p-5 flex flex-col md:flex-row gap-4 justify-between items-start md:items-center">
            <button onclick="toggleAdminConsoleMobile()" class="sm:hidden w-full flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full bg-[#6E57FD] shadow-[0_0_8px_rgba(0,146,252,0.8)]"></div>
                    <span class="text-[#6E57FD] font-semibold text-sm tracking-wide uppercase">Admin Console</span>
                </div>
                <svg id="admin-console-chevron" class="w-4 h-4 text-[#6E57FD] transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>

            <div class="hidden sm:flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-[#6E57FD] shadow-[0_0_8px_rgba(0,146,252,0.8)]"></div>
                <span class="text-[#6E57FD] font-semibold text-sm tracking-wide uppercase">Admin Console</span>
            </div>

            <div id="admin-console-container" class="hidden sm:flex flex-col sm:flex-row gap-3 w-full md:w-auto">

                <div id="master-scan-progress" class="hidden flex-1 sm:w-64 bg-[#000012] border border-[#216281] rounded-lg px-3 py-1.5 flex flex-col justify-center">
                    <div class="flex justify-between text-[10px] text-[#00BBFC] font-semibold mb-1">
                        <span id="master-scan-status-text">Scanning...</span>
                        <span id="master-scan-count-text">0 / 0</span>
                    </div>
                    <div class="w-full bg-[#000000] rounded-full h-1.5 overflow-hidden">
                        <div id="master-scan-bar" class="bg-[#00BBFC] h-full" style="width: 0%"></div>
                    </div>
                </div>

                <button onclick="openUserManager()" class="w-full sm:w-auto bg-[#2C53CA] hover:bg-[#2B66FD] px-4 py-2.5 rounded-lg text-sm font-medium text-[#ffffff] transition-colors">
                    Manage Users
                </button>
                <button id="btn-master-scan" onclick="startMasterScan()" class="w-full sm:w-auto bg-[#5B47CA] hover:bg-[#6E57FD] px-4 py-2.5 rounded-lg text-sm font-medium text-[#ffffff] transition-colors">
                    Rescan Master Pool
                </button>
                <button onclick="openSystemSettings()" class="w-full sm:w-auto bg-[#713CCC] hover:bg-[#8A48FF] border border-[#8A48FF] px-4 py-2.5 rounded-lg text-sm font-medium text-[#ffffff] transition-colors">
                    Scan Schedule
                </button>
                <button onclick="openDeadFilesModal()" class="w-full sm:w-auto bg-[#814AC8] hover:bg-[#A05AFA] px-4 py-2.5 rounded-lg text-sm font-medium text-[#ffffff] transition-colors">
                    Dead Files
                </button>
            </div>
        </div>
        <% } %>

        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-[#000012]/80 border border-[#216281] p-4 rounded-xl shadow-sm">
            <div>
                <h2 class="text-lg font-bold text-[#ffffff]">Library: <span class="text-[#00BBFC]"><%= current_user.username %></span></h2>
            </div>
            <div class="flex items-center gap-4 w-full sm:w-auto justify-between sm:justify-end">
                <div class="bg-[#000000] border border-[#216281] px-4 py-2 rounded-lg text-center flex-1 sm:flex-none">
                    <span class="text-[#b4b7c5] block text-[10px] sm:text-xs font-semibold uppercase tracking-wider">Total Available</span>
                    <span id="stat-total" class="font-bold text-[#ffffff] text-base sm:text-lg">0</span>
                </div>
                <div class="bg-[#000000] border border-[#216281] px-4 py-2 rounded-lg text-center flex-1 sm:flex-none">
                    <span class="text-[#b4b7c5] block text-[10px] sm:text-xs font-semibold uppercase tracking-wider">Selected Tracks</span>
                    <span id="stat-library" class="font-bold text-[#00BBFC] text-base sm:text-lg">0</span>
                </div>
            </div>
        </div>

        <div class="border-b border-[#216281] pb-6">
            <button onclick="toggleSyncActionsMobile()" class="sm:hidden w-full flex justify-between items-center bg-[#000012] border border-[#216281] px-4 py-2.5 rounded-lg text-sm font-semibold text-[#00BBFC] transition-colors">
                <span>Sync & Import Controls</span>
                <svg id="sync-actions-chevron" class="w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div id="sync-actions-container" class="hidden flex flex-col sm:flex sm:flex-row gap-3 pt-3 sm:pt-0">
                <button onclick="autoSync()" class="flex-1 sm:flex-none bg-[#1A76C9] hover:bg-[#0092FC] border border-[#0092FC] text-[#E9DFFF] px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors">
                    Run Sync Job
                </button>
                <button onclick="openImportModal('manual')" class="flex-1 sm:flex-none bg-[#232F6B]/40 hover:bg-[#2B66FD]/50 border border-[#2B66FD]/50 px-5 py-2.5 rounded-lg text-sm font-semibold text-[#2B66FD] transition-colors">
                    Manual Import
                </button>
                <button onclick="openSyncSettings()" class="text-xs sm:text-sm font-medium text-[#5B47CA] hover:text-[#6E57FD] bg-[#241C40]/30 hover:bg-[#362A6B]/50 border border-[#362A6B]/50 px-3 py-2 rounded-lg transition-colors">
                    Sync Settings
                </button>
                <button onclick="openRemovedLogsModal()" class="text-xs sm:text-sm font-medium text-[#713CCC] hover:text-[#8A48FF] bg-[#291A41]/30 hover:bg-[#4C2B83]/50 border border-[#4C2B83]/50 px-3 py-2 rounded-lg transition-colors">
                    Restore Tracks
                </button>
                <button onclick="openMissingLogsModal()" class="text-xs sm:text-sm font-medium text-[#814AC8] hover:text-[#A05AFA] bg-[#2D1D40]/30 hover:bg-[#643B97]/50 border border-[#643B97]/50 px-3 py-2 rounded-lg transition-colors">
                    Unmatched Logs
                </button>
            </div>
        </div>

        <div id="job-progress-container" class="hidden w-full bg-[#000012] p-5 rounded-xl border border-[#216281] mb-6 shadow-xl">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center text-sm mb-4 gap-2">
                <span id="job-status-text" class="font-semibold text-[#00BBFC]">Initializing Sync...</span>
                <span id="job-progress-text" class="text-[#b4b7c5] font-mono bg-[#000000] px-2 py-1 rounded">0 / 0</span>
            </div>
            <div class="w-full bg-[#000000] rounded-full h-2.5 overflow-hidden border border-[#216281]">
                <div id="job-progress-bar" class="bg-[#2B66FD] h-full transition-all duration-300 ease-out shadow-[0_0_10px_rgba(0,146,252,0.5)]" style="width: 0%"></div>
            </div>
            <div id="job-action-container" class="hidden mt-5 flex flex-col sm:flex-row justify-end gap-3">
                <button onclick="clearJob()" class="w-full sm:w-auto px-5 py-2.5 bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] rounded-lg text-sm font-medium transition-colors">Dismiss</button>
                <button id="job-review-btn" onclick="reviewJobResults()" class="w-full sm:w-auto px-5 py-2.5 bg-[#2C53CA] hover:bg-[#2B66FD] rounded-lg text-sm font-semibold text-[#ffffff] shadow-lg shadow-[#005540]/20 transition-all active:scale-95">Review Results</button>
            </div>
        </div>

        <div class="bg-[#000012] border border-[#216281] rounded-xl p-4">

            <input type="text" id="search-input" onkeyup="handleSearchInput()" placeholder="Search artist, album, or title..." class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] focus:ring-1 focus:ring-[#2B66FD] rounded-lg p-2.5 text-sm text-[#ffffff] placeholder-[#7a7d90] outline-none transition-colors">

            <button onclick="toggleFiltersMobile()" class="sm:hidden w-full flex justify-between items-center mt-4 bg-[#000012] border-b border-[#216281] px-4 py-2.5 rounded-lg text-sm font-semibold text-[#00BBFC] transition-colors">
                <span>Filters & Sorting</span>
                <svg id="filters-chevron" class="w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>

            <div id="filters-container" class="hidden sm:grid grid-cols-2 lg:grid-cols-4 gap-4 mt-4 sm:mt-4">
                <select id="library-filter" onchange="resetPageAndLoad()" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] focus:ring-1 focus:ring-[#2B66FD] rounded-lg p-2.5 text-sm text-[#f1f2f6] outline-none appearance-none">
                    <option value="all">Filter: All Tracks</option>
                    <option value="added">Filter: Added to Library</option>
                    <option value="unadded">Filter: Not Added</option>
                </select>
                <select id="sort-by" onchange="handleSortByChange()" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] focus:ring-1 focus:ring-[#2B66FD] rounded-lg p-2.5 text-sm text-[#f1f2f6] outline-none appearance-none">
                    <option value="artist">Sort by Artist</option>
                    <option value="title">Sort by Title</option>
                    <option value="album">Sort by Album</option>
                    <option value="added">Sort by Recently Added</option>
                </select>
                <select id="sort-order" onchange="resetPageAndLoad()" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] focus:ring-1 focus:ring-[#2B66FD] rounded-lg p-2.5 text-sm text-[#f1f2f6] outline-none appearance-none">
                    <option value="asc">Ascending Order</option>
                    <option value="desc">Descending Order</option>
                </select>
                <select id="page-limit" onchange="resetPageAndLoad()" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] focus:ring-1 focus:ring-[#2B66FD] rounded-lg p-2.5 text-sm text-[#f1f2f6] outline-none appearance-none">
                    <option value="25">25 per page</option>
                    <option value="50" selected>50 per page</option>
                    <option value="100">100 per page</option>
                    <option value="250">250 per page</option>
                    <option value="500">500 per page</option>
                    <option value="all">Show All</option>
                </select>
            </div>
        </div>

        <div class="bg-[#000012] border border-[#216281] rounded-xl overflow-hidden shadow-sm">
            <div class="w-full overflow-x-auto">
                <table class="w-full text-left text-sm text-[#d5d7e0]">
                    <thead class="bg-[#000000] border-b border-[#216281] text-[#b4b7c5] text-xs uppercase tracking-wider font-semibold">
                        <tr>
                            <th class="p-4 w-auto sm:w-1/3">Track</th>
                            <th class="p-4 w-1/4 hidden sm:table-cell">Artist</th>
                            <th class="p-4 w-1/4 hidden sm:table-cell">Album</th>
                            <th class="p-4 w-24 text-right pr-4 sm:pr-6">Action</th>
                        </tr>
                    </thead>
                    <tbody id="catalog-table" class="divide-y divide-[#1d202f]/50"></tbody>
                </table>
            </div>
        </div>

        <div id="pagination-controls" class="flex flex-col sm:flex-row justify-between items-center gap-4 bg-[#000012] border border-[#216281] rounded-xl p-4">
            <div id="pagination-info" class="text-xs sm:text-sm text-[#b4b7c5]">
                Showing <span id="page-start-count" class="font-semibold text-[#ffffff]">0</span> - <span id="page-end-count" class="font-semibold text-[#ffffff]">0</span> of <span id="page-total-count" class="font-semibold text-[#00BBFC]">0</span> tracks
            </div>
            <div class="flex items-center gap-2">
                <button id="btn-first-page" onclick="goToPage(1)" class="px-3 py-1.5 text-xs bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] text-[#d5d7e0] rounded-lg transition-colors disabled:opacity-40 disabled:cursor-not-allowed">First</button>
                <button id="btn-prev-page" onclick="changePage(-1)" class="px-3 py-1.5 text-xs bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] text-[#d5d7e0] rounded-lg transition-colors disabled:opacity-40 disabled:cursor-not-allowed">Prev</button>
                <span id="page-indicator" class="text-xs font-semibold px-2 text-[#ffffff]">Page 1 of 1</span>
                <button id="btn-next-page" onclick="changePage(1)" class="px-3 py-1.5 text-xs bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] text-[#d5d7e0] rounded-lg transition-colors disabled:opacity-40 disabled:cursor-not-allowed">Next</button>
                <button id="btn-last-page" onclick="goToPage(totalPages)" class="px-3 py-1.5 text-xs bg-[#1d202f] hover:bg-[#2a2e43] border border-[#2a2e43] text-[#d5d7e0] rounded-lg transition-colors disabled:opacity-40 disabled:cursor-not-allowed">Last</button>
            </div>
        </div>
    </main>

    <div id="sync-modal" class="fixed z-50 inset-0 bg-[#000000]/80 backdrop-blur-sm items-center justify-center hidden p-4 sm:p-6 flex">
        <div class="bg-[#000012] border border-[#2a2e43] rounded-2xl w-full max-w-lg shadow-2xl flex flex-col max-h-[90vh]">
            <div class="p-6 border-b border-[#216281]">
                <h3 class="text-lg font-bold text-[#6E57FD]">Sync & API Configuration</h3>
            </div>
            <div class="p-6 space-y-4 overflow-y-auto">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-[#b4b7c5] mb-1">Provider</label>
                        <select id="sync-provider" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-sm text-[#f1f2f6] outline-none">
                            <option value="spotify" <%= current_user.sync_provider === 'spotify' ? 'selected' : '' %>>Spotify</option>
                            <option value="youtube" <%= current_user.sync_provider === 'youtube' ? 'selected' : '' %>>YouTube Music</option>
                            <option value="apple" <%= current_user.sync_provider === 'apple' ? 'selected' : '' %>>Apple Music</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-[#b4b7c5] mb-1">Sync Interval (Minutes)</label>
                        <input type="number" id="sync-interval" value="<%= current_user.sync_interval || 0 %>" placeholder="0 = Manual" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-sm text-[#f1f2f6] outline-none">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-[#b4b7c5] mb-1">Playlist ID or URL</label>
                    <input type="text" id="sync-url" value="<%= current_user.sync_url || '' %>" placeholder="Enter URL..." class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-sm text-[#f1f2f6] outline-none">
                </div>

                <div class="flex items-center gap-4 bg-[#000000] border border-[#2a2e43] p-3 rounded-lg">
                    <label class="flex items-center gap-2 text-sm text-[#f1f2f6] cursor-pointer">
                        <input type="checkbox" id="sync-auto" <%= current_user.auto_sync ? 'checked' : '' %> class="w-4 h-4 text-[#2B66FD] bg-[#000000] border-[#2a2e43] rounded">
                        <span>Auto-Sync Playlist</span>
                    </label>
                    <label class="flex items-center gap-2 text-sm text-[#ffabc5] cursor-pointer" title="Removes items not in the synced playlist">
                        <input type="checkbox" id="sync-one-for-one" <%= current_user.one_for_one ? 'checked' : '' %> class="w-4 h-4 text-[#ff80a8] bg-[#000000] border-[#2a2e43] rounded">
                        <span>One-for-One Sync</span>
                    </label>
                </div>

                <hr class="border-[#216281]">
                <div class="space-y-3">
                    <h4 class="text-xs font-bold text-[#b4b7c5] uppercase tracking-wider">Custom API Tokens</h4>
                    <div>
                        <input type="text" id="api-spotify-id" value="<%= current_user.spotify_client_id || '' %>" placeholder="Spotify Client ID (Optional)" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2 text-sm text-[#f1f2f6] outline-none">
                    </div>
                    <div>
                        <input type="text" id="api-spotify-secret" value="<%= current_user.spotify_client_secret || '' %>" placeholder="Spotify Client Secret (Optional)" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2 text-sm text-[#f1f2f6] outline-none">
                    </div>
                    <div>
                        <input type="text" id="api-apple-token" value="<%= current_user.apple_dev_token || '' %>" placeholder="Apple Developer Token (Optional)" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2 text-sm text-[#f1f2f6] outline-none">
                    </div>
                </div>
            </div>
            <div class="p-4 border-t border-[#216281] bg-[#000012]/50 flex flex-col-reverse sm:flex-row justify-end gap-3 rounded-b-2xl">
                <button onclick="closeModal('sync-modal')" class="w-full sm:w-auto px-5 py-2.5 bg-[#1d202f] hover:bg-[#2a2e43] text-[#f1f2f6] rounded-lg text-sm font-medium transition-colors">Cancel</button>
                <button onclick="saveSyncSettings()" class="w-full sm:w-auto px-5 py-2.5 bg-[#2C53CA] hover:bg-[#2B66FD] text-[#ffffff] rounded-lg text-sm font-medium transition-colors">Save Settings</button>
            </div>
        </div>
    </div>

    <div id="import-modal" class="fixed z-50 inset-0 bg-[#000000]/80 backdrop-blur-sm items-center justify-center hidden p-4 sm:p-6 flex">
        <div class="bg-[#000012] border border-[#2a2e43] rounded-2xl w-full max-w-2xl shadow-2xl flex flex-col max-h-[90vh]">
            <div class="p-6 border-b border-[#216281]">
                <h3 class="text-lg font-bold text-[#2B66FD]" id="import-modal-title">Import Data</h3>
            </div>
            <div class="p-6 overflow-y-auto flex-1">
                <div id="import-setup" class="space-y-4">
                    <div>
                        <label class="block text-xs font-medium text-[#b4b7c5] mb-1">Source Format</label>
                        <select id="import-source" class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-2.5 text-sm text-[#f1f2f6] outline-none">
                            <option value="text">Plain Text List (One per line)</option>
                            <option value="spotify">Spotify Playlist</option>
                            <option value="youtube">YouTube Playlist</option>
                            <option value="apple">Apple Music Playlist</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-[#b4b7c5] mb-1">Data Input</label>
                        <textarea id="import-input" rows="8" placeholder="Paste data or URL here..." class="w-full bg-[#000000] border border-[#2a2e43] focus:border-[#2B66FD] rounded-lg p-3 text-sm text-[#f1f2f6] font-mono outline-none resize-none"></textarea>
                    </div>
                </div>
                <div id="import-diff" class="hidden space-y-6">
                    <div class="space-y-2">
                        <h4 class="text-sm font-semibold text-[#0092FC] flex justify-between items-center border-b border-[#216281] pb-1">
