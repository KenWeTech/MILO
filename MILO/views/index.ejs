        function submitManualImport() { return previewImport(); }

        function pollJobStatus(reviewWhenDone = false, suppressCompletionAlert = false) {
            if (importStatusPollInterval) clearInterval(importStatusPollInterval);
            importStatusPollInterval = null;
            if (masterScanStatusPollInterval) clearInterval(masterScanStatusPollInterval);
            masterScanStatusPollInterval = null;
            if (organizerStatusPollInterval) clearInterval(organizerStatusPollInterval);
            organizerStatusPollInterval = null;
            if (deadFileStatusPollInterval) clearInterval(deadFileStatusPollInterval);
            deadFileStatusPollInterval = null;
            if (missingLogStatusPollInterval) clearInterval(missingLogStatusPollInterval);
            missingLogStatusPollInterval = null;
            if (restoreStatusPollInterval) clearInterval(restoreStatusPollInterval);
            restoreStatusPollInterval = null;
            if (libraryPathStatusPollInterval) clearInterval(libraryPathStatusPollInterval);
            libraryPathStatusPollInterval = null;
            activeProgressJobType = 'import';
            const container = document.getElementById('job-progress-container');
            container.classList.remove('hidden');
            document.getElementById('job-action-container').classList.add('hidden');
            document.getElementById('job-progress-bar').style.width = '0%';
            let pollInFlight = false;

            const poll = async () => {
                if (pollInFlight) return;
                pollInFlight = true;
                try {
                    const response = await fetch('/api/import/status');
                    const job = await response.json();
                    activeJobData = job;
                    document.getElementById('job-status-text').innerText = job.error
                        ? `Status: ${job.status} — ${job.error}`
                        : (job.message || `Status: ${job.status}`);
                    const reviewButton = document.getElementById('job-review-btn');
                    reviewButton.innerText = 'Review Results';
                    reviewButton.onclick = reviewJobResults;
                    reviewButton.classList.toggle('hidden', !job.result);
                    document.getElementById('job-progress-text').innerText = `${job.progress || 0} / ${job.total || 0}`;
                    const pct = job.total > 0 ? Math.min(100, ((job.progress || 0) / job.total) * 100) : 0;
                    document.getElementById('job-progress-bar').style.width = `${pct}%`;

                    if (importPreviewMode) {
                        document.getElementById('import-progress-status').innerText = job.error
                            ? `Import failed: ${job.error}`
                            : `Processing... ${job.progress || 0} / ${job.total || 0}`;
                    }

                    if (['completed', 'auto_completed', 'error', 'cancelled'].includes(job.status)) {
                        clearInterval(importStatusPollInterval);
                        importStatusPollInterval = null;
                        document.getElementById('job-action-container').classList.remove('hidden');
                        if (job.status === 'auto_completed') loadCatalog();
                        if (job.status === 'cancelled') {
                            if (reviewWhenDone && importPreviewMode) {
                                importPreviewMode = false;
                                document.getElementById('setup-actions').classList.remove('hidden');
                                document.getElementById('setup-actions').classList.add('flex');
                                document.getElementById('import-generate-btn').disabled = false;
                                document.getElementById('import-generate-btn').innerText = 'Start';
                                document.getElementById('import-progress-status').classList.add('hidden');
                            }
                            if (!suppressCompletionAlert) showAlert('Queue Item Removed', job.message || 'The sync/import was removed before it started.', true);
                        } else if (job.status === 'error') {
                            if (reviewWhenDone && importPreviewMode) {
                                importPreviewMode = false;
                                document.getElementById('setup-actions').classList.remove('hidden');
                                document.getElementById('setup-actions').classList.add('flex');
                                document.getElementById('import-generate-btn').disabled = false;
                                document.getElementById('import-generate-btn').innerText = 'Start';
                                if (!suppressCompletionAlert) showAlert('Import Failed', job.error || 'The import could not be completed.', false);
                            } else {
                                if (!suppressCompletionAlert) showAlert('Sync Failed', job.error || 'The sync could not be completed.', false);
                            }
                        } else if (reviewWhenDone && importPreviewMode && job.result) {
                            importPreviewMode = false;
                            handleDiffResponse(job.result, 'Import Results', job.applied === true || job.status === 'auto_completed');
                            showManagedModal('import-modal');
                        }
                        activeProgressJobType = null;
                        activeProgressQueueId = null;
                        refreshJobQueue();
                    }
                } catch (error) {

                    if (reviewWhenDone && importPreviewMode) {
                        document.getElementById('import-progress-status').innerText = 'Connection interrupted while checking progress. Retrying...';
                    }
                } finally {
                    pollInFlight = false;
                }
            };

            poll();
            importStatusPollInterval = setInterval(poll, 1000);
        }

        function handleDiffResponse(result, title = 'Import Results', appliedOverride = null) {
            const matches = Array.isArray(result && result.matches) ? result.matches : [];
            const exists = Array.isArray(result && result.exists) ? result.exists : [];
            const missing = Array.isArray(result && result.missing) ? result.missing : [];
            pendingTracks = matches.map(item => Number(item.track_id)).filter(id => Number.isInteger(id) && id > 0);
            existingTracks = exists.map(item => Number(item.track_id)).filter(id => Number.isInteger(id) && id > 0);

            document.getElementById('import-modal-title').innerText = title;
            const warnings = Array.isArray(result && result.warnings) ? result.warnings : [];
            const warningBox = document.getElementById('diff-warning');
            warningBox.innerHTML = warnings.map(warning => escapeHtml(warning)).join('<br>');
            warningBox.classList.toggle('hidden', warnings.length === 0);
            document.getElementById('diff-add-count').innerText = String(matches.length);
            document.getElementById('diff-exist-count').innerText = String(exists.length);
            document.getElementById('diff-miss-count').innerText = String(missing.length);

            document.getElementById('diff-add').innerHTML = matches.length ? matches.map(item => `
                <li class="flex justify-between items-center gap-2 text-[#00BBFC]">
                    <label class="flex items-center min-w-0 gap-2">
                        <input type="checkbox" name="diff-track" value="${Number(item.track_id)}" checked class="accent-[#2B66FD] flex-shrink-0">
                        <span class="truncate">${escapeHtml(item.display || '')}</span>
                    </label>
                    <span class="text-[#6E57FD]/80 flex-shrink-0">${escapeHtml(item.confidence == null ? '' : String(item.confidence))}</span>
                </li>`).join('') : '<li class="text-[#7a7d90]">No new tracks to add.</li>';

            document.getElementById('diff-exist').innerHTML = exists.length ? exists.map(item => `
                <li class="text-[#b4b7c5] truncate">${escapeHtml(item.display || '')}</li>`).join('') : '<li class="text-[#7a7d90]">No tracks are already in this library.</li>';

            document.getElementById('diff-miss').innerHTML = missing.length ? missing.map(item => `
                <li class="text-[#A05AFA] break-words">${escapeHtml(item.query || '')}</li>`).join('') : '<li class="text-[#7a7d90]">All entries matched the master pool.</li>';

            const autoApplied = typeof appliedOverride === 'boolean' ? appliedOverride : !!(activeJobData && (
                activeJobData.applied === true || activeJobData.autoApplied === true || activeJobData.status === 'auto_completed' ||
                (activeJobData.result && (activeJobData.result.added_count !== undefined || activeJobData.result.removed_count !== undefined))
            ));
            document.getElementById('import-back-btn').classList.toggle('hidden', autoApplied);
            document.getElementById('import-close-btn').classList.toggle('hidden', !autoApplied);
            document.getElementById('diff-sync-btn').classList.toggle('hidden', autoApplied);
            document.getElementById('import-setup').classList.add('hidden');
            document.getElementById('setup-actions').classList.remove('flex');
            document.getElementById('setup-actions').classList.add('hidden');
            document.getElementById('import-diff').classList.remove('hidden');
            document.getElementById('diff-actions').classList.remove('hidden');
            document.getElementById('diff-actions').classList.add('flex');
        }

        function reviewJobResults() {
            if (!activeJobData || !activeJobData.result) {
                showAlert('No Results', 'There are no completed import results to review yet.', false);
                return;
            }
            currentSyncContext = activeJobData.context === 'auto' ? 'auto' : 'manual';
            const wasApplied = activeJobData.applied === true || activeJobData.autoApplied === true || activeJobData.status === 'auto_completed';
            const title = currentSyncContext === 'auto' ? 'Auto-Sync Output' : 'Import Results';
            handleDiffResponse(activeJobData.result, title, wasApplied);
            showManagedModal('import-modal');
        }

        async function confirmImport() {
            const selected = Array.from(document.querySelectorAll('input[name="diff-track"]:checked'))
                .map(input => Number(input.value)).filter(id => Number.isInteger(id) && id > 0);
            if (selected.length === 0 && existingTracks.length === 0) {
                showAlert('Nothing to Sync', 'None of these entries matched a track in the master pool. Your library has not been changed; unmatched entries remain available in the Unmatched Logs.', false);
                return;
            }
            const button = document.getElementById('diff-sync-btn');
            button.disabled = true;
            try {
                const response = await fetch('/api/import/confirm', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ track_ids: selected, existing_ids: existingTracks })
                });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Could not apply the import.');
                closeImportModal();
                clearJob();
                showAlert('Import Complete', result.message || 'Tracks synced successfully.', true);
                loadCatalog();
            } catch (error) {
                showAlert('Import Failed', error.message || 'Could not apply the import.', false);
            } finally {
                button.disabled = false;
            }
        }

        function clearJob() {
            if (importStatusPollInterval) {
                clearInterval(importStatusPollInterval);
                importStatusPollInterval = null;
            }
            if (activeProgressJobType === 'scan') {
                if (masterScanStatusPollInterval) clearInterval(masterScanStatusPollInterval);
                masterScanStatusPollInterval = null;
                fetch('/api/catalog/scan-dismiss', { method: 'POST' }).catch(() => {});
                document.getElementById('job-progress-container').classList.add('hidden');
                document.getElementById('job-action-container').classList.add('hidden');
                document.getElementById('job-progress-bar').classList.remove('animate-pulse');
                activeProgressJobType = null;
                activeProgressQueueId = null;
                return;
            }
            if (activeProgressJobType === 'organizer' || activeProgressJobType === 'bulk-review') {
                fetch('/api/progress/dismiss', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ type: activeProgressJobType }) }).catch(() => {});
                if (organizerStatusPollInterval) clearInterval(organizerStatusPollInterval);
                organizerStatusPollInterval = null;
                document.getElementById('job-progress-container').classList.add('hidden');
                document.getElementById('job-action-container').classList.add('hidden');
                activeProgressJobType = null;
                return;
            }
            if (activeProgressJobType === 'dead-files-bulk') {
                fetch('/api/progress/dismiss', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ type: activeProgressJobType }) }).catch(() => {});
                if (deadFileStatusPollInterval) clearInterval(deadFileStatusPollInterval);
                deadFileStatusPollInterval = null;
                document.getElementById('job-progress-container').classList.add('hidden');
                document.getElementById('job-action-container').classList.add('hidden');
                activeProgressJobType = null;
                return;
            }
            if (activeProgressJobType === 'missing-logs-bulk') {
                fetch('/api/progress/dismiss', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ type: activeProgressJobType }) }).catch(() => {});
                if (missingLogStatusPollInterval) clearInterval(missingLogStatusPollInterval);
                missingLogStatusPollInterval = null;
                document.getElementById('job-progress-container').classList.add('hidden');
                document.getElementById('job-action-container').classList.add('hidden');
                activeProgressJobType = null;
                return;
            }
            if (activeProgressJobType === 'restore-tracks-bulk') {
                fetch('/api/progress/dismiss', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ type: activeProgressJobType }) }).catch(() => {});
                if (restoreStatusPollInterval) clearInterval(restoreStatusPollInterval);
                restoreStatusPollInterval = null;
                document.getElementById('job-progress-container').classList.add('hidden');
                document.getElementById('job-action-container').classList.add('hidden');
                activeProgressJobType = null;
                return;
            }
            if (activeProgressJobType === 'library-path') {
                fetch('/api/progress/dismiss', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ type: activeProgressJobType }) }).catch(() => {});
                if (libraryPathStatusPollInterval) clearInterval(libraryPathStatusPollInterval);
                libraryPathStatusPollInterval = null;
                document.getElementById('job-progress-container').classList.add('hidden');
                document.getElementById('job-action-container').classList.add('hidden');
                activeProgressJobType = null;
                return;
            }
            fetch('/api/import/clear', { method: 'POST' }).then(() => {
                document.getElementById('job-progress-container').classList.add('hidden');
                document.getElementById('job-action-container').classList.add('hidden');
                activeJobData = null;
                currentSyncContext = 'manual';
                activeProgressJobType = null;
                refreshJobQueue();
            }).catch(() => {
                document.getElementById('job-progress-container').classList.add('hidden');
                document.getElementById('job-action-container').classList.add('hidden');
                activeProgressJobType = null;
            });
        }

        function closeJobResultsModal() { closeManagedModal('job-results-modal'); }

        function confirmJobImport() {
            const checked = Array.from(document.querySelectorAll('input[name="review-match"]:checked')).map(cb => parseInt(cb.value));
            fetch('/api/import/confirm', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ track_ids: checked })
            })
            .then(r => r.json())
            .then(res => {
                closeJobResultsModal();
                clearJob();
                showAlert(res.message);
                loadCatalog();
            });
